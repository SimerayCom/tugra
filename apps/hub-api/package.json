    "@nestjs/swagger": "^8",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^6.0.0",
    "@tugra/shared": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.1",
    "ioredis": "^5.11.1",
