DATABASE_URL="postgresql://tugra:tugra@localhost:5433/tugra?schema=public"
REDIS_URL="redis://localhost:6379"
HUB_PORT=3000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
SECRETS_ENCRYPTION_KEY="change-me-32-bytes-base64"

# Session cookies carry the Secure flag when true (defaults to on in production, off otherwise so
# localhost http works). Set explicitly if NODE_ENV doesn't reflect your TLS setup.
COOKIE_SECURE=""

# "Sign in with GitHub" (optional): GITHUB_OAUTH_CLIENT_ID / GITHUB_OAUTH_CLIENT_SECRET. Register the callback
# <WEB_PUBLIC_URL>/api/auth/oauth/github/callback when web and hub are on different ports/hosts, or
# <HUB_PUBLIC_URL>/auth/oauth/github/callback when they share one origin. GITHUB_OAUTH_CALLBACK_URL overrides it.
# The panel must be opened at exactly WEB_PUBLIC_URL (same scheme, host and port) for GitHub sign-in to work.

# Web origin the SPA is served from — the OAuth callback redirects here and it's pinned as the
# allowed Origin for terminal WebSocket upgrades.
WEB_PUBLIC_URL="http://localhost:3001"

# Optional: base64 of a 32-byte ed25519 seed used to sign agent commands.
# If unset, a key is generated per boot (agents re-pin on reconnect); set it
# for a stable hub identity across restarts.
HUB_SIGNING_KEY=""

ACME_EMAIL="admin@example.com"

# Public base URL agents dial back to (e.g. https://hub.example.com). Used to
# build the agent install command; falls back to the request host when unset.
HUB_PUBLIC_URL=""

# Transactional email (password reset, email verification, team invites). Optional:
# leave MAIL_HOST empty to run without SMTP — those flows still work (fail-soft), the
# tokens/links are recorded in the audit log instead of emailed.
MAIL_HOST=""
MAIL_PORT=587
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Tugra <no-reply@localhost>"
# Set to "true" to block unverified accounts from write actions after login.
REQUIRE_EMAIL_VERIFICATION="false"

# Migration volume stream v2 (Coolify/Dokploy volume data, streamed through the hub's memory relay in parts).
# Set MIGRATION_VX_ENABLED="false" to switch it off (the vx routes 404 and /targets lists no volume rows).
# Raw (tar) MiB per part, 32..512 - the migrator's --part-mib must equal it. Max raw bytes per volume (default 256 GiB,
# ceiling 2 TiB). A migration token slides 1 h at a time while a copy is running, capped at MIGRATION_TOKEN_MAX_LIFE_HOURS
# in total. Migration parts use their OWN relay seat pool (MIGRATION_RELAY_CONCURRENCY), separate from app moves.
# A proxy that caps request bodies (e.g. Cloudflare 100 MB) also caps a part: lower MIGRATION_VX_PART_MIB (min 32).
# Supported topology for streamed copies: ONE hub (every byte crosses the hub NIC twice, through memory only).
MIGRATION_VX_ENABLED="true"
MIGRATION_VX_PART_MIB=128
MIGRATION_VX_MAX_BYTES=274877906944
MIGRATION_VX_MAX_PARTS=100000
MIGRATION_VX_STALE_MS=300000
MIGRATION_TOKEN_MAX_LIFE_HOURS=72
MIGRATION_RELAY_CONCURRENCY=2
