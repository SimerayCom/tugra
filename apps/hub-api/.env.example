DATABASE_URL="postgresql://tugra:tugra@localhost:5433/tugra?schema=public"
REDIS_URL="redis://localhost:6379"
HUB_PORT=3000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
SECRETS_ENCRYPTION_KEY="change-me-32-bytes-base64"

# Optional: base64 of a 32-byte ed25519 seed used to sign agent commands.
# If unset, a key is generated per boot (agents re-pin on reconnect); set it
# for a stable hub identity across restarts.
HUB_SIGNING_KEY=""

ACME_EMAIL="admin@example.com"

# Public base URL agents dial back to (e.g. https://hub.example.com). Used to
# build the agent install command; falls back to the request host when unset.
HUB_PUBLIC_URL=""

# Transactional email (password reset, email verification, team invites). Optional:
# leave MAIL_HOST empty to run without SMTP — those flows still work (fail-soft), the
# tokens/links are recorded in the audit log instead of emailed.
MAIL_HOST=""
MAIL_PORT=587
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Tugra <no-reply@localhost>"
# Set to "true" to block unverified accounts from write actions after login.
REQUIRE_EMAIL_VERIFICATION="false"
