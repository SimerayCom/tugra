// Tugra hub — Prisma schema v0 (Faz 0)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

enum ServerStatus {
  PENDING
  ONLINE
  OFFLINE
}

// Docker Swarm formation state of a Cluster. NONE = plain group. FORMING = a form/dissolve
// op is in flight (concurrency guard via CAS). ACTIVE = manager + every intended worker joined. DEGRADED =
// a real, working swarm short of its desired membership (re-run Form to reconcile). DISSOLVING = teardown.
enum SwarmStatus {
  NONE
  FORMING
  ACTIVE
  DEGRADED
  DISSOLVING
  JOINING
}

// A server's role in its cluster's swarm (null = not in a swarm).
enum SwarmRole {
  MANAGER
  WORKER
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  password           String
  name               String?
  twoFaSecret        String?
  twoFaEnabled       Boolean                 @default(false)
  twoFaEnabledAt     DateTime?
  emailVerified      Boolean                 @default(false)
  emailVerifiedAt    DateTime?
  uiMode             String                  @default("fleet") // "fleet" | "home"
  isInstanceOwner    Boolean                 @default(false) // the first user to register; owns instance-level settings
  memberships        Membership[]
  apiTokens          ApiToken[]
  oauthGrants        OAuthGrant[]
  oauthCodes         OAuthCode[]
  savedViews         SavedView[]
  recoveryCodes      TwoFactorRecoveryCode[]
  verificationTokens VerificationToken[]
  pushSubscriptions  PushSubscription[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

// One browser/device registered for Web Push (RFC 8030/8291). `endpoint` is the push service URL the browser
// handed out (unique per browser profile); `p256dh` is the browser's public ECDH key (not secret); `authEnc` is its
// 16-byte auth secret, stored ENCRYPTED. Owned by a user (not a team): a push channel targets its creator's devices.
model PushSubscription {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  endpoint    String    @unique
  p256dh      String
  authEnc     String
  deviceLabel String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  @@index([userId])
}

// Purpose of an emailed single-use token. EMAIL_VERIFY is reserved for email verification;
// this table is shared so no new migration is needed.
enum VerificationPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// A single-use, expiring token delivered by email (password reset / email verification). Only the
// sha256 hash is stored — the raw token lives only in the emailed URL. Single-use via `usedAt`.
model VerificationToken {
  id        String              @id @default(cuid())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  purpose   VerificationPurpose
  tokenHash String              @unique
  email     String // target email (forward-compat for email-change verify; = user.email for reset)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
}

// One-time 2FA recovery codes (hashed) — a fallback to log in when the TOTP device is lost.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  codeHash  String // sha256 of the canonical (dashless, upper-cased) code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A user's named fleet filter (status + tags) for the servers/fleet table.
model SavedView {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // null = personal (only the owner); set = shared with everyone on the team.
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String?
  name      String
  status    String? // ONLINE | PENDING | OFFLINE | null (all)
  tags      String[] @default([])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([teamId])
}

model ApiToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     String[]  @default(["read"]) // read | write | deploy | admin | read:secrets
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  uses       ApiTokenUse[]

  @@index([userId])
}

// MCP OAuth 2.1. A dynamically registered public client (RFC 7591): no secret, PKCE S256 only. redirectUris
// are matched exactly at /authorize and again at /token.
model OAuthClient {
  id           String       @id @default(cuid())
  name         String
  redirectUris String[]
  createdAt    DateTime     @default(now())
  grants       OAuthGrant[]
  codes        OAuthCode[]
}

// One-time authorization code (10 min). Only the sha256 is stored. usedAt marks it spent.
model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  teamId        String
  scopes        String[]
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  grantId       String? // the grant minted from this code, so a replayed code can revoke it
  createdAt     DateTime    @default(now())

  @@index([expiresAt])
}

// A consent: one user, one client, one team, a scope set. It is the refresh-token family: revoking it (or
// detecting refresh-token reuse) kills every token issued under it.
model OAuthGrant {
  id         String       @id @default(cuid())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  client     OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  teamId     String
  scopes     String[]
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  tokens     OAuthToken[]

  @@index([userId])
}

// An access + refresh pair (sha256 only). Refreshing marks the old row's refreshUsedAt and issues a new row;
// presenting a refresh token whose row is already used revokes the whole grant.
model OAuthToken {
  id               String     @id @default(cuid())
  grant            OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  grantId          String
  accessHash       String     @unique
  refreshHash      String     @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  refreshUsedAt    DateTime?
  createdAt        DateTime   @default(now())

  @@index([grantId])
}

// Bounded recent-use history of a PAT (newest ~50 per token; repeated identical calls are coalesced). Holds
// the source IP, user agent and the tool/route that was called — never the token itself.
model ApiTokenUse {
  id        String   @id @default(cuid())
  token     ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tokenId   String
  at        DateTime @default(now())
  ip        String?
  userAgent String?
  action    String? // "mcp:<tool>" or "<METHOD> <route>"
  count     Int      @default(1)

  @@index([tokenId, at])
}

model Team {
  id                 String                @id @default(cuid())
  name               String
  iconUpdatedAt      DateTime? // list-view marker so the team list never reads the icon bytes
  color              String? // chosen accent colour as "#rrggbb"; null = the default accent
  icon               TeamIcon?
  memberships        Membership[]
  servers            Server[]
  monitors           Monitor[]
  rollouts           Rollout[]
  channels           NotificationChannel[]
  digest             TeamDigest?
  applications       Application[]
  databases          Database[]
  backupDestinations BackupDestination[]
  sharedVariables    SharedVariable[]
  projects           Project[]
  invitations        TeamInvitation[]
  gitSources         GitSource[]
  registries         Registry[]
  cloudCredentials   CloudCredential[]
  costBaselines      CostBaseline[]
  dnsCredentials     DnsCredential[]
  secretProviders    SecretProvider[]
  savedViews         SavedView[]
  customRoles        TeamRole[]
  statusPage         StatusPage?
  clusters           Cluster[]
  objectMigrations   ObjectMigration[]
  importMappings     ImportMapping[]
  coolifyInventories CoolifyInventory[]
  coolifyHostGrants  CoolifyHostGrant[]
  coolifySshTargets  CoolifySshTarget[]
  createdAt          DateTime              @default(now())
}

// A team-defined named role with a granular set of resource permissions (see TEAM_PERMISSIONS in
// @tugra/shared). Assigned to a member via Membership.teamRoleId; grants ONLY resource permissions
// — member/role/team administration stays reserved for the built-in OWNER/ADMIN roles.
model TeamRole {
  id          String       @id @default(cuid())
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  name        String
  permissions String[]     @default([])
  // Customer-portal preset ("Client"): a member with this role only reaches the portal surface (their team's apps,
  // uptime and backups, plus deploy when granted) - every other route answers as if they were not a member.
  portal      Boolean      @default(false)
  memberships Membership[]
  invitations TeamInvitation[]
  createdAt   DateTime     @default(now())

  @@unique([teamId, name])
  @@index([teamId])
}

model TeamInvitation {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  email     String
  role      Role     @default(VIEWER)
  // Invite straight into a custom role (the Client portal presets); a deleted role revokes the pending invite.
  teamRole   TeamRole? @relation(fields: [teamRoleId], references: [id], onDelete: Cascade)
  teamRoleId String?
  token     String   @unique
  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([teamId, email])
  @@index([email])
}

model Project {
  id            String        @id @default(cuid())
  team          Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  name          String
  description   String? // carried by the importer from a source project (Dokploy); null for hand-made projects
  tags          String[]      @default([]) // source project tags (Dokploy projectTags names), informational
  isDefault     Boolean       @default(false) // the team's default project (exactly one per team)
  iconUpdatedAt DateTime? // list-view marker so the project list never reads the icon bytes
  color         String? // chosen accent colour as "#rrggbb"; null = the default accent
  icon          ProjectIcon?
  environments  Environment[]
  createdAt     DateTime      @default(now())

  @@index([teamId])
}

// A project's custom icon (square PNG), kept off the Project row (Project.iconUpdatedAt is the marker).
model ProjectIcon {
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @id
  mime      String // always "image/png" (anything else is rejected at upload)
  data      Bytes
  sizeBytes Int
  updatedAt DateTime @updatedAt
}

// A team's custom icon (square PNG), kept off the Team row (Team.iconUpdatedAt is the marker).
model TeamIcon {
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String   @id
  mime      String // always "image/png" (anything else is rejected at upload)
  data      Bytes
  sizeBytes Int
  updatedAt DateTime @updatedAt
}

// A database's custom icon (square PNG), kept off the Database row (Database.iconUpdatedAt is the marker).
model DatabaseIcon {
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  databaseId String   @id
  mime       String // always "image/png" (anything else is rejected at upload)
  data       Bytes
  sizeBytes  Int
  updatedAt  DateTime @updatedAt
}

model Environment {
  id           String        @id @default(cuid())
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  name         String
  isDefault    Boolean       @default(false) // the project's default environment (exactly one per project)
  applications Application[]
  databases    Database[]
  createdAt    DateTime      @default(now())

  @@index([projectId])
}

model SharedVariable {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  key       String
  valueEnc  String
  createdAt DateTime @default(now())

  @@unique([teamId, key])
  @@index([teamId])
}

model Membership {
  id     String @id @default(cuid())
  role   Role   @default(VIEWER)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  // Optional custom role: when set, the member's resource permissions come from this TeamRole
  // instead of the built-in `role` tier. SetNull so deleting a role reverts members to `role`
  // (VIEWER by default). null → the built-in enum role is authoritative (no regression).
  teamRole   TeamRole? @relation(fields: [teamRoleId], references: [id], onDelete: SetNull)
  teamRoleId String?

  // Per-resource access scoping (least privilege). Opt-in via `restrictedAccess`: while false
  // (the default, and every existing member) the member has full access at their team role — no
  // regression. When true, a VIEWER only sees the granted projects (+ their resources) and any
  // explicitly granted resource ids. OWNER/ADMIN always bypass scoping (they manage the team).
  restrictedAccess  Boolean  @default(false)
  accessedProjects  String[] @default([]) // project ids this member may access when restricted
  accessedResources String[] @default([]) // app/db ids (fine-grained escape hatch + grant-on-create)

  @@unique([userId, teamId])
}

model Server {
  id                     String                  @id @default(cuid())
  name                   String
  // The server seal ("Tugra"): the server's unique signed identity, set at enrollment.
  seal                   String?                 @unique
  status                 ServerStatus            @default(PENDING)
  enrollToken            String                  @unique
  enrollTokenExpiresAt   DateTime?
  // ed25519 public key the agent generated on-box (private key never leaves it).
  agentPublicKey         String?
  agentVersion           String?
  hostname               String?
  publicIp               String? // observed reachable IPv4 (or manual override)
  publicIpv6             String? // observed reachable IPv6
  ipSource               String                  @default("observed") // where publicIp came from: manual | reported (network interface) | metadata (cloud) | observed (hub saw it)
  ipv6Source             String                  @default("observed") // same, for publicIpv6 (families are reconciled separately)
  nameAuto               Boolean                 @default(false) // name was left blank at "Add server": adopt the agent's real hostname when it connects
  reportedIps            String[]                @default([]) // agent-reported candidate interface IPs (reconcile)
  wildcardDomain         String? // per-server magic-domain root (e.g. apps.example.com); blank → sslip.io
  magicSuffix            String? // override the global magic suffix ("sslip.io" | "nip.io")
  certMode               String                  @default("http") // "http" | "le-dns" | "custom" — wildcard cert policy
  dnsProvider            String? // lego/Traefik DNS provider for DNS-01 (cloudflare, route53, ...)
  dnsCredsEnc            String? // encrypted JSON of provider env vars ({ CF_DNS_API_TOKEN: "..." })
  customCertResolver     String? // Traefik resolver name when certMode = "custom"
  dnsCredentialId        String? // the team DnsCredential whose token was copied into dnsCredsEnc (coverage checks); SetNull on delete
  dnsCredential          DnsCredential?          @relation(fields: [dnsCredentialId], references: [id], onDelete: SetNull)
  os                     String?
  osVersion              String?
  arch                   String?
  kernel                 String?
  cpuCores               Int?
  memTotalBytes          BigInt?
  bootTime               DateTime?
  gpuInventory           Json? // sanitized GPU probe snapshot (GpuInventory, server-ops/gpu-inventory.ts). NULL = never probed = UNKNOWN, never "no GPU"
  gpuCheckedAt           DateTime? // when gpuInventory was last written
  scanReport             Json? // sanitized server scan ("What runs on this server", server-ops/server-scan.ts). NULL = never scanned. Holds no env values or secrets.
  scannedAt              DateTime? // when scanReport was last written
  // Exposed-service count of the latest scan (null = host half not checked). Kept beside the JSON so server lists, which
  // never load scanReport, can show the fleet-wide warning cheaply.
  scanExposedCount       Int?
  cleanupEnabled         Boolean                 @default(false)
  cleanupIntervalHours   Int?
  cleanupCron            String? // optional 5-field cron; when set, overrides cleanupIntervalHours
  cleanupThresholdPct    Int? // disk usage % at/above which a cleanup ALSO runs (extra trigger on top of the schedule, at most hourly)
  cleanupExplicit        Boolean                 @default(false) // true once an operator saved a cleanup config (UI/API/bulk): the default-on backfill never overrides an explicit choice
  description            String? // free-text operator note shown on the server page
  timezone               String? // IANA tz (e.g. Europe/Istanbul); applied to the cleanup cron schedule
  cleanupVolumes         Boolean                 @default(false)
  lastCleanupAt          DateTime?
  lastSeenAt             DateTime?
  // Hub endpoint list (agents advertising hub_endpoints_v1): what the agent last reported. `hubEndpointActive` is the URL
  // its session is on right now, `hubEndpointPrimary` the primary of the list it holds, `hubEndpointRev` that list's
  // revision, `hubEndpointError` why it refused the last pushed list (null = accepted). "Moved" = active == the hub's
  // current primary for the instance. Null = an older agent that never reports (it stays on its single install URL).
  hubEndpointActive      String?
  hubEndpointPrimary     String?
  hubEndpointRev         BigInt?
  hubEndpointError       String?
  hubEndpointAt          DateTime?
  team                   Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId                 String
  // Optional membership in a Cluster (a named group of this team's servers). SetNull: deleting the
  // cluster frees its servers rather than removing them. A server belongs to at most one cluster.
  cluster                Cluster?                @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  clusterId              String?
  // Docker Swarm formation. Role in the cluster's swarm (null = not joined); the docker node id
  // (for promote/demote/rm); the last sanitized join/leave error for this node (NEVER raw command output).
  // multiple MANAGER rows per cluster are now expected (multi-manager Raft HA) — the manager SET is
  // derived live from every swarmRole=MANAGER row, NOT just Cluster.swarmManagerId (which is only the PRIMARY).
  swarmRole              SwarmRole?
  swarmNodeId            String?
  swarmError             String?
  tags                   String[]                @default([])
  // Granted agent capabilities the hub will sign commands for. Enforced verbatim; empty = none
  // (fail-safe). Legacy servers are backfilled to the full set by migration; new servers default
  // to all-except-terminal (least privilege — the interactive shell is opt-in).
  capabilities           String[]                @default([])
  // True for the box the hub itself runs on, auto-provisioned at first-owner registration on a turnkey
  // single-box install so the user never pastes an agent command. Drives home-mode
  // reachability heuristics. Manually-enrolled servers are false.
  isLocal                Boolean                 @default(false)
  // How the server's reverse proxy publishes :80/:443: "public" (default, all interfaces)
  // | "loopback" (127.0.0.1 only, behind a front proxy) | "none" (no host port — tunnel-only, coexists with
  // another web server on the box). Applied when the proxy is (re)started.
  proxyBind              String                  @default("public")
  // Traffic Analytics (default ON for new servers — self-hosted: the operator's own visitor data on their
  // own server and hub; per-server toggle to turn off). When true the server's Traefik writes a field-minimal
  // JSON access log to a host file the agent can read; applied whenever the proxy is (re)created.
  trafficAnalytics       Boolean                 @default(true)
  // Cloud-provisioned servers only (null for manually-enrolled): the provider that created the VM,
  // its provider-side server id (needed to destroy it), and the credential used (SetNull so deleting
  // the credential leaves the server intact but drops its destroy-VM ability).
  provider               String?
  providerServerId       String?
  cloudCredential        CloudCredential?        @relation(fields: [cloudCredentialId], references: [id], onDelete: SetNull)
  cloudCredentialId      String?
  // True when an operator linked an EXISTING VM to a provider credential by hand (out-of-band power/rescue/
  // console). Tugra did not create that VM, so deleting the server record must never destroy it. False for a
  // VM Tugra provisioned itself (the link is written at provision time and enables destroy-VM on delete).
  providerManualLink     Boolean                 @default(false)
  metrics                Metric[]
  containerMetrics       ContainerMetric[]
  containerStates        ContainerState[]
  containerLabels        ContainerLabel[]
  containerEvents        ContainerEvent[]
  metricRollups          MetricRollup[]
  containerMetricRollups ContainerMetricRollup[]
  metricRollups5m        MetricRollup5m[]
  containerMetricRollups5m ContainerMetricRollup5m[]
  trafficMetrics         TrafficMetric[]
  trafficPaths           TrafficPath[]
  trafficCountries       TrafficCountry[]
  trafficBreakdowns      TrafficBreakdown[]
  trafficLatencies       TrafficLatency[]
  trafficUniques         TrafficUnique[]
  trafficUniqueHours     TrafficUniqueHour[]
  logDrains              LogDrain[]
  proxyDynamicConfigs    ProxyDynamicConfig[]
  reboots                ServerReboot[]
  coolifyInventory       CoolifyInventory?
  coolifyHostGrants      CoolifyHostGrant[]
  coolifySshTargets      CoolifySshTarget[]
  tunnel                 ServerTunnel?
  cost                   ServerCost?
  rescales               ServerRescale[]
  // Cloud provider the host's own metadata service / DMI vendor says it runs on (agent-reported, allow-listed slug).
  // A hint for price estimates only; `provider` (above) is the provider an operator linked or Tugra provisioned.
  cloudHint              String?
  createdAt              DateTime                @default(now())

  @@index([clusterId])
  @@index([dnsCredentialId])
}

// Operator-authored Traefik dynamic-config files (Coolify "Proxy > Dynamic Configurations" parity). Each row
// is one YAML file written to the proxy's /dynamic dir (as `user-<name>.yml`, namespaced so it never collides
// with the Tugra-managed panel.yml / tls-*.yml). Server-admin scoped (servers:ops); referenced from an app's
// router via a middleware name with the `@file` suffix.
model ProxyDynamicConfig {
  id        String   @id @default(cuid())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String
  name      String // slug (no extension); the file on disk is `user-<name>.yml`
  content   String // Traefik dynamic-config YAML (validated as parseable YAML before write)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([serverId, name])
  @@index([serverId])
}

// A named group of a team's servers (fleet organization + rollup + group-scoped ops). Model-agnostic
// foundation: it does not change deploy/networking — deploy is still per-server. A server belongs to at
// most one cluster (Server.clusterId).
model Cluster {
  id              String        @id @default(cuid())
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId          String
  name            String
  description     String?
  servers         Server[]
  applications    Application[] // apps deployed as swarm services onto this cluster
  // Docker Swarm formation. swarmManagerId is a loose FK to the PRIMARY manager Server.id — the node
  // the swarm-mode ingress is pinned to (by node label) and the default/fast-path dispatch target. // the FULL manager set is every Server with swarmRole=MANAGER for this cluster, not necessarily just this one
  // row (multi-manager Raft HA); this FK is NOT renamed, for API back-compat (SwarmView.managerServerId keeps
  // its meaning). Resolved in service code (matching Application.serverId convention — no @relation to avoid a
  // second Server↔Cluster relation). swarmLastError is a sanitized last error — NEVER raw command output/tokens.
  swarmStatus     SwarmStatus   @default(NONE)
  swarmManagerId  String?
  swarmLastError  String?
  // desired swarm-ingress (Traefik) replica count for HA. 1 = today's single-node routing (default,
  // zero behavior change). 2-3 = routing-mesh multi-replica ingress; requires DNS-01 (le-dns) on the manager
  // and is capped at 3 to stay under Let's Encrypt's duplicate-certificate rate limit. The actual pool is
  // re-derived live on every ensure() (manager first, then online joined members), never snapshotted.
  ingressReplicas Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([teamId, name])
  @@index([teamId])
}

model LogDrain {
  id           String       @id @default(cuid())
  server       Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId     String
  name         String
  type         String       @default("HTTP")
  endpoint     String
  authTokenEnc String?
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  // D7 per-app scope. appId NULL = a server-wide drain (every pre-D7 row). For an app drain serverId is the app's
  // serverId (the anchor); the effective target servers (cluster members) are resolved at push time.
  appId        String?
  app          Application? @relation(fields: [appId], references: [id], onDelete: Cascade)
  containers   String[]     @default([]) // app scope: compose service names; server scope: container-name globs; [] = no filter
  options      Json? // per-transport options (syslog/gelf/fluentd), zod-validated, NEVER secrets
  allowPrivate Boolean      @default(false) // app scope only: lets the drain reach private/loopback ranges (needs servers:ops)

  @@index([serverId])
  @@index([appId])
}

// Cloudflare Tunnel binding for a server (zero-IP expose). 1:1 with Server. Secrets
// (cfApiTokenEnc, cfTunnelTokenEnc) are libsodium-encrypted at rest and never returned.
model ServerTunnel {
  id               String   @id @default(cuid())
  server           Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId         String   @unique
  provider         String   @default("cloudflare")
  cfAccountId      String
  zoneName         String // registrable CF zone owning the wildcard (e.g. "example.com")
  zoneId           String
  cfApiTokenEnc    String // encrypted operator CF API token — NEVER returned/logged
  tunnelId         String? // CF tunnel UUID, set once createTunnel succeeds (idempotent resume)
  tunnelName       String // deterministic "tugra-<serverId>"
  cfTunnelTokenEnc String? // encrypted cloudflared connector run-token
  dnsRecordId      String? // CF DNS record id of the wildcard CNAME (exact teardown)
  status           String   @default("pending") // pending | connecting | connected | error | disabled
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Metric {
  id           String   @id @default(cuid())
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId     String
  ts           DateTime @default(now())
  cpu          Float
  memUsed      BigInt
  memTotal     BigInt
  diskUsed     BigInt
  diskTotal    BigInt
  netRx        BigInt
  netTx        BigInt
  diskRead     BigInt   @default(0) // bytes/s; @default so the additive migration needs no backfill
  diskWrite    BigInt   @default(0)
  // Load average + swap — NULL when an older agent / host doesn't report them (no fake 0).
  load1        Float?
  load5        Float?
  load15       Float?
  swapUsed     BigInt?
  swapTotal    BigInt?
  // Optional sensor metrics — NULL (not 0) when the host exposes none (most cloud VMs), so the UI can
  // render "—" rather than a fake reading. gpu* are aggregates over all GPUs (max util/temp, summed
  // VRAM); `detail` keeps the per-sensor map + per-GPU list for the detail view.
  temp         Float?
  gpuUtil      Float?
  gpuMemUsed   BigInt?
  gpuMemTotal  BigInt?
  gpuTemp      Float?
  batteryPct   Float?
  batteryState String?
  detail       Json?

  @@index([serverId, ts])
  @@index([ts]) // for the retention prune (deleteMany where ts < cutoff, across all servers)
}

// Per-container resource usage from the agent's `docker stats`. containerName is the STABLE key
// (containerId changes on restart); net/block are rates (B/s) the agent derives from cumulative
// deltas. Unbounded until a retention prune scheduler is added (@@index([ts]) is for that).
model ContainerMetric {
  id            String   @id @default(cuid())
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  containerName String
  containerId   String
  ts            DateTime @default(now())
  cpu           Float
  memUsed       BigInt
  memTotal      BigInt
  memPct        Float
  netRx         BigInt
  netTx         BigInt
  blkRead       BigInt
  blkWrite      BigInt

  @@index([serverId, containerName, ts])
  @@index([ts])
}

// Allow-listed labels the agent read off a container (Coolify name/resource/project/environment, compose
// service) so the dashboard can show a real app and project name instead of an opaque id. One row per
// (server, containerName); rewritten only when the labels change (or once a day to prove it is current) and
// pruned when it stops being refreshed. Never holds anything but those five short strings.
model ContainerLabel {
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  containerName String
  name          String   @default("") // coolify.name
  resource      String   @default("") // coolify.resourceName
  project       String   @default("") // coolify.projectName
  environment   String   @default("") // coolify.environmentName
  service       String   @default("") // com.docker.compose.service
  updatedAt     DateTime @default(now())

  @@id([serverId, containerName])
  @@index([updatedAt])
}

// Last-known lifecycle state of each container on a server, for crash/OOM TRANSITION detection by the
// container-health poll (server-ops/container-health.*). One row per (server, containerName) — the stable
// key, since containerId changes on recreate. Persisted (not in-memory) so a hub restart never re-seeds or
// double-alerts. Rows for containers no longer present are deleted each tick (bounded).
model ContainerState {
  server               Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId             String
  containerName        String
  containerId          String
  status               String // running | exited | restarting | dead | created | paused
  exitCode             Int       @default(0)
  oomKilled            Boolean   @default(false)
  restartCount         Int       @default(0)
  startedAt            DateTime?
  finishedAt           DateTime?
  health               String? // healthy | unhealthy | starting | null (from docker HEALTHCHECK)
  lastEventTs          BigInt    @default(0) // newest docker-event epoch consumed → next tick's --since cursor
  lastNotifiedKey      String? // `${containerId}:${restartCount}:${finishedAt}` of the last alerted death
  lastNotifiedAt       DateTime?
  restartCountAtNotify Int       @default(0)
  unhealthySince       DateTime? // when the container first reported `unhealthy` (continuous; cleared on recovery)
  healthNotifiedAt     DateTime? // last unhealthy alert — own cooldown, separate from the crash lastNotifiedAt
  memNotifiedAt        DateTime? // last memory-pressure (pre-OOM) alert — own cooldown
  updatedAt            DateTime  @updatedAt

  @@id([serverId, containerName])
  @@index([updatedAt])
}

// Append-only crash/OOM episode history for a container, written by the container-health poll on each
// detected death (one row per poll-tick-with-change, so a fast restart-loop yields ≤1 row per 60s). Powers
// the "why does this keep restarting" timeline: exit code + human reason + the frozen pre-crash log tail that
// `docker logs` would otherwise lose on recreate. Pruned by RetentionRunnerService (CONTAINER_EVENT_RETENTION_DAYS).
model ContainerEvent {
  id            String   @id @default(cuid())
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  containerName String
  containerId   String
  ts            DateTime // when the episode was observed (docker-event time if known, else poll time)
  kind          String // crash | oom
  exitCode      Int      @default(0)
  oomKilled     Boolean  @default(false)
  restartCount  Int      @default(0)
  restartDelta  Int      @default(0)
  reason        String? // human-readable exit-code explanation (137 → "OOM / SIGKILL", etc.)
  logTail       String?  @db.Text // frozen last log lines captured at crash time (clamped), null if unavailable
  createdAt     DateTime @default(now())

  @@index([serverId, containerName, ts])
  @@index([createdAt])
}

// 1-minute rollup of host Metric rows (avg/max per bucket) — lets long-range charts survive past the
// raw retention window. Populated by the rollup scheduler; one row per (serverId, minute bucket).
model MetricRollup {
  id           String   @id @default(cuid())
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId     String
  bucket       DateTime // minute-truncated
  avgCpu       Float
  maxCpu       Float
  avgMemUsed   BigInt
  avgMemTotal  BigInt
  avgDiskUsed  BigInt
  avgDiskTotal BigInt
  avgNetRx     BigInt
  avgNetTx     BigInt
  avgDiskRead  BigInt
  avgDiskWrite BigInt
  // Nullable: averaged over only the samples that reported them; NULL when none did.
  avgLoad1     Float?
  avgLoad5     Float?
  avgLoad15    Float?
  avgSwapUsed  BigInt?
  avgSwapTotal BigInt?

  @@unique([serverId, bucket])
  @@index([bucket]) // for the rollup retention prune (deleteMany where bucket < cutoff)
}

// 1-minute rollup of ContainerMetric rows, one row per (serverId, containerName, minute bucket).
model ContainerMetricRollup {
  id            String   @id @default(cuid())
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  containerName String
  bucket        DateTime
  avgCpu        Float
  maxCpu        Float
  avgMemUsed    BigInt
  avgMemTotal   BigInt
  avgMemPct     Float
  avgNetRx      BigInt
  avgNetTx      BigInt
  avgBlkRead    BigInt
  avgBlkWrite   BigInt

  @@unique([serverId, containerName, bucket])
  @@index([bucket])
}

// 5-minute tier of MetricRollup: one row per (serverId, 5-minute bucket), rolled up from the 1-minute rows and kept
// METRICS_ROLLUP_RETENTION_DAYS (28) while the 1-minute rows are kept only METRICS_ROLLUP_1M_RETENTION_HOURS (48).
// A separate table (not a resolution column) so the live table is never rewritten or re-keyed, each tier prunes by
// its own bucket index, and the composite key replaces the surrogate id + unique index (about a quarter smaller).
model MetricRollup5m {
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId     String
  bucket       DateTime // 5-minute aligned
  avgCpu       Float
  maxCpu       Float
  avgMemUsed   BigInt
  avgMemTotal  BigInt
  avgDiskUsed  BigInt
  avgDiskTotal BigInt
  avgNetRx     BigInt
  avgNetTx     BigInt
  avgDiskRead  BigInt
  avgDiskWrite BigInt
  avgLoad1     Float?
  avgLoad5     Float?
  avgLoad15    Float?
  avgSwapUsed  BigInt?
  avgSwapTotal BigInt?

  @@id([serverId, bucket])
  @@index([bucket])
}

// 5-minute tier of ContainerMetricRollup (see MetricRollup5m).
model ContainerMetricRollup5m {
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  containerName String
  bucket        DateTime // 5-minute aligned
  avgCpu        Float
  maxCpu        Float
  avgMemUsed    BigInt
  avgMemTotal   BigInt
  avgMemPct     Float
  avgNetRx      BigInt
  avgNetTx      BigInt
  avgBlkRead    BigInt
  avgBlkWrite   BigInt

  @@id([serverId, containerName, bucket])
  @@index([bucket])
}

// Visitor-traffic aggregates pushed by the agent, already summed per (host, minute) — so there is no
// raw/rollup split. `domain` is the lowercased request host as the agent saw it; `appId` is the owning
// Application resolved on the hub from THIS server's apps only (null = unmatched host). Counts only: no
// client IPs are stored. Rows are upsert-incremented (additive, NOT idempotent): the agent reports disjoint
// windows, each at most once. Unmatched hosts beyond a small per-bucket cap fold into one "(unmatched)" row.
model TrafficMetric {
  id            String   @id @default(cuid())
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  domain        String
  appId         String?
  bucket        DateTime // minute-floored
  requests      Int
  s2xx          Int
  s3xx          Int
  s4xx          Int
  s5xx          Int
  bytes         BigInt
  // Human vs bot request split (agent-side UA classification); older agents leave both at 0.
  botRequests   Int      @default(0)
  humanRequests Int      @default(0)

  @@unique([serverId, domain, bucket])
  @@index([bucket])
  @@index([serverId, bucket])
}

// Top request paths per (server, host, minute) — query string stripped, capped per bucket with the
// overflow folded into a single "(other)" row.
model TrafficPath {
  id       String   @id @default(cuid())
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId String
  domain   String
  bucket   DateTime
  path     String
  requests Int
  bytes    BigInt

  @@unique([serverId, domain, bucket, path])
  @@index([serverId, domain, bucket])
  @@index([bucket])
}

// Requests per visitor country (ISO-3166 alpha-2, "ZZ" = unknown/overflow) per (server, host, minute).
model TrafficCountry {
  id       String   @id @default(cuid())
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId String
  domain   String
  bucket   DateTime
  country  String
  requests Int

  @@unique([serverId, domain, bucket, country])
  @@index([serverId, domain, bucket])
  @@index([bucket])
}

// Requests per (dimension, key) per (server, host, minute) — ONE generic table for the visitor dimensions
// dim = browser | os | device | referrer | city | network. Top-N per (host, bucket, dim); the overflow is
// folded into a single "(other)" key. Counts only (no IPs / UA strings / full referrer URLs).
model TrafficBreakdown {
  id       String   @id @default(cuid())
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId String
  domain   String
  bucket   DateTime
  dim      String
  key      String
  requests Int

  @@unique([serverId, domain, bucket, dim, key])
  @@index([serverId, domain, bucket, dim])
  @@index([bucket])
}

// Response-latency histogram per (server, host, minute), long format: `idx` 0..13 indexes
// TRAFFIC_LATENCY_BUCKETS_MS (13 inclusive upper bounds + the overflow bucket); one row per non-empty bucket.
model TrafficLatency {
  id       String   @id @default(cuid())
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId String
  domain   String
  bucket   DateTime
  idx      Int
  requests Int

  @@unique([serverId, domain, bucket, idx])
  @@index([serverId, domain, bucket])
  @@index([bucket])
}

// Unique-visitor HyperLogLog sketch per (server, host, minute): the agent's 4096 one-byte registers (p=12), merged
// element-wise (max) on conflict and again at query time, so range/fleet unique counts stay correct. The bytes are
// register ranks only — never a client IP. See apps/hub-api/src/traffic/hll.ts for the contract.
model TrafficUnique {
  id       String   @id @default(cuid())
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId String
  domain   String
  bucket   DateTime
  sketch   Bytes

  @@unique([serverId, domain, bucket])
  @@index([serverId, domain, bucket])
  @@index([bucket])
}

// The same sketch rolled up to one row per (server, host, HOUR): written alongside every minute row (same merge), read
// for the long ranges (7d/30d) so a summary scans ~60x fewer 4 KB rows and a long retention stays cheap, while the
// minute rows (read only for ranges <= 24h) are pruned after ~48h. Register ranks only, never a client IP.
model TrafficUniqueHour {
  id       String   @id @default(cuid())
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId String
  domain   String
  bucket   DateTime
  sketch   Bytes

  @@unique([serverId, domain, bucket])
  @@index([serverId, domain, bucket])
  @@index([bucket])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([target, createdAt]) // per-resource audit (GET /apps|servers|databases/:id/audit) filters by target
  @@index([actor, createdAt]) // actor-scoped list + Pro export (WHERE actor IN (...) ORDER BY createdAt)
}

enum MonitorType {
  HTTP
  TCP
  METRIC
  KEYWORD // HTTP + the body must (or must not) contain a keyword
  PING // ICMP echo
  DNS // resolve a record
}

enum MonitorStatus {
  UP
  DOWN
  PENDING
}

model Monitor {
  id           String           @id @default(cuid())
  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  name         String
  type         MonitorType
  target       String // url (HTTP) or host:port (TCP); a label for METRIC
  serverId     String? // METRIC: which server's metrics to watch
  metric       String? // METRIC: DISK | CPU | MEM | LOAD1 | LOAD5 | LOAD15 | TEMP | NET
  thresholdPct Int? // METRIC (DISK/CPU/MEM): alarm when usage >= this %
  thresholdValue Float? // METRIC (LOAD*, TEMP in °C, NET in MB/s): alarm when the reading >= this
  intervalSec  Int              @default(30)
  retries      Int              @default(1)
  timeoutMs    Int              @default(10000)
  resendEvery  Int              @default(0) // re-notify every N consecutive down beats (0 = off)
  status       MonitorStatus    @default(PENDING)
  failCount    Int              @default(0) // consecutive failures (for retry → DOWN)
  downCount    Int              @default(0) // consecutive down beats (for resend)
  enabled      Boolean          @default(true)
  // Auto-created uptime monitor for an app's domain (auto=true, appId set).
  appId        String?
  auto         Boolean          @default(false)
  // HTTP / KEYWORD options (all optional; null/empty = the previous plain GET behaviour).
  method         String? // GET | HEAD | POST | PUT | PATCH | DELETE | OPTIONS
  keyword        String? // KEYWORD: text the response body must contain (case-sensitive)
  keywordInvert  Boolean  @default(false) // KEYWORD: DOWN when the keyword IS present
  acceptedStatus String[] @default([]) // e.g. ["200-299","401"]; empty = 200-399
  httpOptionsEnc String? // encrypted JSON {headers?, basicAuth?, body?} (secrets never stored plaintext)
  ignoreTls      Boolean  @default(false)
  maxRedirects   Int      @default(10)
  upsideDown     Boolean  @default(false) // UP when the check FAILS (and vice versa)
  // DNS options.
  dnsRecordType  String? // A | AAAA | CNAME | MX | NS | TXT | SRV | CAA | PTR
  dnsServer      String? // resolver address; null = the hub's system resolver
  dnsExpect      String? // optional: an answer must contain this value
  heartbeats   Heartbeat[]
  channels     MonitorChannel[]
  statusPages  StatusPageMonitor[]
  createdAt    DateTime         @default(now())

  @@index([appId])
}

model Heartbeat {
  id        String        @id @default(cuid())
  monitor   Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  status    MonitorStatus
  ms        Int // latency
  msg       String?
  cause     String? // machine-readable failure class, e.g. "cf:522" (Cloudflare <-> origin); the UI localizes it
  important Boolean       @default(false)
  ts        DateTime      @default(now())

  @@index([monitorId, ts])
  @@index([ts]) // for the retention prune (deleteMany where ts < cutoff AND important = false)
}

model NotificationChannel {
  id          String                 @id @default(cuid())
  team        Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  name        String
  type        String // webhook | telegram | ntfy | discord | slack | smtp | gotify
  configEnc   String // encrypted JSON config (secrets never stored plaintext)
  enabled     Boolean                @default(true)
  eventTypes  String[]               @default([]) // deploy_success | deploy_failed | server_offline …
  locale      String                 @default("en") // notification language (server-side i18n)
  // Routing rule (additive to eventTypes): categories uptime|deploy|backup|server|security|updates select
  // events by category ([] = none, so legacy channels keep their eventTypes-only behaviour); minSeverity
  // info|warning|critical drops anything milder; topics maps category → Telegram message_thread_id.
  categories  String[]               @default([])
  minSeverity String                 @default("info")
  topics      Json?
  // Delivery policy: { quietHours?: {from,to,tz,allowCritical}, rateLimitPerMin?, dedupeWindowSec? } (null = defaults).
  policy      Json?
  monitors    MonitorChannel[]
  deliveries  NotificationDelivery[]
  digests     TeamDigest[]
  createdAt   DateTime               @default(now())
}

// Opt-in weekly digest for a team: sent Monday morning (hub time) to the chosen channel. lastSentAt is the
// atomic claim that keeps a multi-hub / restarted sweep from sending twice in one week.
model TeamDigest {
  team       Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String               @id
  enabled    Boolean              @default(false)
  channel    NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  channelId  String?
  lastSentAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

// Per-attempt delivery record for a fired notification — the durable audit/history behind the queue
// (BullMQ retries feed status FAILED → DEAD). Message content is snapshotted; config secrets never are.
model NotificationDelivery {
  id        String                     @id @default(cuid())
  channel   NotificationChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String
  event     String
  level     String
  title     String
  summary   String
  status    NotificationDeliveryStatus @default(PENDING)
  attempts  Int                        @default(0)
  lastError String?
  createdAt DateTime                   @default(now())
  sentAt    DateTime?

  @@index([channelId, createdAt])
  @@index([status])
}

model MonitorChannel {
  monitor   Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String

  @@id([monitorId, channelId])
}

// A registered Git provider app (GitHub App) for private-repo deploys.
/// A team's connection to a git host. `provider` is the kind discriminator: "github" (a GitHub App: appId +
/// privateKeyEnc + installationId) or the Gitea family "gitea" | "forgejo" | "codeberg" (a personal access token:
/// apiUrl + tokenEnc). appId / privateKeyEnc are GitHub-App-only so they are nullable; @@unique([teamId, appId])
/// still holds because Postgres treats NULLs as distinct (any number of token sources per team, one row per
/// GitHub App). tokenEnc is encrypted at rest and NEVER returned in any view.
model GitSource {
  id               String        @id @default(cuid())
  team             Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId           String
  name             String
  provider         String        @default("github") // github | gitea | forgejo | codeberg
  appId            String?
  appSlug          String?
  clientId         String?
  clientSecretEnc  String?
  privateKeyEnc    String?
  webhookSecretEnc String?
  installationId   String?
  htmlUrl          String?
  apiUrl           String? // token providers: the instance base URL (https, no trailing slash), e.g. https://codeberg.org
  tokenEnc         String? // token providers: the encrypted personal access token
  /// Instance-owner switch: every team may use this source (import linking, app create/link, repo/branch lists).
  sharedAllTeams   Boolean       @default(false)
  applications     Application[]
  /// GitHub App: every account / organization the App is installed on (the legacy `installationId` stays the primary).
  installations    GitSourceInstallation[]
  createdAt        DateTime      @default(now())

  @@unique([teamId, appId])
  @@index([teamId])
}

/// One installation of a GitHub App source (a personal account or an organization) with the account details GitHub
/// reports, so the Git Sources screen can show who it is installed for and pick the right installation per repo owner.
model GitSourceInstallation {
  id             String    @id @default(cuid())
  source         GitSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId       String
  installationId String
  accountLogin   String?
  accountType    String? // User | Organization
  avatarUrl      String?
  createdAt      DateTime  @default(now())

  @@unique([sourceId, installationId])
}

/// A short-lived, single-use, user-bound ticket for the GitHub App manifest flow. Only the SHA-256 of the random `state`
/// is stored. `kind` "manifest" = waiting for GitHub to redirect back with the manifest code; "install" = waiting for the
/// installation redirect. `sourceId` is the id the GitSource gets (the webhook URL needs it before the row exists).
model GitSourceSetup {
  id             String    @id @default(cuid())
  stateHash      String    @unique
  kind           String // manifest | install
  userId         String
  teamId         String
  sourceId       String
  name           String?
  sharedAllTeams Boolean   @default(false)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

// A team-scoped container registry for pushing built images (portable rollback / multi-server).
model Registry {
  id           String        @id @default(cuid())
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  name         String
  type         String        @default("generic") // dockerhub | ghcr | gitlab | generic
  url          String? // registry host (blank → Docker Hub); e.g. ghcr.io, registry.gitlab.com
  username     String
  passwordEnc  String // encrypted registry password / access token
  imagePrefix  String? // namespace/org under which images are pushed (e.g. myorg)
  applications Application[]
  createdAt    DateTime      @default(now())

  @@index([teamId])
}

/// A team's cloud-provider API credential (Hetzner, and later DigitalOcean/Vultr) used to provision
/// servers. The API token is encrypted at rest and NEVER returned in any view.
model CloudCredential {
  id          String   @id @default(cuid())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  name        String
  provider    String // "hetzner" | "digitalocean" | "vultr" — only "hetzner" has a client in v1
  apiTokenEnc String // encrypted cloud API token — never returned/logged
  servers     Server[]
  createdAt   DateTime @default(now())

  @@index([teamId])
}

// Team-scoped DNS-provider API credential (one-click custom-domain DNS auto-setup). Mirrors CloudCredential:
// the token is verified against the provider BEFORE encrypt+persist and is NEVER returned/logged.
model DnsCredential {
  id             String          @id @default(cuid())
  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId         String
  name           String
  provider       String // "cloudflare" — only provider with a client in v1
  apiTokenEnc    String // encrypted DNS-provider API token — never returned/logged
  cfAccountId    String? // optional Cloudflare account id (not needed for plain DNS-record writes)
  lastVerifiedAt DateTime?
  domains        Domain[] // domains whose auto-setup used this credential (SetNull on delete)
  cutoverDomains CutoverDomain[]
  servers        Server[]
  createdAt      DateTime        @default(now())

  @@index([teamId])
}

enum BulkTaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
  // Added for multi-step orchestrated operations (e.g. the importer executor):
  ROLLED_BACK // a completed item whose created resources were undone by a rollback
  FAILED_VERIFY // the step ran but a post-step verification (row counts, health) failed
  AWAITING_CUTOVER // staged and ready, waiting for an explicit cutover step
  CANCELLED // a not-yet-started item abandoned because the operation was cancelled
}

model BulkOperation {
  id                      String                    @id @default(cuid())
  actorId                 String
  // `command` is the raw fan-out command for kind="command" (the original/only use); orchestrated kinds
  // (e.g. kind="import") leave it empty and describe the work on the tasks instead.
  command                 String
  // Generalization for orchestrated operations. kind="command" is the legacy fan-out path, unchanged.
  kind                    String                    @default("command")
  planId                  String? // the ImportPlan (or similar) this operation executes, when applicable
  meta                    Json? // operation-level metadata (secret-free), e.g. the import source + target server
  // Cooperative cancel: set by a cancel request; the in-flight fan-out reads it before starting each
  // remaining task and stops launching new ones (a task already RUNNING is left to finish).
  cancelRequestedAt       DateTime?
  // One-time importer MIGRATION token (S2). Source-agnostic: an untrusted source host presents it
  // (Authorization: Bearer tugra_mig_…) to stream migration artifacts to the hub; the guard resolves the
  // opId from the token alone (the host never names the destination). Only the SHA-256 is stored (mirrors
  // ApiToken.tokenHash — the enroll token's plaintext storage is deliberately NOT copied). NULL = no live
  // token; revoke = null both columns, so the unique-hash lookup simply stops matching.
  migrationTokenHash      String?                   @unique
  migrationTokenExpiresAt DateTime?
  tasks                   BulkTask[]
  cutoverDomains          CutoverDomain[]
  cutoverRuns             CutoverRun[]
  cutoverCerts            CutoverCert[]
  volumeTransfers         MigrationVolumeTransfer[]
  createdAt               DateTime                  @default(now())
}

enum VolumeTransferState {
  PENDING
  COPYING
  COPIED
  APPLYING
  DONE
  FAILED
  ABORTED
}

// One streamed copy of a source volume (migration volume stream v2). The row id is ALSO the relay moveId and the
// staging directory name on the target (/etc/tugra/app-moves/<id>).
model MigrationVolumeTransfer {
  id             String                @id @default(cuid())
  opId           String
  operation      BulkOperation         @relation(fields: [opId], references: [id], onDelete: Cascade)
  itemRef        String // volume:<serverRef|_>:<sourceRef>:<volName>
  destType       String // 'app-volume' | 'db-data'
  targetServerId String // hub-derived from the op's DONE task, never from the migrator
  dockerVolume   String // hub-derived destination docker volume
  resourceType   String // 'application' | 'database'
  resourceId     String
  state          VolumeTransferState   @default(PENDING)
  attempt        Int                   @default(1) // bumped by reset; part of the rollback-snapshot restoreId
  partRawBytes   Int // R, fixed per attempt (hub policy)
  partsDone      Int                   @default(0)
  bytesDone      BigInt                @default(0) // compressed bytes committed on the target
  rawBytesDone   BigInt                @default(0)
  rawBytesTotal  BigInt? // inventory du -sb, advisory
  rawBytesFinal  BigInt? // migrator-reported at finish, cross-checked against the part rows
  entries        Int?
  fingerprint    Json? // begin-time source fingerprint (secret-free)
  runId          String? // lease owner (the migrator process)
  lastBeatAt     DateTime?
  phase          String?
  bps            BigInt?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  parts          MigrationVolumePart[]

  @@unique([opId, itemRef])
  @@index([state, lastBeatAt])
}

model MigrationVolumePart {
  transferId String
  transfer   MigrationVolumeTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  idx        Int
  rawOffset  BigInt
  rawLen     Int
  rawSha256  String // sha256 of the RAW tar slice (resume check, compressor-independent)
  size       Int // compressed member length
  sha256     String // sha256 of the compressed member (relay + target verified)
  doneAt     DateTime                @default(now())

  @@id([transferId, idx])
}

/// One verification result of a migration run (P7 lane B): a queryable parity check with an honest trust label
/// (`evidenceKind`: hub-verified | migrator-reported | operator-attested), the same idea as the volume panel's
/// "reported by the migrator" note. Loose `runId` (no FK) like AppMove.appId, so the evidence survives run deletion
/// for audit. `evidence` is secret-free; the writer caps it at 8 KiB per verdict row and 512 KiB for the raw `source-stats`
/// measurement the migrator reports (an oversize value is replaced by a `{truncated:true}` marker).
model MigrationRunCheck {
  id           String   @id @default(cuid())
  runId        String
  stepKey      String // VERIFY | DATA_SEED | DATA_FINAL ...
  checkId      String // stable check id, e.g. volume-parity, db-logical-parity
  subject      String // item ref, host or bucket ("" when the check has none)
  status       String // pass | fail | warn | unknown
  evidenceKind String // hub-verified | migrator-reported | operator-attested
  evidence     Json? // secret-free, <= 8 KiB
  at           DateTime @default(now())

  @@unique([runId, stepKey, checkId, subject])
  @@index([runId, stepKey])
}

model BulkTask {
  id           String         @id @default(cuid())
  operation    BulkOperation  @relation(fields: [opId], references: [id], onDelete: Cascade)
  opId         String
  serverId     String
  status       BulkTaskStatus @default(PENDING)
  exitCode     Int?
  output       String?
  // Generalization: a task can be one typed item of an orchestrated plan rather than a shell command.
  kind         String         @default("command") // "command" (legacy) | "app" | "database" | "volume" | ...
  itemRef      String? // the plan item this task realizes (idempotency key on re-run)
  resourceType String? // the Tugra resource this task created, for rollback (e.g. "database")
  resourceId   String? // its id
  result       Json? // structured result (secret-free)
  steps        Json? // ordered [{ name, status, startedAt?, finishedAt?, detail? }] for multi-step items
  dependsOn    String[]       @default([]) // itemRefs that must finish first (topological ordering)
  compensation Json? // how to undo this task's effect on rollback
  startedAt    DateTime?
  finishedAt   DateTime?

  @@unique([opId, itemRef]) // idempotency: one task per plan item per operation (legacy null itemRefs are distinct)
  @@index([opId])
}

/// A short-lived, encrypted connection to an external source PaaS (e.g. Coolify) for the importer. The API
/// token is stored encrypted-at-rest (CryptoService); baseUrl is non-secret. Scoped to a team + its creator.
model ImportSession {
  id         String    @id @default(cuid())
  teamId     String
  actorId    String
  sourceKind String // "coolify" (future: dokploy | caprover | dokku)
  baseUrl    String // the external instance base URL (non-secret)
  tokenEnc   String // CryptoService-encrypted API token — never returned by any endpoint
  status     String    @default("active") // active | revoked
  scopeKey   String    @default("") // user label of the source team/token (Coolify tokens are team-scoped) — keys the mapping profile
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  // Coolify hub takeover (lane A). `transport` "api" = the token path above; "agent" = read through the agent on the Coolify host:
  // baseUrl is then the synthetic `agent://<serverId>` and tokenEnc stays "" (the rotation skips an empty value).
  transport     String  @default("api") // api | agent
  agentServerId String? // the Tugra server whose agent reads Coolify (agent transport only)
  snapshotEnc   String? // CryptoService-encrypted snapshot of the last agent read (secret-free plan source); never returned by any endpoint
  sessionKeyEnc String? // CryptoService-encrypted per-session X25519 private key of the sealed pipeline; never returned by any endpoint
  sourceTeamRef String? // agent transport: the Coolify team whose settings (notifications, shared variables, tags, members) this session reads
  hostLinks     Json? // agent transport: the owner's own answers to "is this the same machine", { <coolify server uuid>: { serverId: string | null } }; ids only
  teamMap       Json? // agent transport: the owner's Coolify team to Tugra team mapping, { <coolify team ref>: <tugra team id> | null (null = leave that team out) }; ids only

  @@index([teamId])
}

/// A persisted, editable import mapping profile: ONE per (team, source kind, normalized base URL, scope label).
/// Names and placement only — never a secret. Reloaded as the editable default on the next import from the same
/// source; the apply must re-send it explicitly (a stored profile is never applied implicitly).
model ImportMapping {
  id              String    @id @default(cuid())
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId          String
  sourceKind      String // coolify | dokploy
  baseUrl         String // normalizeBaseUrl(): lowercase scheme+host, default port and trailing slash stripped, no creds/query/hash
  scopeKey        String    @default("")
  label           String?
  mapping         Json // the mapping document (names only, never secrets)
  mappingHash     String // hash of the normalized doc alone (display; apply uses the bound hash)
  version         Int       @default(1) // optimistic concurrency for PUT
  lastAppliedOpId String?
  lastAppliedAt   DateTime?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([teamId, sourceKind, baseUrl, scopeKey])
  @@index([teamId])
}

enum AppStatus {
  NEW
  RUNNING
  STOPPED
  FAILED
}

enum AppSource {
  IMAGE
  GIT
  COMPOSE
}

enum SourceCommitMode {
  OFF
  RUNTIME // SOURCE_COMMIT env in the running container
  BUILD // RUNTIME + a --build-arg at build time
}

enum BuildType {
  NIXPACKS
  DOCKERFILE
  STATIC
  RAILPACK
  HEROKU
}

enum DeploymentStatus {
  QUEUED // waiting for the app's in-flight deploy to finish (one RUNNING deploy per app at a time)
  RUNNING
  SUCCESS
  FAILED
  CANCELLED // a QUEUED deploy dropped before it started (by the user, a newer push, or a hub restart)
}

enum DbEngine {
  POSTGRES
  MYSQL
  REDIS
  MONGO
  MARIADB
  KEYDB
  DRAGONFLY
  CLICKHOUSE
  LIBSQL
}

enum DbStatus {
  NEW
  PROVISIONING
  RUNNING
  STOPPED
  FAILED
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model VolumeBackup {
  id            String       @id @default(cuid())
  app           Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId         String
  volumeName    String
  status        BackupStatus @default(PENDING)
  filename      String
  path          String
  destinationId String?
  objectKey     String?
  sizeBytes     BigInt?
  createdBy     String
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  // Run outcome (mirrors Restore): a FAILED row records WHY. errorTail is scrubbed + writer-only exposure.
  exitCode      Int?
  errorTail     String?
  durationMs    Int?
  // Server whose disk holds a LOCAL backup file; NULL = "the app's current server" (every legacy row). Stamped by an app move's cutover.
  hostServerId  String?

  @@index([appId])
}

enum DestType {
  LOCAL
  S3
}

model Application {
  id                           String               @id @default(cuid())
  team                         Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId                       String
  environment                  Environment          @relation(fields: [environmentId], references: [id], onDelete: NoAction)
  environmentId                String
  serverId                     String
  buildServerId                String? // optional separate build server (build+push there, pull+run on serverId)
  // Swarm service deploy: when clusterId is set the app deploys as a `docker service --replicas N`
  // onto this cluster's swarm (commands target cluster.swarmManagerId, re-resolved fresh — never snapshotted).
  // serverId stays required as the ingress/monitoring anchor. SetNull: deleting the cluster falls the app
  // back to classic single-server deploy rather than deleting it.
  cluster                      Cluster?             @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  clusterId                    String?
  replicas                     Int? // swarm service replica count (null = classic single-server deploy)
  placement                    Json? // { constraints: PlacementConstraint[], spreadLabelKey: string|null } — structured, picker-sourced, never a raw docker expression from the client
  constraintServerId           String? // system hard-pin for a stateful (named-volume) app — the Server whose swarm node its single replica must run on; loose FK like swarmManagerId, resolved in service code
  name                         String
  description                  String? // free-text operator note shown on the app page (Coolify parity)
  templateSlug                 String? // catalog slug when installed from a template (for its logo)
  // A user-uploaded custom icon lives in the sibling AppIcon table (bytes kept out of this hot row). This
  // nullable marker is set to the upload time and cleared on removal: the app list reads it to know whether
  // an icon exists and to cache-bust the icon URL, without ever fetching the image bytes.
  iconUpdatedAt                DateTime?
  iconKey                      String? // picked brand icon from the shared set (null = automatic)
  source                       AppSource            @default(IMAGE)
  image                        String?
  // Image-update check (IMAGE apps only; scheduled digest probe run by the app's own agent). Operational state,
  // NOT deploy config: never enters ConfigSnapshot (snapV stays 2), never produces a drift diff.
  imageUpdateCheck             Boolean              @default(true)
  imageUpstreamDigest          String? // last good upstream digest, "sha256:<64hex>"; kept across failed probes
  imageUpstreamCheckedAt       DateTime? // last probe attempt that produced a verdict (ok OR classified error)
  imageUpstreamChangedAt       DateTime? // when the CURRENT upstream digest was first observed
  imageCheckError              String? // closed code: auth|notfound|unsupported|timeout|failed. Never raw output.
  imageCheckFailures           Int                  @default(0) // consecutive failed probes (backoff)
  imageUpdateNotifiedDigest    String? // upstream digest last notified or silently seeded (notify-once dedupe)
  gitUrl                       String?
  gitBranch                    String?              @default("main")
  // Pin deploys to a specific commit SHA (must be reachable from gitBranch). Null = deploy the branch HEAD
  // (byte-identical shallow clone). When set, the clone fetches full branch history + checks out this SHA.
  gitCommit                    String?
  gitSubmodules                Boolean              @default(false)
  gitLfs                       Boolean              @default(false)
  gitShallowClone              Boolean              @default(true)
  disableBuildCache            Boolean              @default(false)
  injectEnvAsBuildArgs         Boolean              @default(false)
  sourceCommitMode             SourceCommitMode     @default(RUNTIME)
  buildType                    BuildType            @default(NIXPACKS)
  dockerfilePath               String?
  dockerBuildTarget            String? // DOCKERFILE build: multi-stage target stage (docker build --target)
  baseDirectory                String? // monorepo: repo-relative subdirectory used as the build context/root (GIT apps)
  // Watch paths: glob patterns (repo-relative, leading `!` = exclude). When non-empty, a git push only
  // triggers a deploy if a changed file matches — so a monorepo doesn't rebuild every app on every push.
  // Empty = deploy on every push (the default / backward-compatible behaviour).
  watchPaths                   String[]             @default([])
  // Per-app push-to-deploy switch. True (default) = a matching git push auto-deploys; false = the push is
  // acknowledged but ignored (pause auto-deploy without deleting the webhook). Preview deploys are separate.
  autoDeploy                   Boolean              @default(true)
  // Env var names dropped from a PR preview's copied env (so prod secrets never leak into an ephemeral
  // preview). Empty = the preview inherits the full parent env (unchanged default).
  previewExcludeKeys           String[]             @default([])
  // Max concurrent PR previews for this app; when a new PR would exceed it, the oldest preview is evicted.
  // Null = unlimited (the default).
  previewLimit                 Int?
  buildCommand                 String?
  outputDir                    String?
  // NIXPACKS build pack: first-class install/build/start command overrides → injected as NIXPACKS_INSTALL_CMD
  // / NIXPACKS_BUILD_CMD / NIXPACKS_START_CMD build env. Null = Nixpacks auto-detection (today's behaviour).
  nixpacksInstallCmd           String?
  nixpacksBuildCmd             String?
  nixpacksStartCmd             String?
  composeFile                  String?
  // COMPOSE-from-git: when set (with source=COMPOSE + gitUrl), the compose file lives in the cloned repo at
  // this repo-relative path instead of being pasted/stored in composeFile. The two are mutually exclusive;
  // composePath != null is the discriminator for a git-sourced compose stack.
  composePath                  String?
  // COMPOSE adopted in place from a project already running on the server: {v,project,workingDir,files[],...}. Deploys and
  // lifecycle commands then run `docker compose -p <project>` on those host files (never copied, never rewritten). Null = Tugra's own compose.
  composeAdopt                 Json?
  healthCmd                    String?
  healthCheckType              String? // null = auto | "NONE" | "HTTP" | "CMD" — deploy-gate health policy
  healthCheckPath              String? // HTTP check path (default "/")
  healthCheckPort              Int? // HTTP check port (default container/host port)
  healthCheckMethod            String? // HTTP check method (null/"GET" = GET); GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS
  healthCheckScheme            String? // HTTP check scheme (null/"http" = plain HTTP); "https" probes over TLS (curl -k, self-signed ok)
  healthCheckResponseText      String? // HTTP check: require this literal substring in the response body (null = status-only)
  // Tunable health-check timings (seconds; null = built-in default). Drive both the deploy health-gate and
  // the container's docker --health-* flags; startPeriod/retries widen the window for a slow-booting app.
  healthInterval               Int?
  healthTimeout                Int?
  healthRetries                Int?
  healthStartPeriod            Int?
  healthExpectedStatus         Int? // HTTP check: require this exact status (else any code < 500)
  memoryMb                     Int?
  cpus                         Float?
  reserveMemoryMb              Int? // soft swarm scheduling hint (--reserve-memory); swarm-only, advisory
  reserveCpus                  Float? // soft swarm scheduling hint (--reserve-cpu); swarm-only, advisory
  memorySwapMb                 Int? // docker --memory-swap (total memory+swap, MB); -1 = unlimited swap; needs memoryMb; classic apps only
  pidsLimit                    Int? // docker --pids-limit; -1 = unlimited; classic apps only
  shmSizeMb                    Int? // docker --shm-size (MB); classic apps only
  cpuShares                    Int? // docker --cpu-shares (relative weight); classic apps only
  cpusetCpus                   String? // docker --cpuset-cpus (e.g. "0-3" or "0,2"); classic apps only
  gpus                         String? // docker --gpus value (e.g. "all", "1", "device=0,1"); null = no GPU
  deployTimeoutSec             Int?
  preDeployCommand             String? // shell command run (in a one-shot container of the new image) before the swap — e.g. DB migrations
  postDeployCommand            String? // shell command run (inside the live container) after the health gate passes
  volumes                      Json?
  hostMounts                   Json? // [{hostPath, containerPath, readOnly}] — host directory bind-mounts (validated vs the sensitive-path denylist)
  portMappings                 Json? // [{serviceName, containerPort, hostPort, mode}] — install-time allocated host ports
  installConfig                Json? // redacted user field selections captured at template install (never secret values)
  configMounts                 Json? // [{serviceName, target, content, mode}] — template config files materialized + bound at deploy (${KEY} placeholders, never resolved secrets)
  composeNetworks              Json? // [{ network, service, aliases[] }] — hub-owned extra network attachments of a COMPOSE app's services (never user-compose), so sibling apps reach a service by a stable alias
  gitTokenEnc                  String?
  // SSH deploy key for cloning a private repo over git@/ssh:// — a generated ed25519 keypair. gitSshKeyEnc
  // is the encrypted OpenSSH private key (never returned); gitSshPublicKey is the public line the operator
  // adds to the repo as a read-only deploy key.
  gitSshKeyEnc                 String?
  gitSshPublicKey              String?
  gitSource                    GitSource?           @relation(fields: [gitSourceId], references: [id], onDelete: SetNull)
  gitSourceId                  String?
  registryAuthEnc              String?
  registry                     Registry?            @relation(fields: [registryId], references: [id], onDelete: SetNull)
  registryId                   String? // team registry to push the built image to (when pushToRegistry)
  pushToRegistry               Boolean              @default(false)
  pushImageName                String? // custom pushed repo path (relative to the registry namespace); null = tugra_<id>
  pushImageTag                 String? // mutable ALIAS tag template ({sha}/{branch}); null = no alias. The immutable :<deploymentId> tag is always pushed
  composeHookService           String? // COMPOSE only: the service the pre/post-deploy hook runs in
  inlineDockerfile             String? // DOCKERFILE build only: Dockerfile text written OUTSIDE the clone (never returned to non-writers)
  env                          Json
  envEnc                       String?
  /// AES-GCM(JSON {"v":1,"flags":{"KEY":{"buildTime":true,"runtime":false,"literal":true,"multiline":true}}}).
  /// Sparse: only non-default flags. null = no flags (every variable runtime, single-line, default interpolation).
  envMetaEnc                   String?
  buildArgsEnc                 String?
  // Build-time SECRETS (encrypted JSON): mounted into `docker build` as BuildKit secrets (`--secret id=K,src=…`,
  // read in the Dockerfile via `RUN --mount=type=secret,id=K`), so unlike build args they never enter image
  // layers / `docker history` / a pushed image. DOCKERFILE builds only.
  buildSecretsEnc              String?
  dockerOptions                String?
  // Host-root escalation gate. false (default) = assertSafeDockerOptions blocks --privileged/--device/
  // --cap-add/host-ns/docker.sock/host binds. true = the INSTANCE OWNER opted this app in (self-hosted, own
  // box). Settable ONLY by the instance owner over a session (never a PAT / apps:config member). The
  // Tugra-integrity flags (traefik.* labels, --name, --env-file) stay blocked regardless.
  allowPrivilegedDockerOptions Boolean              @default(false)
  // IMAGE/GIT classic (docker run) container command override, exec-form argv (string[]). Replaces the image
  // ENTRYPOINT / CMD. containerEntrypoint [] clears the image entrypoint; null on either = image default.
  containerEntrypoint          Json?
  containerCommand             Json?
  // Operator custom container labels (classic docker-run + swarm). {key: value}; never holds a reserved-namespace key. null = none.
  customLabels                 Json?
  dbNetwork                    Boolean              @default(false) // opt-in: also attach this app to the node-local managed-DB network (tugra-net) so it resolves tugra_db_<id> by name
  hostPort                     Int?
  containerPort                Int?                 @default(80)
  // Extra published ports beyond the ingress one: [{hostPort, containerPort, protocol: "tcp"|"udp"}].
  // Emitted as additional docker -p flags (classic apps). Null/empty = just the single ingress port.
  extraPorts                   Json?
  // Docker network aliases → extra `--network-alias` names on the app's user-defined network (tugra-proxy
  // when it has a domain, else tugra-net when db-linked), so OTHER containers resolve it by these names.
  // Empty = none. Reset (NOT copied) on clone/preview — a duplicate alias on the shared network collides.
  networkAliases               String[]             @default([])
  domain                       String?
  extraDomains                 String[]             @default([]) // additional hostnames (aliases) routed to the same container as `domain`
  domainRedirect               String?
  securityHeaders              Boolean              @default(false)
  gzip                         Boolean              @default(false) // enable a Traefik compress middleware on the routed app (gzip/brotli responses)
  forwardAuth                  String?
  // IP allowlist (CIDRs/addresses) → a Traefik ipallowlist middleware admitting only these source ranges.
  // Empty = open to all (the default). Applies on the next deploy.
  ipAllowlist                  String[]             @default([])
  // HTTP Basic Auth users as [{user, hash}] — hash is a Traefik-compatible bcrypt htpasswd hash (the
  // plaintext password is never stored). Null/empty = no basic auth. Applies on the next deploy.
  basicAuthUsers               Json?
  // Path-prefix routing: serve the app under <domain>/<pathPrefix> (Traefik PathPrefix). Null = host root.
  // stripPrefix (default true) removes the prefix before forwarding to the backend. Applies on next deploy.
  pathPrefix                   String?
  stripPrefix                  Boolean              @default(true)
  // Per-app rate limit {average, burst, period:'1s'|'1m'|'1h'} → a Traefik ratelimit middleware. Null = off.
  rateLimit                    Json?
  // Custom redirect rules [{regex, replacement, permanent}] → one Traefik redirectregex middleware each,
  // applied to the router (after the www/root canonical redirect, before security headers). Null/empty = none.
  redirects                    Json?
  // Docker restart policy for the app container: no | always | unless-stopped | on-failure. Null = the
  // "unless-stopped" default (byte-identical). A raw dockerOptions `--restart` still overrides it (emitted
  // after this flag; Docker last-wins). Classic docker-run apps only.
  restartPolicy                String?
  stopGracePeriodSec           Int? // graceful stop seconds 1..3600; null = Docker default (10s)
  drainSec                     Int? // ROLLING only: seconds both containers serve before the old is stopped, 0..300
  restartMaxRetries            Int? // 1..1000, only with restartPolicy "on-failure"
  containerAlias               String? // stable DNS label on every network the app joins; reset (NOT copied) on clone
  networks                     String[]             @default([]) // extra user Docker networks the app joins (created on deploy)
  https                        Boolean              @default(true)
  domainKind                   String               @default("none") // "none" | "magic" | "custom" — is the domain user-set or generated
  exposeMode                   String               @default("magic") // create preference: "magic" | "port" | "none" | "custom"
  tunnelExposed                Boolean              @default(false) // per-app opt-in: route this app's hostname through the server's Cloudflare Tunnel
  certType                     String               @default("http") // "http" | "none" | "le-http" | "le-dns" | "custom"
  // Operator-uploaded custom TLS cert (certType "custom"): Traefik serves it statically by SNI (no ACME).
  // certPem is the public chain; certKeyEnc is the encrypted private key; certDomains/certNotAfter are
  // parsed at upload for display. All null unless a custom cert was uploaded.
  certPem                      String?
  certKeyEnc                   String?
  certDomains                  String[]             @default([])
  certNotAfter                 DateTime?
  deployStrategy               String               @default("ROLLING") // "ROLLING" (zero-downtime) | "RECREATE"
  rollbackOnFailure            Boolean              @default(true) // auto-rollback to the previous version on a failed health gate
  imagesToKeep                 Int? // rollback images retained for keep-N pruning (1..20); null → DEFAULT_DEPLOY_IMAGE_KEEP (5)
  postCutoverSoakSec           Int                  @default(30) // ROLLING: seconds to keep the previous container after cutover and auto-revert on a sustained failure (new apps default to 30; 0 = off; existing rows were not backfilled)
  status                       AppStatus            @default(NEW)
  webhookToken                 String?              @unique
  webhookSecret                String?
  // Preview deployments (B6): a preview is a throwaway clone of a parent app
  // created per pull-request; the parent opts in via previewEnabled.
  isPreview                    Boolean              @default(false)
  previewEnabled               Boolean              @default(false)
  prNumber                     Int?
  // Preview provenance: which git host's event created this preview (null = legacy/GitHub-era row) and the head commit
  // it last built (display + dedupe of metadata-only "updated" events). Metadata only: never used to build, never in a shell.
  prProvider                   String? // github | gitlab | gitea | forgejo | bitbucket | bitbucket-server
  prHeadSha                    String? // lowercase hex 7..64, else null
  parentAppId                  String?
  tags                         String[]             @default([])
  // Volume backups (Dokploy parity): back up the app's named volumes to a destination.
  volumeBackupEnabled          Boolean              @default(false)
  volumeBackupIntervalHours    Int?
  volumeBackupRetention        Int                  @default(7)
  volumeBackupDestinationId    String?
  // Optional 5-field cron (wins over volumeBackupIntervalHours) + age / total-size (GiB) retention.
  volumeBackupCron             String?
  volumeBackupRetentionDays    Int?
  volumeBackupMaxSizeGb        Int?
  volumeBackups                VolumeBackup[]
  volumeBackupPolicies         VolumeBackupPolicy[]
  parent                       Application?         @relation("AppPreviews", fields: [parentAppId], references: [id], onDelete: Cascade)
  previews                     Application[]        @relation("AppPreviews")
  deployments                  Deployment[]
  scheduledTasks               ScheduledTask[]
  domains                      Domain[]
  cutoverDomains               CutoverDomain[]
  // Issue this custom domain's certificate with DNS-01 (per host, no wildcard) through the server's DNS-01 resolver.
  // A separate flag (not certType) so a later domain edit that resets certType to le-http never silently drops it.
  dnsChallenge                 Boolean              @default(false)
  serviceDomains               AppServiceDomain[]
  databaseLinks                AppDatabaseLink[]
  secretRefs                   SecretRef[]
  icon                         AppIcon?
  favicon                      AppFavicon?
  logDrains                    LogDrain[]
  createdAt                    DateTime             @default(now())

  @@unique([serverId, containerAlias])
  @@unique([registryId, pushImageName])
  @@index([environmentId])
  @@index([parentAppId])
}

// A per-app custom icon (user-uploaded PNG), stored inline in Postgres so it rides the normal DB backups —
// no object store or host volume to manage. One row per app (appId is the PK, Cascade so it dies with the
// app). The bytes are small (a square PNG, validated by signature/IHDR/IEND + 32-512px, capped at 64KB) but are
// deliberately kept out of the hot Application row; Application.iconUpdatedAt is the list-view marker so the
// app list never has to read these bytes.
model AppIcon {
  app       Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId     String      @id
  mime      String // always "image/png" (anything else is rejected at upload)
  data      Bytes
  sizeBytes Int
  updatedAt DateTime    @updatedAt
}

// Cached favicon of an app's own domain, fetched by the hub (never by the browser). One row per app;
// `data` is null when the site has none (negative cache). Refreshed after 7 days or when the domain changes.
model AppFavicon {
  app       Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId     String      @id
  domain    String // the host the icon was fetched for
  mime      String?
  data      Bytes?
  fetchedAt DateTime    @default(now())
}

// Attach a managed Database to an Application so its connection URI is auto-injected into the app's
// runtime env at deploy time (recomputed fresh each deploy). v1 is node-local (tugra-net) internal
// linking only — see src/applications/db-link.ts for eligibility. The databaseId FK is NoAction (not
// Cascade): deleting a database that still has links is refused (409) rather than silently breaking the
// app; a whole-team delete still cascades because NoAction is checked at end-of-statement.
model AppDatabaseLink {
  id         String      @id @default(cuid())
  app        Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId      String
  database   Database    @relation(fields: [databaseId], references: [id], onDelete: NoAction)
  databaseId String
  envVar     String // env var name the connection URI is injected under (e.g. DATABASE_URL)
  createdBy  String? // user id who created the link (audit convenience)
  createdAt  DateTime    @default(now())

  @@unique([appId, databaseId])
  @@unique([appId, envVar])
  @@index([databaseId])
}

// A team-scoped external secret-store credential (HashiCorp Vault in v1; Infisical/AWS-SM are future kinds
// that slot in as new clients with no model change). Mirrors DnsCredential: the access token is verified
// against the store BEFORE it is encrypted+persisted, is NEVER returned by any view/log, and management is
// gated by the `integrations` team permission. The deploy env resolver fetches referenced secrets through
// this credential at deploy time; the fetched VALUES are injected transiently and never persisted.
model SecretProvider {
  id             String      @id @default(cuid())
  team           Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId         String
  name           String
  kind           String // "vault" — only kind with a client in v1
  address        String // the store's base URL (non-secret), e.g. https://vault.example.com
  tokenEnc       String // CryptoService-encrypted access token — never returned/logged
  lastVerifiedAt DateTime?
  refs           SecretRef[]
  createdAt      DateTime    @default(now())

  @@index([teamId])
}

// A per-app binding: inject the value of an external secret (located by `remoteKey` in `provider`) into the
// app's runtime env under `envVar`, resolved FRESH at deploy time. Mirrors AppDatabaseLink. Only the LOCATOR
// is stored here, never the secret value. The providerId FK is NO ACTION (not Cascade): deleting a provider
// that still has refs is refused at the app layer (409) rather than silently breaking the app, while a
// whole-team delete still cascades (NO ACTION is checked at end-of-statement, after the app's refs die with
// the app). A ref whose value cannot be fetched FAILS the deploy loudly (never a silent empty value).
model SecretRef {
  id         String         @id @default(cuid())
  app        Application    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId      String
  provider   SecretProvider @relation(fields: [providerId], references: [id], onDelete: NoAction)
  providerId String
  envVar     String // env var name the fetched secret value is injected under
  remoteKey  String // provider-specific locator; Vault: "<mount>/<path>#<field>" e.g. "secret/myapp#DB_PASSWORD"
  createdBy  String? // user id who created the ref (audit convenience)
  createdAt  DateTime       @default(now())

  @@unique([appId, envVar])
  @@index([appId])
  @@index([providerId])
}

/**
 * A custom domain that Tugra set up DNS for on an app (one-click Cloudflare auto-setup). Tracks which provider
 * credential + zone were used and which records were written, so the UI can show status and a later change can
 * clean the records up when the domain changes or the app is deleted. `recordIds` is a JSON array of
 * { type, name, recordId }. `mode` is "auto" (Tugra created the records) or "manual" (operator copied them).
 */
// Per-service domain for a COMPOSE app: routes a named compose service (on a container port) to its own
// hostname via a dedicated Traefik router in the deploy override. Distinct from Domain (DNS automation).
model AppServiceDomain {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  service       String // the compose service name
  hostname      String      @unique // one app may claim a host; cross-app uniqueness enforced here
  port          Int // the service's container port to route to
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model Domain {
  id              String         @id @default(cuid())
  application     Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   String
  hostname        String // the custom domain, e.g. "app.example.com"
  apex            Boolean        @default(false) // hostname is the zone root (so a www CNAME applies)
  provider        String // "cloudflare"
  dnsCredential   DnsCredential? @relation(fields: [dnsCredentialId], references: [id], onDelete: SetNull)
  dnsCredentialId String? // the DnsCredential used (SetNull: deleting the credential keeps the history)
  zoneId          String? // provider zone the records live in
  recordIds       Json? // [{ type, name, recordId }] — what was written, for cleanup
  mode            String         @default("auto") // "auto" | "manual"
  status          String         @default("pending") // "pending" | "active" | "error"
  lastError       String?
  lastCheckedAt   DateTime?
  createdAt       DateTime       @default(now())

  @@unique([applicationId, hostname])
  @@index([applicationId])
  @@index([dnsCredentialId])
}

model ScheduledTask {
  id          String             @id @default(cuid())
  application Application        @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId       String
  name        String
  schedule    String
  command     String
  enabled     Boolean            @default(true)
  timeoutSec  Int? // per-run timeout (seconds); null = the built-in default (300s). Long jobs raise it.
  lastRunAt   DateTime?
  createdAt   DateTime           @default(now())
  runs        ScheduledTaskRun[]

  @@index([appId])
}

// One execution of a scheduled task (cron or manual run-now), for the history view. `output` can carry the
// app's secrets (an arbitrary command's stdout), so it is only ever served behind read:secrets + a writer.
// Pruned to the last N per task by the runner; status is a plain string ("RUNNING" | "SUCCESS" | "FAILED").
model ScheduledTaskRun {
  id         String        @id @default(cuid())
  task       ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  status     String        @default("RUNNING") // RUNNING | SUCCESS | FAILED
  trigger    String // "schedule" | "manual"
  exitCode   Int? // null when the command never ran (transport failure)
  output     String? // tail-capped; may contain secrets → never shipped to notifications
  error      String? // transport/timeout message when the command never ran
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  durationMs Int?

  @@index([taskId, startedAt])
}

model Deployment {
  id             String           @id @default(cuid())
  application    Application      @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId          String
  status         DeploymentStatus @default(RUNNING)
  kind           String           @default("DEPLOY") // "DEPLOY" | "ROLLBACK" | "AUTO_ROLLBACK"
  logs           String?
  exitCode       Int?
  imageTag       String?
  registryImage  String? // registry ref this deploy pushed to (for portable rollback pull)
  imageDigest    String? // resolved upstream digest of the pulled IMAGE (nginx@sha256:…) — provenance + byte-exact rollback
  // Redacted config snapshot this deploy ran with (secrets fingerprinted, not stored).
  configSnapshot Json?
  durationMs     Int? // wall-clock ms from start (startedAt) to terminal status; null for legacy/queued/running rows
  runServerId    String? // server this deploy ran on; NULL = "the app's current server" (every legacy row). Stamped by an app move's cutover.
  trigger        String? // what initiated this run: "manual" | "webhook" | "preview" | "rollback" | "move"; null for legacy rows
  noCache        Boolean          @default(false) // queued deploys carry their --no-cache choice until they start
  requestedBy    String? // actor that enqueued this deploy (userId | "webhook" | "webhook:pr"); drives trigger + audit
  startedAt      DateTime? // when the row moved QUEUED -> RUNNING; null while queued (durationMs measures from here)
  commitSha      String? // deployed git commit (GIT source only); null otherwise
  commitMessage  String? // first line of the deployed commit's message (GIT source only), capped + sanitized
  idempotencyKey String? // raw client Idempotency-Key for durable at-most-once ENQUEUE; NULL = no client key (unconstrained)
  // ── Deploy lease (hub-crash recovery). All NULL for a legacy row, a swarm/build-server/rollback path, or an old
  // agent without cmd_journal_v1 — those keep the boot-time "reap RUNNING → FAILED" behaviour.
  ownerId        String? // hub process (bootId) currently driving this RUNNING row; NULL = released, awaiting adoption
  heartbeatAt    DateTime? // last owner heartbeat (10s) — multi-hub expiry signal (not used for decisions on a single hub)
  phase          String? // "CLAIMED" (pre-dispatch) | "PREPARING" (swarm only: build/inspect running, nothing live touched yet — a hub restart safely re-queues it) | "DISPATCHED" (main deploy command on the agent) | "RECOVERING" (owner lost; adopt on reconnect)
  agentReqId     String? // reqId of the durable main deploy command (= what the agent journaled); set only for cmd_journal_v1 agents
  agentServerId  String? // server the command was sent to (adoption is gated on THAT agent reconnecting)
  deadlineAt     DateTime? // dispatch + agent timeout + soak + slack: past it an unrecovered row settles as interrupted
  dispatchPlan   Json? // frozen outcome plan at dispatch (strategy, prev-image existence, tags) so adoption judges the EXACT command sent
  createdAt      DateTime         @default(now())

  // NOTE: a partial unique index `deployment_one_running_per_app ON Deployment(appId) WHERE status='RUNNING'`
  // enforces one RUNNING deploy per app at the DB level (Prisma can't model partial indexes — see the
  // 20261030170000_deploy_queue migration). It is the backstop for the queue's SELECT ... FOR UPDATE claim.
  //
  // Durable at-most-once ENQUEUE backstop that survives a Redis flush / hub crash — complements the in-flight
  // IdempotencyInterceptor (see its docstring in common/idempotency.interceptor.ts). Scoped by appId so one
  // literal key reused across two apps never collides. NULLABLE + Postgres default NULLS DISTINCT means every
  // keyless (appId, NULL) tuple is distinct, so the no-key path stays unconstrained (many keyless deploys/app).
  @@unique([appId, idempotencyKey])
  @@index([appId])
  @@index([appId, status])
  @@index([status, phase])
  @@index([agentServerId])
}

model Database {
  id                      String            @id @default(cuid())
  team                    Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId                  String
  environment             Environment       @relation(fields: [environmentId], references: [id], onDelete: NoAction)
  environmentId           String
  serverId                String
  name                    String
  engine                  DbEngine
  version                 String
  image                   String
  port                    Int
  hostPort                Int?
  credentials             String
  // Encrypted JSON of user-set container env vars ({ KEY: "value" }), injected at provision BEFORE the
  // engine's credential env so a user var can never shadow the managed credentials. Null = none.
  envEnc                  String?
  // Encrypted text of the engine's custom config file (Redis: redis.conf), written to the host and bind-mounted read-only into the
  // container at provision (it can hold secrets such as masterauth). Null = the engine's defaults. Redis only.
  configFileEnc           String?
  // Extra persistent volumes beyond the managed data volume: JSON [{ name, path }]. The real docker volume
  // name is derived per-database (tugra_dbv_<id>_<name>). Not secret, so stored plain. Null = none.
  volumes                 Json?
  status                  DbStatus          @default(NEW)
  iconUpdatedAt           DateTime? // list-view marker so the database list never reads the icon bytes
  iconKey                 String? // picked brand icon from the shared set (null = automatic)
  icon                    DatabaseIcon?
  healthCmd               String?
  memoryMb                Int?
  cpus                    Float?
  backupEnabled           Boolean           @default(false)
  backupIntervalHours     Int?
  // Optional 5-field cron (e.g. "0 3 * * *" = 03:00 daily); when set it drives the schedule and overrides
  // backupIntervalHours — so "daily at 03:00" instead of "every 24h from whenever".
  backupCron              String?
  backupRetention         Int               @default(7)
  // Optional age-based retention: also delete SUCCESS backups older than N days (alongside the keep-N count).
  backupRetentionDays     Int?
  // Optional total-size retention (GiB) over this database's SUCCESS logical backups; oldest go first, the newest is kept.
  backupMaxSizeGb         Int?
  backupDestinationId     String?
  // Scheduled restore-verify drill (prove a backup actually RESTORES). Independent of the backup schedule:
  // each run provisions a disposable DB, restores the latest SUCCESS backup into it, then tears it down.
  verifyEnabled           Boolean           @default(false)
  verifyIntervalHours     Int?
  // Optional 5-field cron; when set it drives the verify schedule and overrides verifyIntervalHours.
  verifyCron              String?
  // Last time a scheduled OR on-demand verify SUCCEEDED — powers the UI "last verified" line and the
  // verify-liveness watchdog's reference point.
  lastVerifiedAt          DateTime?
  // Scheduled PHYSICAL base backups (pg_basebackup) — the anchors a point-in-time restore replays WAL onto.
  // Independent of the logical schedule; a cron overrides the hours interval. Postgres-only.
  baseBackupEnabled       Boolean           @default(false)
  baseBackupIntervalHours Int?
  baseBackupCron          String?
  // PITR (Postgres only): when on, the container is (re)created with WAL archiving so point-in-time recovery
  // is possible. Additive + default-off — an existing/throwaway DB is untouched and its run script is
  // byte-identical. The enable/disable flow (recreate + verify) and the WAL shipper land in the next slice;
  // this column is the inert anchor those build on. pitrEnabledAt stamps when it was switched on.
  pitrEnabled             Boolean           @default(false)
  pitrEnabledAt           DateTime?
  // TLS (Postgres only): when on, the container serves TLS with a self-signed certificate kept in its own volume, so an
  // app whose connection URL says sslmode=require connects. Default-off: the run script of an existing DB is byte-identical.
  ssl                     Boolean           @default(false)
  // PostgreSQL 18+ keeps PGDATA under /var/lib/postgresql/<major>/docker and declares that parent as its VOLUME, so the managed data volume
  // must be mounted there. True for a database created with that mount; false = the original /var/lib/postgresql/data mount (every
  // pre-18 database, and a PG 18+ one created before the fix, whose cluster sits in an anonymous volume: see pgDataLayout).
  pgParentMount           Boolean           @default(false)
  tags                    String[]          @default([])
  backups                 Backup[]
  baseBackups             BaseBackup[]
  restores                Restore[]
  appLinks                AppDatabaseLink[]
  createdAt               DateTime          @default(now())

  @@index([teamId])
  @@index([environmentId])
}

model BackupDestination {
  id                String   @id @default(cuid())
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String
  name              String
  type              DestType @default(S3)
  s3Bucket          String?
  s3Region          String?
  s3Endpoint        String?
  s3AccessKey       String?
  s3SecretKey       String?
  s3Prefix          String?
  encryptionEnabled Boolean  @default(false)
  encryptionKey     String?
  createdAt         DateTime @default(now())

  @@index([teamId])
}

enum RestoreKind {
  RESTORE
  RESTORE_TO
  IMPORT_URL
  VERIFY
  PITR
}

enum RestoreStatus {
  RUNNING
  SUCCESS
  FAILED
}

// A restore attempt + its outcome (so a failed restore is recorded, surfaced,
// and alerted on — not silently reported as success).
model Restore {
  id               String        @id @default(cuid())
  database         Database      @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  databaseId       String // the database restored INTO
  backupId         String? // source backup (may be deleted later → no FK)
  sourceDatabaseId String? // source DB for a cross-resource restore-to
  // PITR replay (kind PITR): the row is homed on the SOURCE (so a failed target's reap never cascades the
  // evidence away) and points at the NEW database it produced, the moment restored to, and the base used.
  targetDatabaseId String?
  targetTime       DateTime?
  baseBackupId     String?
  kind             RestoreKind
  status           RestoreStatus @default(RUNNING)
  exitCode         Int?
  errorTail        String? // last ~2KB of output; writer-only exposure
  createdBy        String
  createdAt        DateTime      @default(now())
  completedAt      DateTime?

  @@index([databaseId, createdAt])
}

// A PHYSICAL base backup (pg_basebackup) — the base image for WAL/PITR restore. A SIBLING of Backup, not a
// kind of it: every Backup consumer (prune/verify/watchdog/list/restore) is kind-blind, so a separate table
// keeps the logical path byte-identical and makes a mis-selection (a tar fed to pg_restore) impossible.
// Postgres-only. Retention is count-only in 5.3 (each -X fetch base is standalone); 5.4 makes it WAL-aware.
model BaseBackup {
  id            String       @id @default(cuid())
  database      Database     @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  databaseId    String
  status        BackupStatus @default(PENDING)
  filename      String
  path          String
  destinationId String?
  objectKey     String?
  sizeBytes     BigInt?
  // Physical-base anchor metadata for the WAL/PITR slices. pgVersion is a snapshot of Database.version (a
  // physical base restores only into the same major); startLsn/timeline come from pg_basebackup -v and are
  // nullable — a parse miss never fails the backup (backup_label inside the tar is authoritative).
  pgVersion     String?
  startLsn      String?
  timeline      Int?
  createdBy     String
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  exitCode      Int?
  errorTail     String?
  durationMs    Int?

  // A partial UNIQUE index (one RUNNING per database) also exists — created in the migration, since Prisma
  // has no partial-index support. It atomically backstops the runner's inflight guard against a create race.
  @@index([databaseId, createdAt])
}

model Backup {
  id            String       @id @default(cuid())
  database      Database     @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  databaseId    String
  status        BackupStatus @default(PENDING)
  filename      String
  path          String
  destinationId String?
  objectKey     String?
  sizeBytes     BigInt?
  createdBy     String
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  // Run outcome (mirrors Restore): a FAILED row records WHY. errorTail is scrubbed + writer-only exposure.
  exitCode      Int?
  errorTail     String?
  durationMs    Int?

  @@index([databaseId])
}

// Scheduled backup of the HUB's OWN Postgres (control-plane DB). Singleton (fixed PK), off by default.
// destinationId is a soft ref to BackupDestination (null => LOCAL /etc/tugra/backups/hub); no FK, like
// Database.backupDestinationId. Kept out of InstanceSettings (already a grab-bag) for an isolated migration.
model HubBackupConfig {
  id            String   @id @default("singleton")
  enabled       Boolean  @default(false)
  intervalHours Int      @default(24)
  retention     Int      @default(7)
  destinationId String?
  // Optional 5-field cron (wins over intervalHours) + age / total-size (GiB) retention. All nullable.
  cron          String?
  retentionDays Int?
  maxSizeGb     Int?
  // Optional third copy: every run also writes to this destination (null = none). Soft ref like destinationId.
  extraDestinationId String?
  // Monthly restore drill into a throwaway container (on unless switched off).
  drillEnabled  Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

// One restore drill of the hub's own backup: the latest dump is restored into a throwaway Postgres container and
// checked. History is bounded (the runner keeps the newest 24).
model HubBackupDrill {
  id             String    @id @default(cuid())
  status         String // RUNNING | SUCCESS | FAILED
  trigger        String // schedule | manual
  backupId       String? // soft ref to HubBackup
  backupFilename String?
  tables         Int?
  checks         Json? // { table: rowCount } of the sanity tables
  errorTail      String?
  durationMs     Int?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([createdAt])
}

// Dead-man check-in of the hub: pings an external URL on an interval so a monitor outside the hub can alert when the
// pings stop. The URL is a secret (push-monitor URLs carry a token), encrypted at rest.
model HubDeadmanConfig {
  id              String    @id @default("singleton")
  enabled         Boolean   @default(false)
  urlEnc          String?
  intervalMinutes Int       @default(5)
  lastTickAt      DateTime? // last time the scheduler ran (a gap on boot = the hub was down)
  lastPingAt      DateTime?
  lastOkAt        DateTime?
  lastError       String?
  failStreak      Int       @default(0)
  alertedAt       DateTime? // an outage alert was sent for the current streak
  updatedAt       DateTime  @updatedAt
}

// The latest verification reports of a migration run (source vs target), kept as secret-free JSON. Soft run ref.
model MigrationVerification {
  id        String   @id @default(cuid())
  runId     String
  teamId    String
  state     String // match | differences | incomplete
  report    Json
  createdBy String
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

// Safety copy of a migration run's data, taken on the target once the final copy has landed and kept 7 days.
// Soft refs (no FK), like MigrationRun. `items` holds the Backup / VolumeBackup rows the capture created (ids only).
model MigrationSnapshot {
  id            String    @id @default(cuid())
  runId         String    @unique
  teamId        String
  destinationId String? // null = the target server's local disk
  status        String    @default("PLANNED") // PLANNED | CAPTURING | SUCCESS | PARTIAL | FAILED | EXPIRED | SKIPPED
  items         Json      @default("[]") // [{ kind: "database"|"volume", ref, name, rowId, status, sizeBytes, error }]
  note          String?
  expiresAt     DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  capturedAt    DateTime?
  restoredAt    DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([teamId])
  @@index([status, expiresAt])
}

// Per-volume backup policy: overrides the app's volume-backup schedule/retention for ONE named volume.
// Null fields inherit the app's values. A row with its own schedule (or enabled=false) is "carved out" of the
// app-wide job. Cascade-deleted with the app.
model VolumeBackupPolicy {
  id            String      @id @default(cuid())
  appId         String
  app           Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  volumeName    String
  enabled       Boolean     @default(true)
  intervalHours Int?
  cron          String?
  retention     Int?
  retentionDays Int?
  maxSizeGb     Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([appId, volumeName])
  @@index([appId])
}

// Hub-backup run history. Mirrors Backup minus the database FK; reuses BackupStatus. errorTail is
// scrubRestoreOutput()'d (never raw tenant data). Rows live inside the DB they describe — the runner's
// stale-RUNNING reaper fixes rows that a restore brings back mid-flight.
model HubBackup {
  id            String       @id @default(cuid())
  status        BackupStatus @default(PENDING)
  filename      String
  path          String
  destinationId String?
  objectKey     String?
  sizeBytes     BigInt?
  errorTail     String?
  createdBy     String
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([createdAt])
}

// The last-good SIGNED remote template catalog (single row, fixed PK). Persisted only AFTER the
// ed25519 signature + shape validation pass, so it is a durable trusted snapshot for boot/offline.
// The bundled catalog is always the base; this overlays it. See src/catalog/.
model CatalogSnapshot {
  id                  String   @id @default("singleton")
  version             String
  sourceUrl           String
  payload             Json // the verified { version, templates } blob
  templateCount       Int
  etag                String?
  signatureVerifiedAt DateTime
  fetchedAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Instance-level settings (single row, fixed PK) — the source of truth for onboarding state,
// registration gating, edition, self-update and API gating. Consumed by later features; created on
// first access via InstanceSettingsService (get-or-create).
model InstanceSettings {
  id                  String    @id @default("singleton")
  initializedAt       DateTime? // set when the first user registers (bootstrap complete)
  allowRegistration   Boolean   @default(false) // closed after the first user; owner re-opens or invites
  edition             String    @default("community") // community | pro | cloud
  publicUrl           String?
  acmeEmail           String?
  // Panel-TLS (DİLİM 1): the control panel's own HTTPS hostname (opt-in). When set (install.sh --auto-tls
  // or env PANEL_DOMAIN), the hub provisions a Traefik file-provider router for the panel. env PANEL_TLS=1 +
  // PANEL_DOMAIN win over this (synced to DB at bootstrap). Null = bring-your-own-proxy (unchanged).
  panelDomain         String?
  // IP-mode transport (http://<ip>/ install): the self-signed leaf certificate the proxy serves on :443 for the host-less
  // routes, generated once and persisted so its fingerprint (the agent pin) never changes. PEM + encrypted PEM key.
  ipTlsCertPem        String?
  ipTlsKeyEnc         String?
  // Fingerprint (sha256:<hex>) of the certificate the LOCAL proxy was last successfully configured to serve; the agent
  // install command only switches to wss://<ip> once this equals the persisted certificate (a path that is really up).
  ipTlsServedFp       String?
  // Agent address grace after the panel address moved: the old hosts / the IP route stay routable for `/agent` until every
  // agent reports the new endpoint, the owner confirms, or `expiresAt`. Shape: AgentEndpointGrace (agent-endpoints/grace.ts).
  agentEndpointGrace  Json?
  // On for new installs: the hub applies patch-level updates and rolls agents out one by one. Existing rows keep
  // the owner's choice (the migration only changes the column default).
  autoUpdate          Boolean   @default(true)
  // Release channel to track. "auto" (the default) = automatic: a prerelease build (0.1.0-beta.N) tracks "beta",
  // a release build tracks "stable" (see @tugra/shared autoUpdateChannel); "stable" / "beta" are explicit owner
  // pins. A sentinel rather than NULL so the PREVIOUS hub image (required-string client) can still read the row
  // after a rollback of the upgrade that introduced it.
  updateChannel       String    @default("auto")
  cachedLatestVersion String?
  // The channel `cachedLatestVersion` was read from; a cache from another channel is ignored after a pin change.
  cachedLatestChannel String?
  cachedNotice        Json? // signed top-level operator notice from the update manifest, or null
  // Last SUCCESSFUL signed manifest check (set even when the tracked channel has no entry — the check itself
  // worked). Drives "Last checked" in the Updates card and the panel-load stale refresh.
  updateLastCheckedAt DateTime?
  // Machine reason of the most recent FAILED attempt (fetch / bad signature / settings / persist …); NULL when
  // the most recent attempt succeeded. Owner-visible so "why no update?" has an answer.
  updateLastCheckError String?
  apiEnabled          Boolean   @default(true)
  apiAllowedIps       String[]  @default([])
  // Owner-set policy: owners/admins must have two-factor authentication on. Enforced by TwoFactorRequiredGuard
  // (a user without 2FA is limited to the account self-service routes until they enrol).
  require2faForAdmins Boolean   @default(false)
  // OIDC single sign-on (Pro edition). Owner-configured IdP; the client secret is stored encrypted
  // (CryptoService) and never surfaced in any view. Empty allowedDomains = no JIT domain restriction.
  oidcEnabled         Boolean   @default(false)
  oidcIssuer          String?
  oidcClientId        String?
  oidcClientSecretEnc String? // libsodium-encrypted; decrypted only at token exchange
  oidcAllowedDomains  String[]  @default([]) // JIT provisioning is limited to these email domains when non-empty
  // A signed license (EdDSA JWT, issued by Tugra's proprietary billing service) that unlocks the Pro/Cloud
  // edition. Safe to store: it is signature-protected, so a DB write can't forge an entitlement — the hub
  // verifies it against TUGRA_LICENSE_PUBLISHER_KEY on every load. Null = no license (env/community edition).
  licenseToken        String?
  // Anonymous usage stats (ON by default, opt-out). `telemetryEnabled` is the owner-UI off-switch; the
  // env var TUGRA_STATS=0 (legacy name TUGRA_TELEMETRY=0) is a deployment-level HARD off that overrides it
  // (install --no-stats / headless CI). The hub identity is an ed25519 key pair generated once: the public
  // key (raw 32 bytes, base64url) and the libsodium-encrypted private key (PKCS8 PEM). hubId = first 32 hex
  // chars of sha256(public key) — the ONLY identifier ever sent; no IP, hostname, domain, email, app name or
  // user data leaves the box. `telemetryLastSentAt` is the last successful send (drives the UI + avoids
  // double-sends).
  telemetryEnabled    Boolean   @default(true)
  hubPublicKey        String?
  hubPrivateKeyEnc    String?
  telemetryLastSentAt DateTime?
  // Web Push (VAPID, RFC 8292): the hub's P-256 application-server key pair, generated once on first use. The public key
  // (uncompressed point, base64url) is handed to browsers as applicationServerKey; the private key (PKCS8 PEM) is encrypted.
  vapidPublicKey      String?
  vapidPrivateKeyEnc  String?
  // White-label (Pro edition). Owner-set branding that replaces the Tugra name/logo/favicon/accent and can
  // hide the "Powered by Tugra" footer. Read publicly (the login page themes before auth) BUT only applied
  // while the instance is Pro+ — a Community or lapsed-license instance always shows the Tugra defaults, so
  // these can't become a free rebrand. URLs are http(s), accent is a #rrggbb hex (validated in the DTO).
  brandName           String?
  brandLogoUrl        String?
  brandFaviconUrl     String?
  brandAccentColor    String?
  brandHidePoweredBy  Boolean   @default(false)
  // Outbound mail (in-panel Email settings). mailProvider: "none" (default → fall back to the MAIL_* env) |
  // "smtp" | "resend". The SMTP password and the Resend API key are stored ENCRYPTED (CryptoService) and are
  // never surfaced in any view — write-only. Resend is a preset SMTP transport (smtp.resend.com:465) so it
  // needs only the key + from. When the provider is "none" the env config (MAIL_*) is used unchanged.
  mailProvider        String    @default("none")
  mailHost            String?
  mailPort            Int?
  mailSecure          Boolean   @default(false)
  mailUser            String?
  mailPassEnc         String? // libsodium-encrypted SMTP password
  mailFrom            String?
  mailResendKeyEnc    String? // libsodium-encrypted Resend API key
  updatedAt           DateTime  @updatedAt
}

// ── Fleet rollouts (canary → waves → health gate → halt/resume) ─────────────────────────────────────────────
// A Rollout redeploys a SET of apps in ordered waves, each wave gated on the per-app deploy outcome (the
// existing health gate + post-cutover soak decide per app; the engine only reads the Deployment row). It is a
// durable state machine driven by a stateless periodic tick, so it survives a hub restart without resuming a
// build mid-flight (an interrupted deploy halts the rollout; the operator resumes). One LIVE rollout per app.

enum RolloutStatus {
  RUNNING
  HALTED // waiting for the operator: resume (retry the wave's failures) or cancel
  ROLLING_BACK // fleet rollback in progress (targets REVERTING)
  COMPLETED
  ROLLED_BACK // every reverted target restored its baseline
  ROLLBACK_FAILED // a revert failed, was refused, timed out or had no baseline
  CANCELLED
}

enum RolloutTargetStatus {
  PENDING
  DEPLOYING
  SUCCEEDED
  FAILED
  CANCELLED
  SKIPPED
  REVERTING // fleet rollback: revert pending or dispatched
  ROLLED_BACK // reverted to the baseline
  ROLLBACK_FAILED // revert failed (outcome carries why: no_baseline / busy_timeout / revert_<verdict> / …)
}

model Rollout {
  id            String          @id @default(cuid())
  team          Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  createdBy     String // the initiator; every dispatch re-checks their access (a demoted initiator halts the rollout)
  name          String?
  kind          String          @default("app_deploy") // what a target is ("app_deploy" today; agent-update/os-patch later)
  status        RolloutStatus   @default(RUNNING)
  haltReason    String? // manual | wave_failed | wave_no_signal | bake_failed | interrupted | initiator_lost
  haltDetail    Json? // secret-free detail for the halt (target ids, counts)
  config        Json // the RolloutConfig frozen at create
  currentWave   Int             @default(0)
  waveCount     Int
  waveStartedAt DateTime        @default(now()) // when the current wave became current (offline wait reference)
  bakeUntil     DateTime? // the current wave passed; observing until this instant before promoting
  createdAt     DateTime        @default(now())
  finishedAt    DateTime?
  updatedAt     DateTime        @updatedAt
  targets       RolloutTarget[]

  @@index([teamId, createdAt])
  @@index([status])
}

model RolloutTarget {
  id                   String              @id @default(cuid())
  rollout              Rollout             @relation(fields: [rolloutId], references: [id], onDelete: Cascade)
  rolloutId            String
  wave                 Int
  position             Int
  kind                 String              @default("app_deploy")
  resourceId           String // the Application id (loose FK: an app deleted mid-rollout is SKIPPED, not cascaded)
  serverId             String // denormalised for the online check
  label                String // name snapshot
  status               RolloutTargetStatus @default(PENDING)
  attempt              Int                 @default(0)
  baselineDeploymentId String? // the last rollbackable SUCCESS deploy before this rollout touched the app
  deploymentId         String? // the Deployment this rollout dispatched (attempt N)
  rollbackDeploymentId String? // the ROLLBACK Deployment a fleet rollback dispatched for this target
  rollbackAttempt      Int                 @default(0) // fleet-rollback dispatch attempts (0 = not yet dispatched)
  outcome              String? // passed | rejected_safe | failed | interrupted | cancelled | halted | offline | app_gone | …
  detail               String?
  active               Boolean             @default(true) // true while the rollout is live → one live rollout per app
  dispatchedAt         DateTime?
  finishedAt           DateTime?

  // NOTE: a partial unique index `rollout_target_one_active_per_resource ON RolloutTarget(kind, resourceId)
  // WHERE active` (20261115100000_rollouts migration) enforces one LIVE rollout per app at the DB level;
  // Prisma can't model partial indexes, so a future `migrate diff` must not drop it.
  @@unique([rolloutId, resourceId])
  @@index([rolloutId, wave])
}

// Envelope keyring for the secrets-at-rest encryption: random data keys (DK) stored ONLY wrapped (secretbox) under the
// .env root key(s), so the database alone never holds a usable key. A DK's id (16-hex fingerprint) is the key id carried
// in every `tk1.<keyId>.` ciphertext. Zero rows = the ring is just the .env keys (today's behaviour).
enum SecretsKeyState {
  ACTIVE
  DECRYPT_ONLY
  RETIRED
}

model SecretsKey {
  id          String           @id // 16-hex fingerprint of the DK == the key id in ciphertexts
  state       SecretsKeyState  @default(ACTIVE)
  createdBy   String? // userId, plain string
  createdAt   DateTime         @default(now())
  activatedAt DateTime         @default(now())
  demotedAt   DateTime?
  retiredAt   DateTime?
  wraps       SecretsKeyWrap[]
}

model SecretsKeyWrap {
  keyId     String
  rootKeyId String // fingerprint of the .env root key that wrapped it
  wrapped   String // tk1.<rootKeyId>.<b64 secretbox of base64(DK bytes)>; deliberately NOT named *Enc (never re-encrypted under a DK)
  createdAt DateTime   @default(now())
  key       SecretsKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([keyId, rootKeyId])
}

// Singleton; updating it takes the row lock that serialises every keyring mutation (and bumps `epoch` so other
// processes notice).
model SecretsKeyring {
  id        String   @id @default("singleton")
  epoch     Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum AppMovePhase {
  QUEUED
  PRECHECK
  STOPPING_SOURCE
  TRANSFERRING
  DEPLOYING // cutover tx committed; target deploy in flight (roll-forward zone)
  FINALIZING
  COMPLETED
  ROLLING_BACK
  ROLLED_BACK
  FAILED // rollback itself failed -> needs attention
}

/// A persisted "move this app to another server" job. The app keeps its id; only Application.serverId flips (inside the cutover tx).
model AppMove {
  id              String        @id @default(cuid())
  appId           String // LOOSE ref, NO FK/cascade (like RolloutTarget.resourceId): archive purge + audit survive app deletion
  appName         String // snapshot
  teamId          String
  requestedBy     String
  sourceServerId  String // loose strings like Application.serverId
  targetServerId  String
  phase           AppMovePhase  @default(QUEUED)
  prevStatus      AppStatus // app.status at claim time
  plan            Json // frozen preflight result (no secret values, no env values)
  acks            Json          @default("{}")
  repointDns      Boolean       @default(false)
  retainDays      Int           @default(7) // 0 = purge source volumes right after COMPLETED
  volumes         Json          @default("[]") // [{name,dockerName,kind:"app"|"compose",sizeBytes,state,parts,partsDone,bytesDone,entries,createdOnTarget,archiveOverwritten}]
  snapshotBefore  Json? // pre-image of every Application column the cutover changes (+ logDrain ids); NEVER env*/cert key columns
  deploymentId    String?
  warnings        Json          @default("[]")
  failureReason   String? // stable machine code (i18n suffix)
  failurePhase    AppMovePhase?
  logTail         String? // scrubbed, <= 16 KiB, writer-only
  cancelRequested Boolean       @default(false)
  ownerId         String? // hub bootId driving the job (DeployLeaseService.bootId); NULL = awaiting recovery
  heartbeatAt     DateTime?
  deadlineAt      DateTime?
  startedAt       DateTime?
  cutoverAt       DateTime?
  finishedAt      DateTime?
  archiveUntil    DateTime?
  sourcePurgedAt  DateTime? // source archive volumes removed (or consumed by a move-back)
  targetPurgedAt  DateTime? // target leftovers of a rolled-back/failed move removed
  createdAt       DateTime      @default(now())

  // NOTE: a partial unique index "AppMove_one_active_per_app" ON AppMove(appId) WHERE phase NOT IN
  // ('COMPLETED','ROLLED_BACK','FAILED') (20261119110000_app_move migration) is the DB backstop for "one live move
  // per app"; Prisma cannot model partial indexes (same precedent as deployment_one_running_per_app), so a future
  // `migrate diff` must not drop it.
  @@index([appId, createdAt(sort: Desc)])
  @@index([phase])
  @@index([sourceServerId])
  @@index([targetServerId])
}

/// S3->S3 bucket mirror run by the TARGET server's agent (mc mirror in a detached helper container). Credentials are
/// encrypted (CryptoService) and appear in NO view, audit row or log. No object keys are stored: only counts, fixed codes
/// and a classified error.
model ObjectMigration {
  id                String                  @id @default(cuid())
  team              Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String
  createdById       String
  name              String
  targetServerId    String
  status            String                  @default("DRAFT") // DRAFT|PREFLIGHTED|SEEDING|SEEDED|FINALIZING|FINAL|VERIFYING|DONE|FAILED
  phase             String? // seed|final while helpers are live
  srcEndpoint       String // scheme://host[:port]
  srcAccessKeyEnc   String
  srcSecretKeyEnc   String
  dstEndpoint       String
  dstAccessKeyEnc   String
  dstSecretKeyEnc   String
  preserve          Boolean                 @default(true) // mc mirror --preserve
  removeExtraneous  Boolean                 @default(false) // final pass --remove (explicit ack)
  mergeIntoExisting Boolean                 @default(false) // explicit ack when a destination bucket already has objects
  cancelRequested   Boolean                 @default(false)
  warnings          Json? // [{code, level, bucket?}] fixed codes, secret-free
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  finishedAt        DateTime?
  buckets           ObjectMigrationBucket[]

  @@index([teamId, createdAt])
  @@index([targetServerId, status])
}

model ObjectMigrationBucket {
  id           String          @id @default(cuid())
  migration    ObjectMigration @relation(fields: [migrationId], references: [id], onDelete: Cascade)
  migrationId  String
  idx          Int
  srcBucket    String
  dstBucket    String
  exclude      String[]        @default([]) // mc --exclude globs (charset-validated)
  selected     Boolean         @default(false) // nothing is pre-selected
  status       String          @default("PENDING") // PENDING|QUEUED|SEEDING|SEEDED|FINALIZING|FINAL|VERIFIED|DIFFERS|FAILED
  srcObjects   BigInt?
  srcBytes     BigInt?
  dstObjects   BigInt?
  dstBytes     BigInt?
  doneObjects  BigInt?
  doneBytes    BigInt?
  diffMissing  Int?
  diffDiffer   Int?
  diffExtra    Int?
  versioning   String? // informational; versions are NOT carried
  config       Json? // exported anonymous policy / ilm / tags, each <=64 KiB, secret-free
  configStatus String? // NONE|EXPORTED|APPLIED|FAILED
  lastError    String? // fixed classification code, <=1 KiB, never creds, never object keys
  startedAt    DateTime?
  finishedAt   DateTime?

  @@unique([migrationId, srcBucket])
  @@unique([migrationId, idx])
}

/// One hostname of an imported app on its way from the source PaaS to Tugra (SSL/DNS cutover). The state machine
/// is PLANNED -> CERT_PENDING -> CERT_READY -> READY -> SWITCHING -> SWITCHED -> VERIFIED (+ side states). The
/// ledger holds every DNS record write with its before-image (IPs, ids, TTLs only — never a token).
model CutoverDomain {
  id              String         @id @default(cuid())
  operation       BulkOperation  @relation(fields: [opId], references: [id], onDelete: Cascade)
  opId            String
  application     Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   String
  hostname        String
  role            String         @default("primary") // primary | alias | counterpart | service
  state           String         @default("PLANNED")
  blockReason     String? // machine code for BLOCKED / CONFLICT / EXCLUDED
  dnsMode         String         @default("manual") // cloudflare | manual
  dnsCredential   DnsCredential? @relation(fields: [dnsCredentialId], references: [id], onDelete: SetNull)
  dnsCredentialId String?
  zoneId          String?
  sslMode         String? // Cloudflare zone SSL mode at last read (flexible|full|strict|off|unknown)
  challenge       String         @default("http01") // dns01 | http01
  targetIps       Json? // {"v4":[],"v6":[]} snapshot
  ledger          Json? // LedgerRecord[]
  viaWildcard     Boolean        @default(false)
  proxied         Boolean?
  dnsObserved     String         @default("unknown")
  originalTtl     Int?
  targetTtl       Int?
  ttlLoweredAt    DateTime?
  earliestFlipAt  DateTime?
  certState       String         @default("unknown") // unknown|pending|ready|default-cert|untrusted|wrong-host|expired|error
  certIssuer      String?
  certNotAfter    DateTime?
  certError       String?
  precheck        Json? // {tls,http80,https,probeVia,at}; no key material
  precheckAt      DateTime?
  needsDeploy     Boolean        @default(false)
  stateful        Boolean        @default(false)
  warnings        String[]       @default([])
  flippedAt       DateTime?
  verifiedAt      DateTime?
  finalizedAt     DateTime?
  revertedAt      DateTime?
  lastError       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([opId, applicationId, hostname])
  @@index([opId])
  @@index([applicationId])
  @@index([dnsCredentialId])
}

/// One live (or finished) batched flip run for an import op. `activeKey` = opId while running, else NULL, and is
/// UNIQUE: a second concurrent flip fails the insert (one live run per op).
model CutoverRun {
  id          String        @id @default(cuid())
  operation   BulkOperation @relation(fields: [opId], references: [id], onDelete: Cascade)
  opId        String
  activeKey   String?       @unique
  status      String        @default("running") // running | halted | done | cancelled
  params      Json
  total       Int
  batchesDone Int           @default(0)
  heartbeatAt DateTime      @default(now())
  lastError   String?
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?

  @@index([opId])
}

/// A source-host ACME certificate staged by `tugra-agent migrate --certs` until it is merged into the target
/// proxy's acme.json. keyEnc is CryptoService ciphertext of the private key PEM and is '' once applied/purged.
model CutoverCert {
  id              String        @id @default(cuid())
  operation       BulkOperation @relation(fields: [opId], references: [id], onDelete: Cascade)
  opId            String
  hosts           String[]
  certPem         String
  keyEnc          String
  fingerprint     String
  notBefore       DateTime
  notAfter        DateTime
  appliedAt       DateTime?
  appliedServerId String?
  createdAt       DateTime      @default(now())

  @@unique([opId, fingerprint])
  @@index([opId])
}

/// P7 lane C: the same-host proxy swap of a `swap-proxy` migration run, one row per (run, server). It records exactly
/// what the swap stopped (the source's `coolify-proxy`: id, image, restart policy, published ports, never env) and the
/// Tugra proxy bind it replaced, BEFORE the first command, so the reverse is exact and idempotent across hub restarts.
/// `runId` is a LOOSE reference (no FK), like AppMove.appId. Never holds a secret.
enum MigrationRunSwapState {
  PLANNED
  STOPPING_SOURCE_PROXY
  STARTING_TARGET_PROXY
  LIVE
  REVERSING
  REVERSED
}

model MigrationRunSwap {
  id                   String                @id @default(cuid())
  runId                String
  serverId             String
  state                MigrationRunSwapState @default(PLANNED)
  /// {containerId, name, image, restartPolicy, ports[]} of the stopped source proxy (docker inspect minus env).
  coolifyProxy         Json
  /// `Server.proxyBind` before the swap flipped it to "public" (restored by the reverse).
  tugraProxyBindBefore String
  stoppedAt            DateTime?
  liveAt               DateTime?
  reversedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([runId, serverId])
  @@index([serverId])
}

// ── One-click migration orchestrator (P7): MigrationRun sits ABOVE the import BulkOperation, it never replaces it. ──
// Lane A owns this hunk. Lane B appends MigrationRunCheck (after MigrationVolumePart) and lane C MigrationRunSwap
// (after CutoverCert); both reference a run by a LOOSE `runId` (no FK), like AppMove.appId.

/// Lifecycle of a run. FAILED is never terminal in practice: the operator can retry the step or abort.
enum MigrationRunStatus {
  QUEUED
  RUNNING
  WAITING // a step waits for an operator, an approval, a timer or an unblocked gate
  PAUSED
  ABORTING // pre-PONR abort in flight (Coolify becomes authoritative again)
  ABORTED
  ROLLING_BACK // optional cleanup of Tugra-side created resources after an abort
  ROLLED_BACK
  REVERSING // post-PONR lossy reverse in flight
  REVERSED
  COMPLETED
  FAILED
  DRY_RUN_DONE // terminal for a dry-run; it can be promoted to a real run
}

enum MigrationRunStepStatus {
  PENDING
  RUNNING
  WAITING_OPERATOR
  WAITING_APPROVAL
  WAITING_TIMER
  PASSED
  FAILED
  SKIPPED
  COMPENSATED
}

model MigrationRun {
  id              String             @id @default(cuid())
  teamId          String // loose refs (no FK) like AppMove, so audit/report survive team/server deletion
  actorId         String // only the creator drives the run (same rule as the importer's loadOwnedOp)
  targetServerId  String // the DEFAULT target server (every source server `serverMap` does not map lands here)
  serverMap       Json? // multi-host placement: {<source server uuid>: <Tugra target server id>}; null = single target
  sourceKind      String // coolify | dokploy
  sourceHost      String? // snapshot of the source instance host (typed confirmation + list display, no secret)
  sourceVersion   String? // the source's own version string (e.g. "4.1.2"), captured at create/preflight
  agentServerId   String? // an agent-read source: the Tugra server whose agent reads the source, stored at create (null: a token session, or a row from before this column)
  sourceTeamRef   String? // an agent-read source: the source team the read was limited to, stored at create (null: every team, or a row from before this column)
  sourceBaseline  Json? // source health baseline captured before anything changes (refs, health enum, restart counts; no secret)
  campaign        String? // free label grouping the runs of one migration campaign
  sessionId       String? // ImportSession (1 h TTL; refreshed via POST /:id/source-session)
  opId            String?            @unique // the CURRENT import BulkOperation; null before IMPORT
  opHistory       String[]           @default([]) // earlier ops redone by an IMPORT retry
  planHash        String
  mode            String             @default("copy") // ImportMode: copy | takeover (arms DECOMMISSION)
  topology        String             @default("two-box") // CoexistenceStrategy: two-box | swap-proxy
  inPlace         Boolean            @default(false) // swap-proxy only: the source server is taken over in place (no data copy, no build), see CoolifyInPlaceService
  dryRun          Boolean            @default(false)
  promotedFromId  String? // the dry-run this run was promoted from
  applyInput      Json // frozen, secret-free apply input (see RunApplyInputSchema)
  options         Json // RunOptions (see RunOptionsSchema)
  inputs          Json // OwnerInputs with provenance
  status          MigrationRunStatus @default(QUEUED)
  currentStep     String?
  ponrAt          DateTime? // monotonic: set BEFORE the first command that can route stateful production traffic to Tugra
  ponrByUserId    String?
  pauseRequested  Boolean            @default(false)
  abortRequested  Boolean            @default(false)
  ownerId         String? // hub bootId lease (DeployLeaseService.bootId); null = awaiting recovery
  heartbeatAt     DateTime?
  activeKey       String?            @unique // "srv:<targetServerId>" (the default target) while a REAL run is non-terminal; every target server is also locked in MigrationRunServerLock
  eventSeq        Int                @default(0)
  windowEstimate  Json? // {freezeToFlipSec, basis[], estimatedAt}
  freezeStartedAt DateTime?
  freezeEndedAt   DateTime? // first host VERIFIED after the flip/swap => measured downtime
  failureStep     String?
  failureCode     String? // stable code => i18n key
  report          Json? // final secret-free report
  createdAt       DateTime           @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  updatedAt       DateTime           @updatedAt

  steps       MigrationRunStep[]
  events      MigrationRunEvent[]
  serverLocks MigrationRunServerLock[]
  hints       MigrationRunHint[]

  @@index([teamId, createdAt(sort: Desc)])
  @@index([status])
  @@index([actorId])
  @@index([teamId, campaign])
}

/// One row per target server a REAL, non-terminal run places resources on (the default `targetServerId` AND every
/// `serverMap` target): the primary key makes "one live run per target server" hold for every mapped server, atomically with the
/// run's own create. Deleted when the run settles (activeKey released) and re-created when a cleanup re-arms it.
model MigrationRunServerLock {
  serverId  String       @id
  run       MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  createdAt DateTime     @default(now())

  @@index([runId])
}

/// Operator/host-attested safety facts the run's import-side steps consult (grup-7 safety lane): `image-pin` = the digest the
/// SOURCE runs for an unpinned image (key = the image ref as the plan shows it, scope = the source server uuid or "" for every
/// server), `worker-mark` = whether an app is a job runner or serves traffic (key = the plan itemRef, scope = ""). Secret-free.
model MigrationRunHint {
  run       MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  kind      String // image-pin | worker-mark | warning-ack | service-pin
  key       String
  scope     String       @default("")
  value     String // sha256:<64 hex> | job-runner | web | accepted | an image ref (service-pin)
  evidence  String // operator-attested | host-loop-reported | source-api-reported
  createdAt DateTime     @default(now())

  @@id([runId, kind, key, scope])
}

/// What the `coolify-host-loop` runner and the host inventory report back, one row per (run, step, source host, kind) holding the
/// LATEST report (a re-run overwrites it). Written only by the token-authenticated `POST /import/migration/host-report`, whose
/// host label is validated against the run's own hosts. `payload` is secret-free (names, ids, sizes, fixed codes) and capped.
/// kind: loop (per-host runner status) | inventory (containers + mounts + sizes) | reach (hub reachability + body cap) | freeze (stopped containers).
/// `runId` is a LOOSE reference (no FK), like MigrationRunCheck.
model MigrationRunHostReport {
  id              String   @id @default(cuid())
  runId           String
  stepKey         String // DATA_SEED | FREEZE | DATA_FINAL for loop/freeze reports; "" for inventory/reach
  sourceServerRef String // the Coolify server uuid of the source host
  kind            String
  state           String
  payload         Json?
  reportedAt      DateTime @default(now())

  @@unique([runId, stepKey, sourceServerRef, kind])
  @@index([runId, kind])
}

model MigrationRunStep {
  run           MigrationRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId         String
  key           String // PREFLIGHT ... DECOMMISSION (StepKey)
  idx           Int
  kind          String // auto | operator | approval | timer (the step's PRIMARY mode)
  status        MigrationRunStepStatus @default(PENDING)
  rollbackClass String // FREE | UNDOABLE | LOSSY_AFTER_PONR | IRREVERSIBLE
  attempt       Int                    @default(0)
  gate          Json? // {passed, checks:[{id,status,code,params,evidence,ownerInput}], wait?}
  approval      Json? // {byUserId, at, boundHash, acks[], confirmedName, acceptDataRisk, expiresAt}
  inputHash     String? // the hash the approval/act is bound to
  progress      Json? // {done,total,unit,etaSec,dryRun?} (refs to existing tables, not copies)
  compensation  Json? // ids only; written BEFORE the side effect
  evidence      Json? // {attestations[], attachments[]}: operator attestations and attached resources
  wait          Json? // what the step is waiting for (WaitSpec); drives the view's nextAction
  notBefore     DateTime? // timer gates (TTL wait, scheduled freeze, observe window)
  startedAt     DateTime?
  finishedAt    DateTime?
  lastError     String? // fixed code, never raw text

  @@id([runId, key])
}

model MigrationRunEvent {
  run     MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId   String
  seq     Int
  at      DateTime     @default(now())
  stepKey String?
  level   String // info | warn | error
  code    String
  params  Json?
  actorId String? // codes + params only: no English text, no secrets

  @@id([runId, seq])
}

// A requested server reboot and what came of it. Reboots are never automatic: a row exists only because a person (or
// their token) asked for one. `state` is the live phase (SCHEDULED -> STARTING -> REBOOTING -> WAITING_AGENT ->
// VERIFYING -> DONE); `result` is set only in DONE (ok | degraded | failed | cancelled). `snapshot` is what should come
// back (containers + routed domains, taken BEFORE the reboot); `report` is the per-item verification afterwards. A partial
// unique index `server_reboot_one_active_per_server ON ServerReboot(serverId) WHERE state <> 'DONE'` (see the
// 20261127000000 migration; Prisma cannot model it) allows at most one live reboot per server.
model ServerReboot {
  id          String    @id @default(cuid())
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId    String
  requestedBy String // user id of whoever asked (audit actor)
  mode        String // "now" | "scheduled"
  state       String    @default("STARTING") // SCHEDULED | STARTING | REBOOTING | WAITING_AGENT | VERIFYING | DONE
  scheduledAt DateTime? // when a scheduled reboot is due (UTC); null for "now"
  startedAt   DateTime? // when the host-side reboot unit was created
  agentBackAt DateTime? // when the agent reconnected on a new boot
  verifiedAt  DateTime? // when verification settled (or the reboot ended in failure)
  result      String? // ok | degraded | failed | cancelled — set only when state = DONE
  snapshot    Json? // pre-reboot: { bootId, hostsHub, containers[], domains[], probe }
  report      Json? // post-reboot verification (per container / domain), updated while VERIFYING
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([serverId, createdAt])
  @@index([state])
}

// "Read this Coolify": a read-only snapshot of a Coolify instance, read through the Tugra agent on its host (the agent
// runs a read-only psql inside `coolify-db`). One row per agent server, created by an explicit owner/admin opt-in.
// The snapshot is metadata only (names, addresses, statuses, counts); secret fields are recorded as "present" and their
// values never leave Coolify's own database, so there is nothing to encrypt (no *Enc column).
model CoolifyInventory {
  id           String    @id @default(cuid())
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  server       Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId     String    @unique // the agent server that runs Coolify
  enabledById  String // who opted this server in
  enabledAt    DateTime  @default(now())
  coolifyImage String? // image reference of the `coolify` container at the last read (the version)
  snapshot     Json? // normalised inventory (coolify-inventory.ts); null until the first read
  counts       Json? // headline counts for the list view
  readAt       DateTime?
  readById     String?
  // Coolify server uuid -> { teamId, serverId }: the Tugra servers created for "Add all Coolify servers".
  serverLinks  Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([teamId])
}

// A team's public status page, served unauthenticated at /status/<slug>. Only the chosen monitors' public label and
// state, the incident history derived from their state changes and the maintenance notices ever leave the hub.
model StatusPage {
  id          String              @id @default(cuid())
  team        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String              @unique
  slug        String              @unique
  title       String
  description String?
  enabled     Boolean             @default(false) // published; an unpublished page answers 404
  monitors    StatusPageMonitor[]
  maintenance StatusMaintenance[]
  subscribers StatusSubscriber[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model StatusPageMonitor {
  page      StatusPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  monitor   Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  label     String? // public name; null = the monitor's own name
  position  Int        @default(0)

  @@id([pageId, monitorId])
}

model StatusMaintenance {
  id        String     @id @default(cuid())
  page      StatusPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  title     String
  body      String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime   @default(now())

  @@index([pageId, startsAt])
}

// An email subscriber of a status page (only used while the hub has mail configured). Double opt-in: confirmedAt is
// set when the address follows the emailed link. The confirm/unsubscribe tokens are keyed MACs of the row id, so
// nothing secret is stored.
model StatusSubscriber {
  id          String     @id @default(cuid())
  page        StatusPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId      String
  email       String
  confirmedAt DateTime?
  createdAt   DateTime   @default(now())
  /** When the confirmation email last went out (resends are throttled). */
  mailedAt    DateTime   @default(now())

  @@unique([pageId, email])
}
// The monthly price of one server. Only a price the hub READ from the provider ("provider") or an operator TYPED
// ("manual") is stored; an estimate from the bundled public price snapshot is computed on read and never persisted.
// Money is integer minor units (cents) in `currency`, excluding VAT. No secret lives here.
model ServerCost {
  server       Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId     String    @id
  monthlyCents Int
  currency     String    @default("EUR")
  source       String // "provider" | "manual"
  provider     String? // provider slug the price belongs to (hetzner | digitalocean | vultr | ...)
  planSlug     String? // provider plan id (e.g. a Hetzner server type), when known
  location     String? // provider location of a provider-read price (needed to price rescale candidates)
  syncedAt     DateTime? // when a provider price was last read
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// A saved "before" bill for the before/after comparison (taken from the current prices or typed by hand). `lines`
// holds [{ name, monthlyCents }] for a snapshot of the servers (names only), [] for a typed total.
model CostBaseline {
  id           String   @id @default(cuid())
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  label        String
  monthlyCents Int
  currency     String   @default("EUR")
  lines        Json     @default("[]")
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([teamId, createdAt])
}

// A one-click rescale of a cloud-linked server through its provider API: graceful shutdown, change type (disk kept,
// so the move stays reversible), power on. Driven by the hub and resumed after a restart; `phase` is the step reached.
// Migration adds a partial unique index so only one rescale per server is active at a time.
model ServerRescale {
  id          String    @id @default(cuid())
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId    String
  requestedBy String
  provider    String
  fromPlan    String
  toPlan      String
  upgradeDisk Boolean   @default(false) // also grow the disk (permanent; false keeps the move reversible)
  wasOff      Boolean   @default(false) // the server was already powered off when the move began (it stays off after)
  phase       String    @default("SHUTTING_DOWN") // SHUTTING_DOWN | RESIZING | POWERING_ON | DONE | FAILED
  error       String? // provider-response text only, never a token
  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@index([serverId, startedAt])
}

/// Consent for the Coolify hub takeover on ONE Coolify host (lanes B and C): "secrets" lets the agent decrypt Coolify's values and seal them
/// to the per-run key below; "ssh" lets it use Coolify's own SSH keys to install agents on the servers Coolify knows. Owner-only, time-limited,
/// revocable. The capability the grant turned on is dropped when the grant ends. The private half of the run key is wrapped with CryptoService
/// (tk1), kept only so a restart can resume, and cleared (set null) when the run ends or the grant expires: later-stolen envelopes stay shut.
model CoolifyHostGrant {
  id                 String    @id @default(cuid())
  team               Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId             String
  server             Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId           String // the agent server that runs Coolify
  kind               String // secrets | ssh
  classes            String[]  @default([]) // consent classes ticked (secrets only; see COOLIFY_SECRET_CLASSES)
  grantedById        String
  runId              String? // the import session / run the key belongs to
  recipientPublicKey String? // base64 X25519 public key (secrets only)
  recipientKeyEnc    String? // CryptoService-wrapped X25519 private key; NULL once destroyed. Never returned by any endpoint
  expiresAt          DateTime
  revokedAt          DateTime?
  revokedById        String?
  createdAt          DateTime  @default(now())

  @@index([serverId, kind, expiresAt])
  @@index([teamId, createdAt(sort: Desc)])
}

/// One Coolify-known server the Tugra agent is installed on over SSH (lane C). The state machine is persisted per target so a restart resumes
/// with a probe (never a blind re-run). Names, states and fixed codes only: never a key, a token, a command line or a key path.
model CoolifySshTarget {
  id                String    @id @default(cuid())
  team              Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String // the Tugra team that owns the Coolify host's inventory
  server            Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId          String // the agent server that runs Coolify (the SSH comes from there)
  runId             String // one install run = many targets
  grantId           String? // the CoolifyHostGrant (kind "ssh") this run runs under
  coolifyServerUuid String
  name              String
  state             String    @default("PLANNED") // see COOLIFY_SSH_TARGET_STATES
  code              String? // see COOLIFY_SSH_RESULT_CODES
  targetTeamId      String? // Tugra team the new server goes to (loose ref)
  tugraServerId     String? // the Server row minted for this target (loose ref); null until a token is minted
  probe             Json? // CoolifyProbeFacts of the last probe
  hostKeyFp         String? // sshd host key fingerprint the probe saw (cross-checked at enroll)
  containerId       String? // id of the agent container this run installed; the uninstall is pinned to it (a 64-hex id, never a secret)
  cancelledAt       DateTime? // the owner cancelled: no further step starts for this target
  attempts          Int       @default(0)
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // One active row per (Coolify host, Coolify server) is the lane's lock; a partial unique index may be added by lane C (Prisma cannot model it).
  @@unique([runId, coolifyServerUuid])
  @@index([serverId, state])
  @@index([teamId])
}

/// A campaign of guided runs (lane E): a mixed placement (some servers in place, some moved) becomes one MigrationRun per source server, in waves.
/// `label` is the value of MigrationRun.campaign. Loose refs, no FK, so the history survives team/server deletion.
model MigrationCampaign {
  id        String   @id @default(cuid())
  teamId    String
  actorId   String
  label     String
  sessionId String? // the ImportSession the plan was read through
  status    String   @default("draft") // see CAMPAIGN_STATUSES
  plan      Json     @default("[]") // CampaignRunPlan[] (names/refs/ids only)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, label])
  @@index([teamId, createdAt(sort: Desc)])
}

/// Taking over one server in place (lane F): Tugra proxy on a temporary port, tested, then the ports are handed over; "give back to Coolify" undoes it
/// until the cleanup lane removes Coolify's leftovers. `plan` and `rollback` name containers, images, ports and domains; they hold no env value or key.
model CoolifyTakeover {
  id                String    @id @default(cuid())
  teamId            String
  serverId          String // the Tugra server taken over (loose ref)
  actorId           String
  sessionId         String?
  runId             String? // the MigrationRun that carries it, when run as part of one
  status            String    @default("PLANNED") // see TAKEOVER_STATUSES
  tempPort          Int?
  plan              Json      @default("{}")
  rollback          Json      @default("{}")
  items             Json      @default("[]") // TakeoverItemView[]
  giveBackAvailable Boolean   @default(true)
  failureCode       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  finishedAt        DateTime?

  @@index([serverId, createdAt(sort: Desc)])
  @@index([teamId, status])
}

/// Coolify leftover cleanup and the completeness checklist that gates it (lane G). The owner confirms the list before anything is removed;
/// every step is audited. Names, counts and sizes only.
model CoolifyCleanup {
  id            String    @id @default(cuid())
  teamId        String
  serverId      String // loose ref
  actorId       String
  status        String    @default("CHECKING") // see CLEANUP_STATUSES
  completeness  Json      @default("[]") // CompletenessRow[]
  remnants      Json      @default("[]") // CleanupRemnant[]
  results       Json      @default("[]") // per-remnant outcome, fixed codes
  confirmedById String?
  confirmedAt   DateTime?
  cleanedAt     DateTime?
  failureCode   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([serverId, createdAt(sort: Desc)])
  @@index([teamId, status])
}

/// Move a whole project (apps + databases + services + volumes + domains) from one Tugra server to another (lane H). It composes the existing
/// AppMove and database moves: `items` lists the children. Same safety copy as AppMove (retainDays). Loose refs like AppMove.
model ProjectMove {
  id              String    @id @default(cuid())
  teamId          String
  actorId         String
  projectId       String // loose ref
  sourceServerId  String
  targetServerId  String
  phase           String    @default("QUEUED") // see PROJECT_MOVE_PHASES
  plan            Json      @default("{}") // frozen preflight (no secret values)
  items           Json      @default("[]") // ProjectMoveItemView[]
  retainDays      Int       @default(7)
  repointDns      Boolean   @default(false)
  archiveUntil    DateTime?
  failureReason   String?
  cancelRequested Boolean   @default(false)
  ownerId         String? // hub bootId driving the job; NULL = awaiting recovery
  heartbeatAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([phase])
  @@index([teamId])
}
