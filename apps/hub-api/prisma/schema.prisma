// Tugra hub — Prisma schema v0 (Faz 0)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

enum ServerStatus {
  PENDING
  ONLINE
  OFFLINE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  name         String?
  twoFaSecret  String?
  twoFaEnabled Boolean      @default(false)
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Team {
  id          String       @id @default(cuid())
  name        String
  memberships  Membership[]
  servers      Server[]
  monitors     Monitor[]
  channels     NotificationChannel[]
  applications Application[]
  createdAt    DateTime     @default(now())
}

model Membership {
  id     String @id @default(cuid())
  role   Role   @default(VIEWER)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  @@unique([userId, teamId])
}

model Server {
  id                   String       @id @default(cuid())
  name                 String
  // "Sunucu Tuğrası" — the server's unique signed identity (set at enrollment).
  seal                 String?      @unique
  status               ServerStatus @default(PENDING)
  enrollToken          String       @unique
  enrollTokenExpiresAt DateTime?
  // ed25519 public key the agent generated on-box (private key never leaves it).
  agentPublicKey       String?
  agentVersion         String?
  hostname             String?
  lastSeenAt           DateTime?
  team                 Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId               String
  metrics              Metric[]
  createdAt            DateTime     @default(now())
}

model Metric {
  id        String   @id @default(cuid())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String
  ts        DateTime @default(now())
  cpu       Float
  memUsed   BigInt
  memTotal  BigInt
  diskUsed  BigInt
  diskTotal BigInt
  netRx     BigInt
  netTx     BigInt

  @@index([serverId, ts])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum MonitorType {
  HTTP
  TCP
}

enum MonitorStatus {
  UP
  DOWN
  PENDING
}

model Monitor {
  id          String        @id @default(cuid())
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  name        String
  type        MonitorType
  target      String // url (HTTP) or host:port (TCP)
  intervalSec Int           @default(30)
  retries     Int           @default(1)
  timeoutMs   Int           @default(10000)
  resendEvery Int           @default(0) // re-notify every N consecutive down beats (0 = off)
  status      MonitorStatus @default(PENDING)
  failCount   Int           @default(0) // consecutive failures (for retry → DOWN)
  downCount   Int           @default(0) // consecutive down beats (for resend)
  enabled     Boolean       @default(true)
  heartbeats  Heartbeat[]
  channels    MonitorChannel[]
  createdAt   DateTime      @default(now())
}

model Heartbeat {
  id        String        @id @default(cuid())
  monitor   Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  status    MonitorStatus
  ms        Int // latency
  msg       String?
  important Boolean       @default(false)
  ts        DateTime      @default(now())

  @@index([monitorId, ts])
}

model NotificationChannel {
  id        String           @id @default(cuid())
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  name      String
  type      String // webhook | telegram | ntfy | discord | slack
  config    Json
  enabled   Boolean          @default(true)
  monitors  MonitorChannel[]
  createdAt DateTime         @default(now())
}

model MonitorChannel {
  monitor   Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String

  @@id([monitorId, channelId])
}

enum BulkTaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
}

model BulkOperation {
  id        String     @id @default(cuid())
  actorId   String
  command   String
  tasks     BulkTask[]
  createdAt DateTime   @default(now())
}

model BulkTask {
  id         String         @id @default(cuid())
  operation  BulkOperation  @relation(fields: [opId], references: [id], onDelete: Cascade)
  opId       String
  serverId   String
  status     BulkTaskStatus @default(PENDING)
  exitCode   Int?
  output     String?
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([opId])
}

enum AppStatus {
  NEW
  RUNNING
  STOPPED
  FAILED
}

enum DeploymentStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Application {
  id            String       @id @default(cuid())
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  serverId      String
  name          String
  image         String
  env           Json
  hostPort      Int?
  containerPort Int?         @default(80)
  domain        String?
  https         Boolean      @default(true)
  status        AppStatus    @default(NEW)
  deployments   Deployment[]
  createdAt     DateTime     @default(now())
}

model Deployment {
  id          String           @id @default(cuid())
  application Application      @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId       String
  status      DeploymentStatus @default(RUNNING)
  logs        String?
  exitCode    Int?
  createdAt   DateTime         @default(now())

  @@index([appId])
}
