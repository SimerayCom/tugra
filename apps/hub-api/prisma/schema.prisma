// Tugra hub — Prisma schema v0 (Faz 0)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

enum ServerStatus {
  PENDING
  ONLINE
  OFFLINE
}

model User {
  id            String                  @id @default(cuid())
  email         String                  @unique
  password      String
  name          String?
  twoFaSecret   String?
  twoFaEnabled  Boolean                 @default(false)
  twoFaEnabledAt DateTime?
  emailVerified Boolean                 @default(false)
  emailVerifiedAt DateTime?
  uiMode        String                  @default("fleet") // "fleet" | "home"
  isInstanceOwner Boolean               @default(false) // the first user to register; owns instance-level settings
  memberships   Membership[]
  apiTokens     ApiToken[]
  savedViews    SavedView[]
  recoveryCodes TwoFactorRecoveryCode[]
  verificationTokens VerificationToken[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

// Purpose of an emailed single-use token. EMAIL_VERIFY is reserved for the email-verification
// slice — this table is shared so that slice needs no new migration.
enum VerificationPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// A single-use, expiring token delivered by email (password reset / email verification). Only the
// sha256 hash is stored — the raw token lives only in the emailed URL. Single-use via `usedAt`.
model VerificationToken {
  id        String              @id @default(cuid())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  purpose   VerificationPurpose
  tokenHash String              @unique
  email     String              // target email (forward-compat for email-change verify; = user.email for reset)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
}

// One-time 2FA recovery codes (hashed) — a fallback to log in when the TOTP device is lost.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  codeHash  String // sha256 of the canonical (dashless, upper-cased) code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A user's named fleet filter (status + tags) for the servers/fleet table.
model SavedView {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // null = personal (only the owner); set = shared with everyone on the team.
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String?
  name      String
  status    String? // ONLINE | PENDING | OFFLINE | null (all)
  tags      String[] @default([])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([teamId])
}

model ApiToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     String[]  @default(["read"]) // read | write | deploy | admin | read:secrets
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  memberships  Membership[]
  servers      Server[]
  monitors     Monitor[]
  channels     NotificationChannel[]
  applications Application[]
  databases    Database[]
  backupDestinations BackupDestination[]
  sharedVariables SharedVariable[]
  projects     Project[]
  invitations  TeamInvitation[]
  gitSources   GitSource[]
  registries   Registry[]
  savedViews   SavedView[]
  customRoles  TeamRole[]
  createdAt    DateTime     @default(now())
}

// A team-defined named role with a granular set of resource permissions (see TEAM_PERMISSIONS in
// @tugra/shared). Assigned to a member via Membership.teamRoleId; grants ONLY resource permissions
// — member/role/team administration stays reserved for the built-in OWNER/ADMIN roles.
model TeamRole {
  id          String       @id @default(cuid())
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  name        String
  permissions String[]     @default([])
  memberships Membership[]
  createdAt   DateTime     @default(now())

  @@unique([teamId, name])
  @@index([teamId])
}

model TeamInvitation {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  email     String
  role      Role     @default(VIEWER)
  token     String   @unique
  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([teamId, email])
  @@index([email])
}

model Project {
  id           String        @id @default(cuid())
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  name         String
  isDefault    Boolean       @default(false) // the team's default project (exactly one per team)
  environments Environment[]
  createdAt    DateTime      @default(now())

  @@index([teamId])
}

model Environment {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  isDefault Boolean  @default(false) // the project's default environment (exactly one per project)
  applications Application[]
  databases    Database[]
  createdAt DateTime @default(now())

  @@index([projectId])
}

model SharedVariable {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  key       String
  valueEnc  String
  createdAt DateTime @default(now())

  @@unique([teamId, key])
  @@index([teamId])
}

model Membership {
  id     String @id @default(cuid())
  role   Role   @default(VIEWER)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  // Optional custom role: when set, the member's resource permissions come from this TeamRole
  // instead of the built-in `role` tier. SetNull so deleting a role reverts members to `role`
  // (VIEWER by default). null → the built-in enum role is authoritative (no regression).
  teamRole   TeamRole? @relation(fields: [teamRoleId], references: [id], onDelete: SetNull)
  teamRoleId String?

  // Per-resource access scoping (least privilege). Opt-in via `restrictedAccess`: while false
  // (the default, and every existing member) the member has full access at their team role — no
  // regression. When true, a VIEWER only sees the granted projects (+ their resources) and any
  // explicitly granted resource ids. OWNER/ADMIN always bypass scoping (they manage the team).
  restrictedAccess  Boolean  @default(false)
  accessedProjects  String[] @default([]) // project ids this member may access when restricted
  accessedResources String[] @default([]) // app/db ids (fine-grained escape hatch + grant-on-create)

  @@unique([userId, teamId])
}

model Server {
  id                   String       @id @default(cuid())
  name                 String
  // "Sunucu Tuğrası" — the server's unique signed identity (set at enrollment).
  seal                 String?      @unique
  status               ServerStatus @default(PENDING)
  enrollToken          String       @unique
  enrollTokenExpiresAt DateTime?
  // ed25519 public key the agent generated on-box (private key never leaves it).
  agentPublicKey       String?
  agentVersion         String?
  hostname             String?
  publicIp             String?      // observed reachable IPv4 (or manual override)
  publicIpv6           String?      // observed reachable IPv6
  ipSource             String       @default("observed") // observed | reported | manual
  reportedIps          String[]     @default([]) // agent-reported candidate interface IPs (reconcile)
  wildcardDomain       String?      // per-server magic-domain root (e.g. apps.example.com); blank → sslip.io
  magicSuffix          String?      // override the global magic suffix ("sslip.io" | "nip.io")
  certMode             String       @default("http") // "http" | "le-dns" | "custom" — wildcard cert policy
  dnsProvider          String?      // lego/Traefik DNS provider for DNS-01 (cloudflare, route53, ...)
  dnsCredsEnc          String?      // encrypted JSON of provider env vars ({ CF_DNS_API_TOKEN: "..." })
  customCertResolver   String?      // Traefik resolver name when certMode = "custom"
  os                   String?
  osVersion            String?
  arch                 String?
  kernel               String?
  cpuCores             Int?
  memTotalBytes        BigInt?
  bootTime             DateTime?
  cleanupEnabled       Boolean      @default(false)
  cleanupIntervalHours Int?
  cleanupVolumes       Boolean      @default(false)
  lastCleanupAt        DateTime?
  lastSeenAt           DateTime?
  team                 Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId               String
  tags                 String[]     @default([])
  // Granted agent capabilities the hub will sign commands for. Enforced verbatim; empty = none
  // (fail-safe). Legacy servers are backfilled to the full set by migration; new servers default
  // to all-except-terminal (least privilege — the interactive shell is opt-in).
  capabilities         String[]     @default([])
  metrics              Metric[]
  containerMetrics     ContainerMetric[]
  metricRollups        MetricRollup[]
  containerMetricRollups ContainerMetricRollup[]
  logDrains            LogDrain[]
  tunnel               ServerTunnel?
  createdAt            DateTime     @default(now())
}

model LogDrain {
  id           String   @id @default(cuid())
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId     String
  name         String
  type         String   @default("HTTP")
  endpoint     String
  authTokenEnc String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([serverId])
}

// Cloudflare Tunnel binding for a server (zero-IP expose). 1:1 with Server. Secrets
// (cfApiTokenEnc, cfTunnelTokenEnc) are libsodium-encrypted at rest and never returned.
model ServerTunnel {
  id               String   @id @default(cuid())
  server           Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId         String   @unique
  provider         String   @default("cloudflare")
  cfAccountId      String
  zoneName         String   // registrable CF zone owning the wildcard (e.g. "example.com")
  zoneId           String
  cfApiTokenEnc    String   // encrypted operator CF API token — NEVER returned/logged
  tunnelId         String?  // CF tunnel UUID, set once createTunnel succeeds (idempotent resume)
  tunnelName       String   // deterministic "tugra-<serverId>"
  cfTunnelTokenEnc String?  // encrypted cloudflared connector run-token
  dnsRecordId      String?  // CF DNS record id of the wildcard CNAME (exact teardown)
  status           String   @default("pending") // pending | connecting | connected | error | disabled
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Metric {
  id        String   @id @default(cuid())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String
  ts        DateTime @default(now())
  cpu       Float
  memUsed   BigInt
  memTotal  BigInt
  diskUsed  BigInt
  diskTotal BigInt
  netRx     BigInt
  netTx     BigInt
  diskRead  BigInt @default(0) // bytes/s; @default so the additive migration needs no backfill
  diskWrite BigInt @default(0)

  @@index([serverId, ts])
  @@index([ts]) // for the retention prune (deleteMany where ts < cutoff, across all servers)
}

// Per-container resource usage from the agent's `docker stats`. containerName is the STABLE key
// (containerId changes on restart); net/block are rates (B/s) the agent derives from cumulative
// deltas. Unbounded until the retention slice adds a prune scheduler (@@index([ts]) is for that).
model ContainerMetric {
  id            String   @id @default(cuid())
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  containerName String
  containerId   String
  ts            DateTime @default(now())
  cpu           Float
  memUsed       BigInt
  memTotal      BigInt
  memPct        Float
  netRx         BigInt
  netTx         BigInt
  blkRead       BigInt
  blkWrite      BigInt

  @@index([serverId, containerName, ts])
  @@index([ts])
}

// 1-minute rollup of host Metric rows (avg/max per bucket) — lets long-range charts survive past the
// raw retention window. Populated by the rollup scheduler; one row per (serverId, minute bucket).
model MetricRollup {
  id           String   @id @default(cuid())
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId     String
  bucket       DateTime // minute-truncated
  avgCpu       Float
  maxCpu       Float
  avgMemUsed   BigInt
  avgMemTotal  BigInt
  avgDiskUsed  BigInt
  avgDiskTotal BigInt
  avgNetRx     BigInt
  avgNetTx     BigInt
  avgDiskRead  BigInt
  avgDiskWrite BigInt

  @@unique([serverId, bucket])
  @@index([bucket]) // for the rollup retention prune (deleteMany where bucket < cutoff)
}

// 1-minute rollup of ContainerMetric rows, one row per (serverId, containerName, minute bucket).
model ContainerMetricRollup {
  id            String   @id @default(cuid())
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  containerName String
  bucket        DateTime
  avgCpu        Float
  maxCpu        Float
  avgMemUsed    BigInt
  avgMemTotal   BigInt
  avgMemPct     Float
  avgNetRx      BigInt
  avgNetTx      BigInt
  avgBlkRead    BigInt
  avgBlkWrite   BigInt

  @@unique([serverId, containerName, bucket])
  @@index([bucket])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum MonitorType {
  HTTP
  TCP
  METRIC
}

enum MonitorStatus {
  UP
  DOWN
  PENDING
}

model Monitor {
  id          String        @id @default(cuid())
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  name        String
  type        MonitorType
  target      String // url (HTTP) or host:port (TCP); a label for METRIC
  serverId    String?       // METRIC: which server's metrics to watch
  metric      String?       // METRIC: DISK | CPU | MEM
  thresholdPct Int?         // METRIC: alarm when usage >= this %
  intervalSec Int           @default(30)
  retries     Int           @default(1)
  timeoutMs   Int           @default(10000)
  resendEvery Int           @default(0) // re-notify every N consecutive down beats (0 = off)
  status      MonitorStatus @default(PENDING)
  failCount   Int           @default(0) // consecutive failures (for retry → DOWN)
  downCount   Int           @default(0) // consecutive down beats (for resend)
  enabled     Boolean       @default(true)
  // Auto-created uptime monitor for an app's domain (auto=true, appId set).
  appId       String?
  auto        Boolean       @default(false)
  heartbeats  Heartbeat[]
  channels    MonitorChannel[]
  createdAt   DateTime      @default(now())

  @@index([appId])
}

model Heartbeat {
  id        String        @id @default(cuid())
  monitor   Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  status    MonitorStatus
  ms        Int // latency
  msg       String?
  important Boolean       @default(false)
  ts        DateTime      @default(now())

  @@index([monitorId, ts])
  @@index([ts]) // for the retention prune (deleteMany where ts < cutoff AND important = false)
}

model NotificationChannel {
  id         String                 @id @default(cuid())
  team       Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String
  name       String
  type       String // webhook | telegram | ntfy | discord | slack | smtp | gotify
  configEnc  String // encrypted JSON config (secrets never stored plaintext)
  enabled    Boolean                @default(true)
  eventTypes String[]               @default([]) // deploy_success | deploy_failed | server_offline …
  locale     String                 @default("en") // notification language (server-side i18n)
  monitors   MonitorChannel[]
  deliveries NotificationDelivery[]
  createdAt  DateTime               @default(now())
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

// Per-attempt delivery record for a fired notification — the durable audit/history behind the queue
// (BullMQ retries feed status FAILED → DEAD). Message content is snapshotted; config secrets never are.
model NotificationDelivery {
  id        String                     @id @default(cuid())
  channel   NotificationChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String
  event     String
  level     String
  title     String
  summary   String
  status    NotificationDeliveryStatus @default(PENDING)
  attempts  Int                        @default(0)
  lastError String?
  createdAt DateTime                   @default(now())
  sentAt    DateTime?

  @@index([channelId, createdAt])
  @@index([status])
}

model MonitorChannel {
  monitor   Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String

  @@id([monitorId, channelId])
}

// A registered Git provider app (GitHub App) for private-repo deploys.
model GitSource {
  id               String        @id @default(cuid())
  team             Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId           String
  name             String
  provider         String        @default("github")
  appId            String
  appSlug          String?
  clientId         String?
  clientSecretEnc  String?
  privateKeyEnc    String
  webhookSecretEnc String?
  installationId   String?
  htmlUrl          String?
  applications     Application[]
  createdAt        DateTime      @default(now())

  @@index([teamId])
}

// A team-scoped container registry for pushing built images (portable rollback / multi-server).
model Registry {
  id           String        @id @default(cuid())
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  name         String
  type         String        @default("generic") // dockerhub | ghcr | gitlab | generic
  url          String?       // registry host (blank → Docker Hub); e.g. ghcr.io, registry.gitlab.com
  username     String
  passwordEnc  String        // encrypted registry password / access token
  imagePrefix  String?       // namespace/org under which images are pushed (e.g. myorg)
  applications Application[]
  createdAt    DateTime      @default(now())

  @@index([teamId])
}

enum BulkTaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
}

model BulkOperation {
  id        String     @id @default(cuid())
  actorId   String
  command   String
  tasks     BulkTask[]
  createdAt DateTime   @default(now())
}

model BulkTask {
  id         String         @id @default(cuid())
  operation  BulkOperation  @relation(fields: [opId], references: [id], onDelete: Cascade)
  opId       String
  serverId   String
  status     BulkTaskStatus @default(PENDING)
  exitCode   Int?
  output     String?
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([opId])
}

enum AppStatus {
  NEW
  RUNNING
  STOPPED
  FAILED
}

enum AppSource {
  IMAGE
  GIT
  COMPOSE
}

enum BuildType {
  NIXPACKS
  DOCKERFILE
  STATIC
  RAILPACK
  HEROKU
}

enum DeploymentStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum DbEngine {
  POSTGRES
  MYSQL
  REDIS
  MONGO
  MARIADB
  KEYDB
  DRAGONFLY
  CLICKHOUSE
}

enum DbStatus {
  NEW
  RUNNING
  STOPPED
  FAILED
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model VolumeBackup {
  id            String       @id @default(cuid())
  app           Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId         String
  volumeName    String
  status        BackupStatus @default(PENDING)
  filename      String
  path          String
  destinationId String?
  objectKey     String?
  sizeBytes     BigInt?
  createdBy     String
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([appId])
}

enum DestType {
  LOCAL
  S3
}

model Application {
  id            String       @id @default(cuid())
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  environment    Environment  @relation(fields: [environmentId], references: [id], onDelete: NoAction)
  environmentId  String
  serverId       String
  buildServerId  String?      // optional separate build server (build+push there, pull+run on serverId)
  name           String
  templateSlug   String?      // catalog slug when installed from a template (for its logo)
  source         AppSource    @default(IMAGE)
  image          String?
  gitUrl         String?
  gitBranch      String?      @default("main")
  buildType      BuildType    @default(NIXPACKS)
  dockerfilePath String?
  buildCommand   String?
  outputDir      String?
  composeFile    String?
  healthCmd      String?
  healthCheckType String?                          // null = auto | "NONE" | "HTTP" | "CMD" — deploy-gate health policy
  healthCheckPath String?                          // HTTP check path (default "/")
  healthCheckPort Int?                             // HTTP check port (default container/host port)
  memoryMb       Int?
  cpus           Float?
  deployTimeoutSec Int?
  volumes        Json?
  portMappings   Json?        // [{serviceName, containerPort, hostPort, mode}] — install-time allocated host ports
  installConfig  Json?        // redacted user field selections captured at template install (never secret values)
  configMounts   Json?        // [{serviceName, target, content, mode}] — template config files materialized + bound at deploy (${KEY} placeholders, never resolved secrets)
  gitTokenEnc     String?
  gitSource       GitSource?   @relation(fields: [gitSourceId], references: [id], onDelete: SetNull)
  gitSourceId     String?
  registryAuthEnc String?
  registry        Registry?    @relation(fields: [registryId], references: [id], onDelete: SetNull)
  registryId      String?      // team registry to push the built image to (when pushToRegistry)
  pushToRegistry  Boolean      @default(false)
  env            Json
  envEnc         String?
  buildArgsEnc   String?
  dockerOptions  String?
  hostPort       Int?
  containerPort  Int?         @default(80)
  domain         String?
  domainRedirect  String?
  securityHeaders Boolean     @default(false)
  forwardAuth    String?
  https          Boolean      @default(true)
  domainKind     String       @default("none")  // "none" | "magic" | "custom" — is the domain user-set or generated
  exposeMode     String       @default("magic") // create preference: "magic" | "port" | "none" | "custom"
  tunnelExposed  Boolean      @default(false)   // per-app opt-in: route this app's hostname through the server's Cloudflare Tunnel
  certType       String       @default("http")  // "http" | "none" | "le-http" | "le-dns" | "custom"
  deployStrategy String       @default("ROLLING") // "ROLLING" (zero-downtime) | "RECREATE"
  rollbackOnFailure Boolean   @default(true)      // auto-rollback to the previous version on a failed health gate
  status         AppStatus    @default(NEW)
  webhookToken   String?      @unique
  webhookSecret  String?
  // Preview deployments (B6): a preview is a throwaway clone of a parent app
  // created per pull-request; the parent opts in via previewEnabled.
  isPreview      Boolean      @default(false)
  previewEnabled Boolean      @default(false)
  prNumber       Int?
  parentAppId    String?
  tags           String[]     @default([])
  // Volume backups (Dokploy parity): back up the app's named volumes to a destination.
  volumeBackupEnabled       Boolean @default(false)
  volumeBackupIntervalHours Int?
  volumeBackupRetention     Int     @default(7)
  volumeBackupDestinationId String?
  volumeBackups  VolumeBackup[]
  parent         Application?  @relation("AppPreviews", fields: [parentAppId], references: [id], onDelete: Cascade)
  previews       Application[] @relation("AppPreviews")
  deployments   Deployment[]
  scheduledTasks ScheduledTask[]
  createdAt     DateTime     @default(now())

  @@index([environmentId])
  @@index([parentAppId])
}

model ScheduledTask {
  id          String      @id @default(cuid())
  application Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId       String
  name        String
  schedule    String
  command     String
  enabled     Boolean      @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime     @default(now())

  @@index([appId])
}

model Deployment {
  id          String           @id @default(cuid())
  application Application      @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId       String
  status      DeploymentStatus @default(RUNNING)
  kind        String           @default("DEPLOY") // "DEPLOY" | "ROLLBACK" | "AUTO_ROLLBACK"
  logs        String?
  exitCode    Int?
  imageTag    String?
  registryImage String?   // registry ref this deploy pushed to (for portable rollback pull)
  // Redacted config snapshot this deploy ran with (secrets fingerprinted, not stored).
  configSnapshot Json?
  createdAt   DateTime         @default(now())

  @@index([appId])
}

model Database {
  id          String   @id @default(cuid())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: NoAction)
  environmentId String
  serverId    String
  name        String
  engine      DbEngine
  version     String
  image       String
  port        Int
  hostPort    Int?
  credentials String
  status      DbStatus @default(NEW)
  healthCmd      String?
  memoryMb       Int?
  cpus           Float?
  backupEnabled       Boolean  @default(false)
  backupIntervalHours Int?
  backupRetention     Int      @default(7)
  backupDestinationId String?
  tags        String[] @default([])
  backups     Backup[]
  restores    Restore[]
  createdAt   DateTime @default(now())

  @@index([teamId])
  @@index([environmentId])
}

model BackupDestination {
  id                String   @id @default(cuid())
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String
  name              String
  type              DestType @default(S3)
  s3Bucket          String?
  s3Region          String?
  s3Endpoint        String?
  s3AccessKey       String?
  s3SecretKey       String?
  s3Prefix          String?
  encryptionEnabled Boolean  @default(false)
  encryptionKey     String?
  createdAt         DateTime @default(now())

  @@index([teamId])
}

enum RestoreKind {
  RESTORE
  RESTORE_TO
  IMPORT_URL
}

enum RestoreStatus {
  RUNNING
  SUCCESS
  FAILED
}

// A restore attempt + its outcome (so a failed restore is recorded, surfaced,
// and alerted on — not silently reported as success).
model Restore {
  id               String        @id @default(cuid())
  database         Database      @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  databaseId       String        // the database restored INTO
  backupId         String?       // source backup (may be deleted later → no FK)
  sourceDatabaseId String?       // source DB for a cross-resource restore-to
  kind             RestoreKind
  status           RestoreStatus @default(RUNNING)
  exitCode         Int?
  errorTail        String?       // last ~2KB of output; writer-only exposure
  createdBy        String
  createdAt        DateTime      @default(now())
  completedAt      DateTime?

  @@index([databaseId, createdAt])
}

model Backup {
  id          String       @id @default(cuid())
  database    Database     @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  databaseId  String
  status      BackupStatus @default(PENDING)
  filename    String
  path        String
  destinationId String?
  objectKey   String?
  sizeBytes   BigInt?
  createdBy   String
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([databaseId])
}

// The last-good SIGNED remote template catalog (single row, fixed PK). Persisted only AFTER the
// ed25519 signature + shape validation pass, so it is a durable trusted snapshot for boot/offline.
// The bundled catalog is always the base; this overlays it. See src/catalog/.
model CatalogSnapshot {
  id                  String   @id @default("singleton")
  version             String
  sourceUrl           String
  payload             Json // the verified { version, templates } blob
  templateCount       Int
  etag                String?
  signatureVerifiedAt DateTime
  fetchedAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Instance-level settings (single row, fixed PK) — the source of truth for onboarding state,
// registration gating, edition, self-update and API gating. Consumed by later slices; created on
// first access via InstanceSettingsService (get-or-create).
model InstanceSettings {
  id                  String    @id @default("singleton")
  initializedAt       DateTime? // set when the first user registers (bootstrap complete)
  allowRegistration   Boolean   @default(false) // closed after the first user; owner re-opens or invites
  edition             String    @default("community") // community | pro | cloud
  publicUrl           String?
  acmeEmail           String?
  autoUpdate          Boolean   @default(false)
  updateChannel       String    @default("stable")
  cachedLatestVersion String?
  apiEnabled          Boolean   @default(true)
  apiAllowedIps       String[]  @default([])
  updatedAt           DateTime  @updatedAt
}
