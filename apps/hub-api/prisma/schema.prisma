// Tugra hub — Prisma schema v0 (Faz 0)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

enum ServerStatus {
  PENDING
  ONLINE
  OFFLINE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  name         String?
  twoFaSecret  String?
  twoFaEnabled Boolean      @default(false)
  memberships  Membership[]
  apiTokens    ApiToken[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ApiToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  memberships  Membership[]
  servers      Server[]
  monitors     Monitor[]
  channels     NotificationChannel[]
  applications Application[]
  databases    Database[]
  backupDestinations BackupDestination[]
  sharedVariables SharedVariable[]
  projects     Project[]
  invitations  TeamInvitation[]
  createdAt    DateTime     @default(now())
}

model TeamInvitation {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  email     String
  role      Role     @default(VIEWER)
  token     String   @unique
  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([teamId, email])
  @@index([email])
}

model Project {
  id           String        @id @default(cuid())
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  name         String
  environments Environment[]
  createdAt    DateTime      @default(now())

  @@index([teamId])
}

model Environment {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  createdAt DateTime @default(now())

  @@index([projectId])
}

model SharedVariable {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  key       String
  valueEnc  String
  createdAt DateTime @default(now())

  @@unique([teamId, key])
  @@index([teamId])
}

model Membership {
  id     String @id @default(cuid())
  role   Role   @default(VIEWER)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  @@unique([userId, teamId])
}

model Server {
  id                   String       @id @default(cuid())
  name                 String
  // "Sunucu Tuğrası" — the server's unique signed identity (set at enrollment).
  seal                 String?      @unique
  status               ServerStatus @default(PENDING)
  enrollToken          String       @unique
  enrollTokenExpiresAt DateTime?
  // ed25519 public key the agent generated on-box (private key never leaves it).
  agentPublicKey       String?
  agentVersion         String?
  hostname             String?
  os                   String?
  osVersion            String?
  arch                 String?
  kernel               String?
  cpuCores             Int?
  memTotalBytes        BigInt?
  bootTime             DateTime?
  cleanupEnabled       Boolean      @default(false)
  cleanupIntervalHours Int?
  cleanupVolumes       Boolean      @default(false)
  lastCleanupAt        DateTime?
  lastSeenAt           DateTime?
  team                 Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId               String
  metrics              Metric[]
  createdAt            DateTime     @default(now())
}

model Metric {
  id        String   @id @default(cuid())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String
  ts        DateTime @default(now())
  cpu       Float
  memUsed   BigInt
  memTotal  BigInt
  diskUsed  BigInt
  diskTotal BigInt
  netRx     BigInt
  netTx     BigInt

  @@index([serverId, ts])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum MonitorType {
  HTTP
  TCP
  METRIC
}

enum MonitorStatus {
  UP
  DOWN
  PENDING
}

model Monitor {
  id          String        @id @default(cuid())
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  name        String
  type        MonitorType
  target      String // url (HTTP) or host:port (TCP); a label for METRIC
  serverId    String?       // METRIC: which server's metrics to watch
  metric      String?       // METRIC: DISK | CPU | MEM
  thresholdPct Int?         // METRIC: alarm when usage >= this %
  intervalSec Int           @default(30)
  retries     Int           @default(1)
  timeoutMs   Int           @default(10000)
  resendEvery Int           @default(0) // re-notify every N consecutive down beats (0 = off)
  status      MonitorStatus @default(PENDING)
  failCount   Int           @default(0) // consecutive failures (for retry → DOWN)
  downCount   Int           @default(0) // consecutive down beats (for resend)
  enabled     Boolean       @default(true)
  heartbeats  Heartbeat[]
  channels    MonitorChannel[]
  createdAt   DateTime      @default(now())
}

model Heartbeat {
  id        String        @id @default(cuid())
  monitor   Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  status    MonitorStatus
  ms        Int // latency
  msg       String?
  important Boolean       @default(false)
  ts        DateTime      @default(now())

  @@index([monitorId, ts])
}

model NotificationChannel {
  id        String           @id @default(cuid())
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  name      String
  type      String // webhook | telegram | ntfy | discord | slack
  config    Json
  enabled   Boolean          @default(true)
  monitors  MonitorChannel[]
  createdAt DateTime         @default(now())
}

model MonitorChannel {
  monitor   Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String

  @@id([monitorId, channelId])
}

enum BulkTaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
}

model BulkOperation {
  id        String     @id @default(cuid())
  actorId   String
  command   String
  tasks     BulkTask[]
  createdAt DateTime   @default(now())
}

model BulkTask {
  id         String         @id @default(cuid())
  operation  BulkOperation  @relation(fields: [opId], references: [id], onDelete: Cascade)
  opId       String
  serverId   String
  status     BulkTaskStatus @default(PENDING)
  exitCode   Int?
  output     String?
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([opId])
}

enum AppStatus {
  NEW
  RUNNING
  STOPPED
  FAILED
}

enum AppSource {
  IMAGE
  GIT
  COMPOSE
}

enum BuildType {
  NIXPACKS
  DOCKERFILE
}

enum DeploymentStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum DbEngine {
  POSTGRES
  MYSQL
  REDIS
  MONGO
  MARIADB
  KEYDB
  DRAGONFLY
  CLICKHOUSE
}

enum DbStatus {
  NEW
  RUNNING
  STOPPED
  FAILED
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum DestType {
  LOCAL
  S3
}

model Application {
  id            String       @id @default(cuid())
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  environmentId  String?
  serverId       String
  name           String
  source         AppSource    @default(IMAGE)
  image          String?
  gitUrl         String?
  gitBranch      String?      @default("main")
  buildType      BuildType    @default(NIXPACKS)
  dockerfilePath String?
  composeFile    String?
  healthCmd      String?
  memoryMb       Int?
  cpus           Float?
  volumes        Json?
  gitTokenEnc     String?
  registryAuthEnc String?
  env            Json
  envEnc         String?
  hostPort       Int?
  containerPort  Int?         @default(80)
  domain         String?
  domainRedirect  String?
  securityHeaders Boolean     @default(false)
  https          Boolean      @default(true)
  status         AppStatus    @default(NEW)
  webhookToken   String?      @unique
  webhookSecret  String?
  deployments   Deployment[]
  createdAt     DateTime     @default(now())

  @@index([environmentId])
}

model Deployment {
  id          String           @id @default(cuid())
  application Application      @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId       String
  status      DeploymentStatus @default(RUNNING)
  logs        String?
  exitCode    Int?
  imageTag    String?
  createdAt   DateTime         @default(now())

  @@index([appId])
}

model Database {
  id          String   @id @default(cuid())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  environmentId String?
  serverId    String
  name        String
  engine      DbEngine
  version     String
  image       String
  port        Int
  hostPort    Int?
  credentials String
  status      DbStatus @default(NEW)
  backupEnabled       Boolean  @default(false)
  backupIntervalHours Int?
  backupRetention     Int      @default(7)
  backupDestinationId String?
  backups     Backup[]
  createdAt   DateTime @default(now())

  @@index([teamId])
  @@index([environmentId])
}

model BackupDestination {
  id                String   @id @default(cuid())
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String
  name              String
  type              DestType @default(S3)
  s3Bucket          String?
  s3Region          String?
  s3Endpoint        String?
  s3AccessKey       String?
  s3SecretKey       String?
  s3Prefix          String?
  encryptionEnabled Boolean  @default(false)
  encryptionKey     String?
  createdAt         DateTime @default(now())

  @@index([teamId])
}

model Backup {
  id          String       @id @default(cuid())
  database    Database     @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  databaseId  String
  status      BackupStatus @default(PENDING)
  filename    String
  path        String
  destinationId String?
  objectKey   String?
  sizeBytes   BigInt?
  createdBy   String
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([databaseId])
}
