// Tugra hub — Prisma schema v0 (Faz 0)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

enum ServerStatus {
  PENDING
  ONLINE
  OFFLINE
}

// Docker Swarm formation state of a Cluster. NONE = plain group. FORMING = a form/dissolve
// op is in flight (concurrency guard via CAS). ACTIVE = manager + every intended worker joined. DEGRADED =
// a real, working swarm short of its desired membership (re-run Form to reconcile). DISSOLVING = teardown.
enum SwarmStatus {
  NONE
  FORMING
  ACTIVE
  DEGRADED
  DISSOLVING
  JOINING
}

// A server's role in its cluster's swarm (null = not in a swarm).
enum SwarmRole {
  MANAGER
  WORKER
}

model User {
  id            String                  @id @default(cuid())
  email         String                  @unique
  password      String
  name          String?
  twoFaSecret   String?
  twoFaEnabled  Boolean                 @default(false)
  twoFaEnabledAt DateTime?
  emailVerified Boolean                 @default(false)
  emailVerifiedAt DateTime?
  uiMode        String                  @default("fleet") // "fleet" | "home"
  isInstanceOwner Boolean               @default(false) // the first user to register; owns instance-level settings
  memberships   Membership[]
  apiTokens     ApiToken[]
  savedViews    SavedView[]
  recoveryCodes TwoFactorRecoveryCode[]
  verificationTokens VerificationToken[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

// Purpose of an emailed single-use token. EMAIL_VERIFY is reserved for email verification;
// this table is shared so no new migration is needed.
enum VerificationPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// A single-use, expiring token delivered by email (password reset / email verification). Only the
// sha256 hash is stored — the raw token lives only in the emailed URL. Single-use via `usedAt`.
model VerificationToken {
  id        String              @id @default(cuid())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  purpose   VerificationPurpose
  tokenHash String              @unique
  email     String              // target email (forward-compat for email-change verify; = user.email for reset)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
}

// One-time 2FA recovery codes (hashed) — a fallback to log in when the TOTP device is lost.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  codeHash  String // sha256 of the canonical (dashless, upper-cased) code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A user's named fleet filter (status + tags) for the servers/fleet table.
model SavedView {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // null = personal (only the owner); set = shared with everyone on the team.
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String?
  name      String
  status    String? // ONLINE | PENDING | OFFLINE | null (all)
  tags      String[] @default([])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([teamId])
}

model ApiToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     String[]  @default(["read"]) // read | write | deploy | admin | read:secrets
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  iconUpdatedAt DateTime?  // list-view marker so the team list never reads the icon bytes
  icon         TeamIcon?
  memberships  Membership[]
  servers      Server[]
  monitors     Monitor[]
  channels     NotificationChannel[]
  applications Application[]
  databases    Database[]
  backupDestinations BackupDestination[]
  sharedVariables SharedVariable[]
  projects     Project[]
  invitations  TeamInvitation[]
  gitSources   GitSource[]
  registries   Registry[]
  cloudCredentials CloudCredential[]
  dnsCredentials   DnsCredential[]
  secretProviders  SecretProvider[]
  savedViews   SavedView[]
  customRoles  TeamRole[]
  clusters     Cluster[]
  createdAt    DateTime     @default(now())
}

// A team-defined named role with a granular set of resource permissions (see TEAM_PERMISSIONS in
// @tugra/shared). Assigned to a member via Membership.teamRoleId; grants ONLY resource permissions
// — member/role/team administration stays reserved for the built-in OWNER/ADMIN roles.
model TeamRole {
  id          String       @id @default(cuid())
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  name        String
  permissions String[]     @default([])
  memberships Membership[]
  createdAt   DateTime     @default(now())

  @@unique([teamId, name])
  @@index([teamId])
}

model TeamInvitation {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  email     String
  role      Role     @default(VIEWER)
  token     String   @unique
  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([teamId, email])
  @@index([email])
}

model Project {
  id           String        @id @default(cuid())
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  name         String
  isDefault    Boolean       @default(false) // the team's default project (exactly one per team)
  iconUpdatedAt DateTime?    // list-view marker so the project list never reads the icon bytes
  icon         ProjectIcon?
  environments Environment[]
  createdAt    DateTime      @default(now())

  @@index([teamId])
}

// A project's custom icon (square PNG), kept off the Project row (Project.iconUpdatedAt is the marker).
model ProjectIcon {
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String   @id
  mime       String   // always "image/png" (anything else is rejected at upload)
  data       Bytes
  sizeBytes  Int
  updatedAt  DateTime @updatedAt
}

// A team's custom icon (square PNG), kept off the Team row (Team.iconUpdatedAt is the marker).
model TeamIcon {
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String   @id
  mime       String   // always "image/png" (anything else is rejected at upload)
  data       Bytes
  sizeBytes  Int
  updatedAt  DateTime @updatedAt
}

// A database's custom icon (square PNG), kept off the Database row (Database.iconUpdatedAt is the marker).
model DatabaseIcon {
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  databaseId String   @id
  mime       String   // always "image/png" (anything else is rejected at upload)
  data       Bytes
  sizeBytes  Int
  updatedAt  DateTime @updatedAt
}

model Environment {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  isDefault Boolean  @default(false) // the project's default environment (exactly one per project)
  applications Application[]
  databases    Database[]
  createdAt DateTime @default(now())

  @@index([projectId])
}

model SharedVariable {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  key       String
  valueEnc  String
  createdAt DateTime @default(now())

  @@unique([teamId, key])
  @@index([teamId])
}

model Membership {
  id     String @id @default(cuid())
  role   Role   @default(VIEWER)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  // Optional custom role: when set, the member's resource permissions come from this TeamRole
  // instead of the built-in `role` tier. SetNull so deleting a role reverts members to `role`
  // (VIEWER by default). null → the built-in enum role is authoritative (no regression).
  teamRole   TeamRole? @relation(fields: [teamRoleId], references: [id], onDelete: SetNull)
  teamRoleId String?

  // Per-resource access scoping (least privilege). Opt-in via `restrictedAccess`: while false
  // (the default, and every existing member) the member has full access at their team role — no
  // regression. When true, a VIEWER only sees the granted projects (+ their resources) and any
  // explicitly granted resource ids. OWNER/ADMIN always bypass scoping (they manage the team).
  restrictedAccess  Boolean  @default(false)
  accessedProjects  String[] @default([]) // project ids this member may access when restricted
  accessedResources String[] @default([]) // app/db ids (fine-grained escape hatch + grant-on-create)

  @@unique([userId, teamId])
}

model Server {
  id                   String       @id @default(cuid())
  name                 String
  // The server seal ("Tugra"): the server's unique signed identity, set at enrollment.
  seal                 String?      @unique
  status               ServerStatus @default(PENDING)
  enrollToken          String       @unique
  enrollTokenExpiresAt DateTime?
  // ed25519 public key the agent generated on-box (private key never leaves it).
  agentPublicKey       String?
  agentVersion         String?
  hostname             String?
  publicIp             String?      // observed reachable IPv4 (or manual override)
  publicIpv6           String?      // observed reachable IPv6
  ipSource             String       @default("observed") // observed | reported | manual
  reportedIps          String[]     @default([]) // agent-reported candidate interface IPs (reconcile)
  wildcardDomain       String?      // per-server magic-domain root (e.g. apps.example.com); blank → sslip.io
  magicSuffix          String?      // override the global magic suffix ("sslip.io" | "nip.io")
  certMode             String       @default("http") // "http" | "le-dns" | "custom" — wildcard cert policy
  dnsProvider          String?      // lego/Traefik DNS provider for DNS-01 (cloudflare, route53, ...)
  dnsCredsEnc          String?      // encrypted JSON of provider env vars ({ CF_DNS_API_TOKEN: "..." })
  customCertResolver   String?      // Traefik resolver name when certMode = "custom"
  os                   String?
  osVersion            String?
  arch                 String?
  kernel               String?
  cpuCores             Int?
  memTotalBytes        BigInt?
  bootTime             DateTime?
  cleanupEnabled       Boolean      @default(false)
  cleanupIntervalHours Int?
  cleanupCron          String?      // optional 5-field cron; when set, overrides cleanupIntervalHours
  cleanupThresholdPct  Int?         // scheduled cleanup only prunes when disk usage % is at/above this (manual always runs)
  description          String?      // free-text operator note shown on the server page
  timezone             String?      // IANA tz (e.g. Europe/Istanbul); applied to the cleanup cron schedule
  cleanupVolumes       Boolean      @default(false)
  lastCleanupAt        DateTime?
  lastSeenAt           DateTime?
  team                 Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId               String
  // Optional membership in a Cluster (a named group of this team's servers). SetNull: deleting the
  // cluster frees its servers rather than removing them. A server belongs to at most one cluster.
  cluster              Cluster?     @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  clusterId            String?
  // Docker Swarm formation. Role in the cluster's swarm (null = not joined); the docker node id
  // (for promote/demote/rm); the last sanitized join/leave error for this node (NEVER raw command output).
  // multiple MANAGER rows per cluster are now expected (multi-manager Raft HA) — the manager SET is
  // derived live from every swarmRole=MANAGER row, NOT just Cluster.swarmManagerId (which is only the PRIMARY).
  swarmRole            SwarmRole?
  swarmNodeId          String?
  swarmError           String?
  tags                 String[]     @default([])
  // Granted agent capabilities the hub will sign commands for. Enforced verbatim; empty = none
  // (fail-safe). Legacy servers are backfilled to the full set by migration; new servers default
  // to all-except-terminal (least privilege — the interactive shell is opt-in).
  capabilities         String[]     @default([])
  // True for the box the hub itself runs on, auto-provisioned at first-owner registration on a turnkey
  // single-box install so the user never pastes an agent command. Drives home-mode
  // reachability heuristics. Manually-enrolled servers are false.
  isLocal              Boolean      @default(false)
  // How the server's reverse proxy publishes :80/:443: "public" (default, all interfaces)
  // | "loopback" (127.0.0.1 only, behind a front proxy) | "none" (no host port — tunnel-only, coexists with
  // another web server on the box). Applied when the proxy is (re)started.
  proxyBind            String       @default("public")
  // Cloud-provisioned servers only (null for manually-enrolled): the provider that created the VM,
  // its provider-side server id (needed to destroy it), and the credential used (SetNull so deleting
  // the credential leaves the server intact but drops its destroy-VM ability).
  provider             String?
  providerServerId     String?
  cloudCredential      CloudCredential? @relation(fields: [cloudCredentialId], references: [id], onDelete: SetNull)
  cloudCredentialId    String?
  metrics              Metric[]
  containerMetrics     ContainerMetric[]
  containerStates      ContainerState[]
  metricRollups        MetricRollup[]
  containerMetricRollups ContainerMetricRollup[]
  logDrains            LogDrain[]
  tunnel               ServerTunnel?
  createdAt            DateTime     @default(now())

  @@index([clusterId])
}

// A named group of a team's servers (fleet organization + rollup + group-scoped ops). Model-agnostic
// foundation: it does not change deploy/networking — deploy is still per-server. A server belongs to at
// most one cluster (Server.clusterId).
model Cluster {
  id          String   @id @default(cuid())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  name        String
  description String?
  servers     Server[]
  applications Application[] // apps deployed as swarm services onto this cluster
  // Docker Swarm formation. swarmManagerId is a loose FK to the PRIMARY manager Server.id — the node
  // the swarm-mode ingress is pinned to (by node label) and the default/fast-path dispatch target. // the FULL manager set is every Server with swarmRole=MANAGER for this cluster, not necessarily just this one
  // row (multi-manager Raft HA); this FK is NOT renamed, for API back-compat (SwarmView.managerServerId keeps
  // its meaning). Resolved in service code (matching Application.serverId convention — no @relation to avoid a
  // second Server↔Cluster relation). swarmLastError is a sanitized last error — NEVER raw command output/tokens.
  swarmStatus    SwarmStatus @default(NONE)
  swarmManagerId String?
  swarmLastError String?
  // desired swarm-ingress (Traefik) replica count for HA. 1 = today's single-node routing (default,
  // zero behavior change). 2-3 = routing-mesh multi-replica ingress; requires DNS-01 (le-dns) on the manager
  // and is capped at 3 to stay under Let's Encrypt's duplicate-certificate rate limit. The actual pool is
  // re-derived live on every ensure() (manager first, then online joined members), never snapshotted.
  ingressReplicas Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teamId, name])
  @@index([teamId])
}

model LogDrain {
  id           String   @id @default(cuid())
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId     String
  name         String
  type         String   @default("HTTP")
  endpoint     String
  authTokenEnc String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([serverId])
}

// Cloudflare Tunnel binding for a server (zero-IP expose). 1:1 with Server. Secrets
// (cfApiTokenEnc, cfTunnelTokenEnc) are libsodium-encrypted at rest and never returned.
model ServerTunnel {
  id               String   @id @default(cuid())
  server           Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId         String   @unique
  provider         String   @default("cloudflare")
  cfAccountId      String
  zoneName         String   // registrable CF zone owning the wildcard (e.g. "example.com")
  zoneId           String
  cfApiTokenEnc    String   // encrypted operator CF API token — NEVER returned/logged
  tunnelId         String?  // CF tunnel UUID, set once createTunnel succeeds (idempotent resume)
  tunnelName       String   // deterministic "tugra-<serverId>"
  cfTunnelTokenEnc String?  // encrypted cloudflared connector run-token
  dnsRecordId      String?  // CF DNS record id of the wildcard CNAME (exact teardown)
  status           String   @default("pending") // pending | connecting | connected | error | disabled
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Metric {
  id        String   @id @default(cuid())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String
  ts        DateTime @default(now())
  cpu       Float
  memUsed   BigInt
  memTotal  BigInt
  diskUsed  BigInt
  diskTotal BigInt
  netRx     BigInt
  netTx     BigInt
  diskRead  BigInt @default(0) // bytes/s; @default so the additive migration needs no backfill
  diskWrite BigInt @default(0)
  // Optional sensor metrics — NULL (not 0) when the host exposes none (most cloud VMs), so the UI can
  // render "—" rather than a fake reading. gpu* are aggregates over all GPUs (max util/temp, summed
  // VRAM); `detail` keeps the per-sensor map + per-GPU list for the detail view.
  temp         Float?
  gpuUtil      Float?
  gpuMemUsed   BigInt?
  gpuMemTotal  BigInt?
  gpuTemp      Float?
  batteryPct   Float?
  batteryState String?
  detail       Json?

  @@index([serverId, ts])
  @@index([ts]) // for the retention prune (deleteMany where ts < cutoff, across all servers)
}

// Per-container resource usage from the agent's `docker stats`. containerName is the STABLE key
// (containerId changes on restart); net/block are rates (B/s) the agent derives from cumulative
// deltas. Unbounded until a retention prune scheduler is added (@@index([ts]) is for that).
model ContainerMetric {
  id            String   @id @default(cuid())
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  containerName String
  containerId   String
  ts            DateTime @default(now())
  cpu           Float
  memUsed       BigInt
  memTotal      BigInt
  memPct        Float
  netRx         BigInt
  netTx         BigInt
  blkRead       BigInt
  blkWrite      BigInt

  @@index([serverId, containerName, ts])
  @@index([ts])
}

// Last-known lifecycle state of each container on a server, for crash/OOM TRANSITION detection by the
// container-health poll (server-ops/container-health.*). One row per (server, containerName) — the stable
// key, since containerId changes on recreate. Persisted (not in-memory) so a hub restart never re-seeds or
// double-alerts. Rows for containers no longer present are deleted each tick (bounded).
model ContainerState {
  server               Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId             String
  containerName        String
  containerId          String
  status               String // running | exited | restarting | dead | created | paused
  exitCode             Int       @default(0)
  oomKilled            Boolean   @default(false)
  restartCount         Int       @default(0)
  startedAt            DateTime?
  finishedAt           DateTime?
  health               String? // healthy | unhealthy | starting | null (recorded, not alerted in v1)
  lastEventTs          BigInt    @default(0) // newest docker-event epoch consumed → next tick's --since cursor
  lastNotifiedKey      String? // `${containerId}:${restartCount}:${finishedAt}` of the last alerted death
  lastNotifiedAt       DateTime?
  restartCountAtNotify Int       @default(0)
  updatedAt            DateTime  @updatedAt

  @@id([serverId, containerName])
  @@index([updatedAt])
}

// 1-minute rollup of host Metric rows (avg/max per bucket) — lets long-range charts survive past the
// raw retention window. Populated by the rollup scheduler; one row per (serverId, minute bucket).
model MetricRollup {
  id           String   @id @default(cuid())
  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId     String
  bucket       DateTime // minute-truncated
  avgCpu       Float
  maxCpu       Float
  avgMemUsed   BigInt
  avgMemTotal  BigInt
  avgDiskUsed  BigInt
  avgDiskTotal BigInt
  avgNetRx     BigInt
  avgNetTx     BigInt
  avgDiskRead  BigInt
  avgDiskWrite BigInt

  @@unique([serverId, bucket])
  @@index([bucket]) // for the rollup retention prune (deleteMany where bucket < cutoff)
}

// 1-minute rollup of ContainerMetric rows, one row per (serverId, containerName, minute bucket).
model ContainerMetricRollup {
  id            String   @id @default(cuid())
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  containerName String
  bucket        DateTime
  avgCpu        Float
  maxCpu        Float
  avgMemUsed    BigInt
  avgMemTotal   BigInt
  avgMemPct     Float
  avgNetRx      BigInt
  avgNetTx      BigInt
  avgBlkRead    BigInt
  avgBlkWrite   BigInt

  @@unique([serverId, containerName, bucket])
  @@index([bucket])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([target, createdAt]) // per-resource audit (GET /apps|servers|databases/:id/audit) filters by target
  @@index([actor, createdAt]) // actor-scoped list + Pro export (WHERE actor IN (...) ORDER BY createdAt)
}

enum MonitorType {
  HTTP
  TCP
  METRIC
}

enum MonitorStatus {
  UP
  DOWN
  PENDING
}

model Monitor {
  id          String        @id @default(cuid())
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  name        String
  type        MonitorType
  target      String // url (HTTP) or host:port (TCP); a label for METRIC
  serverId    String?       // METRIC: which server's metrics to watch
  metric      String?       // METRIC: DISK | CPU | MEM
  thresholdPct Int?         // METRIC: alarm when usage >= this %
  intervalSec Int           @default(30)
  retries     Int           @default(1)
  timeoutMs   Int           @default(10000)
  resendEvery Int           @default(0) // re-notify every N consecutive down beats (0 = off)
  status      MonitorStatus @default(PENDING)
  failCount   Int           @default(0) // consecutive failures (for retry → DOWN)
  downCount   Int           @default(0) // consecutive down beats (for resend)
  enabled     Boolean       @default(true)
  // Auto-created uptime monitor for an app's domain (auto=true, appId set).
  appId       String?
  auto        Boolean       @default(false)
  heartbeats  Heartbeat[]
  channels    MonitorChannel[]
  createdAt   DateTime      @default(now())

  @@index([appId])
}

model Heartbeat {
  id        String        @id @default(cuid())
  monitor   Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  status    MonitorStatus
  ms        Int // latency
  msg       String?
  important Boolean       @default(false)
  ts        DateTime      @default(now())

  @@index([monitorId, ts])
  @@index([ts]) // for the retention prune (deleteMany where ts < cutoff AND important = false)
}

model NotificationChannel {
  id         String                 @id @default(cuid())
  team       Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId     String
  name       String
  type       String // webhook | telegram | ntfy | discord | slack | smtp | gotify
  configEnc  String // encrypted JSON config (secrets never stored plaintext)
  enabled    Boolean                @default(true)
  eventTypes String[]               @default([]) // deploy_success | deploy_failed | server_offline …
  locale     String                 @default("en") // notification language (server-side i18n)
  monitors   MonitorChannel[]
  deliveries NotificationDelivery[]
  createdAt  DateTime               @default(now())
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

// Per-attempt delivery record for a fired notification — the durable audit/history behind the queue
// (BullMQ retries feed status FAILED → DEAD). Message content is snapshotted; config secrets never are.
model NotificationDelivery {
  id        String                     @id @default(cuid())
  channel   NotificationChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String
  event     String
  level     String
  title     String
  summary   String
  status    NotificationDeliveryStatus @default(PENDING)
  attempts  Int                        @default(0)
  lastError String?
  createdAt DateTime                   @default(now())
  sentAt    DateTime?

  @@index([channelId, createdAt])
  @@index([status])
}

model MonitorChannel {
  monitor   Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String

  @@id([monitorId, channelId])
}

// A registered Git provider app (GitHub App) for private-repo deploys.
model GitSource {
  id               String        @id @default(cuid())
  team             Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId           String
  name             String
  provider         String        @default("github")
  appId            String
  appSlug          String?
  clientId         String?
  clientSecretEnc  String?
  privateKeyEnc    String
  webhookSecretEnc String?
  installationId   String?
  htmlUrl          String?
  applications     Application[]
  createdAt        DateTime      @default(now())

  @@index([teamId])
}

// A team-scoped container registry for pushing built images (portable rollback / multi-server).
model Registry {
  id           String        @id @default(cuid())
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId       String
  name         String
  type         String        @default("generic") // dockerhub | ghcr | gitlab | generic
  url          String?       // registry host (blank → Docker Hub); e.g. ghcr.io, registry.gitlab.com
  username     String
  passwordEnc  String        // encrypted registry password / access token
  imagePrefix  String?       // namespace/org under which images are pushed (e.g. myorg)
  applications Application[]
  createdAt    DateTime      @default(now())

  @@index([teamId])
}

/// A team's cloud-provider API credential (Hetzner, and later DigitalOcean/Vultr) used to provision
/// servers. The API token is encrypted at rest and NEVER returned in any view.
model CloudCredential {
  id          String   @id @default(cuid())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  name        String
  provider    String   // "hetzner" | "digitalocean" | "vultr" — only "hetzner" has a client in v1
  apiTokenEnc String   // encrypted cloud API token — never returned/logged
  servers     Server[]
  createdAt   DateTime @default(now())

  @@index([teamId])
}

// Team-scoped DNS-provider API credential (one-click custom-domain DNS auto-setup). Mirrors CloudCredential:
// the token is verified against the provider BEFORE encrypt+persist and is NEVER returned/logged.
model DnsCredential {
  id             String    @id @default(cuid())
  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId         String
  name           String
  provider       String    // "cloudflare" — only provider with a client in v1
  apiTokenEnc    String    // encrypted DNS-provider API token — never returned/logged
  cfAccountId    String?   // optional Cloudflare account id (not needed for plain DNS-record writes)
  lastVerifiedAt DateTime?
  domains        Domain[]  // domains whose auto-setup used this credential (SetNull on delete)
  createdAt      DateTime  @default(now())

  @@index([teamId])
}

enum BulkTaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
  // Added for multi-step orchestrated operations (e.g. the importer executor):
  ROLLED_BACK // a completed item whose created resources were undone by a rollback
  FAILED_VERIFY // the step ran but a post-step verification (row counts, health) failed
  AWAITING_CUTOVER // staged and ready, waiting for an explicit cutover step
  CANCELLED // a not-yet-started item abandoned because the operation was cancelled
}

model BulkOperation {
  id      String @id @default(cuid())
  actorId String
  // `command` is the raw fan-out command for kind="command" (the original/only use); orchestrated kinds
  // (e.g. kind="import") leave it empty and describe the work on the tasks instead.
  command String
  // Generalization for orchestrated operations. kind="command" is the legacy fan-out path, unchanged.
  kind      String     @default("command")
  planId    String? // the ImportPlan (or similar) this operation executes, when applicable
  meta      Json? // operation-level metadata (secret-free), e.g. the import source + target server
  // Cooperative cancel: set by a cancel request; the in-flight fan-out reads it before starting each
  // remaining task and stops launching new ones (a task already RUNNING is left to finish).
  cancelRequestedAt DateTime?
  // One-time importer MIGRATION token (S2). Source-agnostic: an untrusted source host presents it
  // (Authorization: Bearer tugra_mig_…) to stream migration artifacts to the hub; the guard resolves the
  // opId from the token alone (the host never names the destination). Only the SHA-256 is stored (mirrors
  // ApiToken.tokenHash — the enroll token's plaintext storage is deliberately NOT copied). NULL = no live
  // token; revoke = null both columns, so the unique-hash lookup simply stops matching.
  migrationTokenHash      String?   @unique
  migrationTokenExpiresAt DateTime?
  tasks     BulkTask[]
  createdAt DateTime   @default(now())
}

model BulkTask {
  id         String         @id @default(cuid())
  operation  BulkOperation  @relation(fields: [opId], references: [id], onDelete: Cascade)
  opId       String
  serverId   String
  status     BulkTaskStatus @default(PENDING)
  exitCode   Int?
  output     String?
  // Generalization: a task can be one typed item of an orchestrated plan rather than a shell command.
  kind         String   @default("command") // "command" (legacy) | "app" | "database" | "volume" | ...
  itemRef      String? // the plan item this task realizes (idempotency key on re-run)
  resourceType String? // the Tugra resource this task created, for rollback (e.g. "database")
  resourceId   String? // its id
  result       Json? // structured result (secret-free)
  steps        Json? // ordered [{ name, status, startedAt?, finishedAt?, detail? }] for multi-step items
  dependsOn    String[] @default([]) // itemRefs that must finish first (topological ordering)
  compensation Json? // how to undo this task's effect on rollback
  startedAt    DateTime?
  finishedAt   DateTime?

  @@unique([opId, itemRef]) // idempotency: one task per plan item per operation (legacy null itemRefs are distinct)
  @@index([opId])
}

/// A short-lived, encrypted connection to an external source PaaS (e.g. Coolify) for the importer. The API
/// token is stored encrypted-at-rest (CryptoService); baseUrl is non-secret. Scoped to a team + its creator.
model ImportSession {
  id         String    @id @default(cuid())
  teamId     String
  actorId    String
  sourceKind String // "coolify" (future: dokploy | caprover | dokku)
  baseUrl    String // the external instance base URL (non-secret)
  tokenEnc   String // CryptoService-encrypted API token — never returned by any endpoint
  status     String    @default("active") // active | revoked
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([teamId])
}

enum AppStatus {
  NEW
  RUNNING
  STOPPED
  FAILED
}

enum AppSource {
  IMAGE
  GIT
  COMPOSE
}

enum BuildType {
  NIXPACKS
  DOCKERFILE
  STATIC
  RAILPACK
  HEROKU
}

enum DeploymentStatus {
  QUEUED // waiting for the app's in-flight deploy to finish (one RUNNING deploy per app at a time)
  RUNNING
  SUCCESS
  FAILED
  CANCELLED // a QUEUED deploy dropped before it started (by the user, a newer push, or a hub restart)
}

enum DbEngine {
  POSTGRES
  MYSQL
  REDIS
  MONGO
  MARIADB
  KEYDB
  DRAGONFLY
  CLICKHOUSE
  LIBSQL
}

enum DbStatus {
  NEW
  RUNNING
  STOPPED
  FAILED
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model VolumeBackup {
  id            String       @id @default(cuid())
  app           Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId         String
  volumeName    String
  status        BackupStatus @default(PENDING)
  filename      String
  path          String
  destinationId String?
  objectKey     String?
  sizeBytes     BigInt?
  createdBy     String
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([appId])
}

enum DestType {
  LOCAL
  S3
}

model Application {
  id            String       @id @default(cuid())
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  environment    Environment  @relation(fields: [environmentId], references: [id], onDelete: NoAction)
  environmentId  String
  serverId       String
  buildServerId  String?      // optional separate build server (build+push there, pull+run on serverId)
  // Swarm service deploy: when clusterId is set the app deploys as a `docker service --replicas N`
  // onto this cluster's swarm (commands target cluster.swarmManagerId, re-resolved fresh — never snapshotted).
  // serverId stays required as the ingress/monitoring anchor. SetNull: deleting the cluster falls the app
  // back to classic single-server deploy rather than deleting it.
  cluster        Cluster?     @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  clusterId      String?
  replicas       Int?         // swarm service replica count (null = classic single-server deploy)
  placement      Json?        // { constraints: PlacementConstraint[], spreadLabelKey: string|null } — structured, picker-sourced, never a raw docker expression from the client
  constraintServerId String?   // system hard-pin for a stateful (named-volume) app — the Server whose swarm node its single replica must run on; loose FK like swarmManagerId, resolved in service code
  name           String
  templateSlug   String?      // catalog slug when installed from a template (for its logo)
  // A user-uploaded custom icon lives in the sibling AppIcon table (bytes kept out of this hot row). This
  // nullable marker is set to the upload time and cleared on removal: the app list reads it to know whether
  // an icon exists and to cache-bust the icon URL, without ever fetching the image bytes.
  iconUpdatedAt  DateTime?
  source         AppSource    @default(IMAGE)
  image          String?
  gitUrl         String?
  gitBranch      String?      @default("main")
  buildType      BuildType    @default(NIXPACKS)
  dockerfilePath String?
  dockerBuildTarget String?   // DOCKERFILE build: multi-stage target stage (docker build --target)
  baseDirectory  String? // monorepo: repo-relative subdirectory used as the build context/root (GIT apps)
  // Watch paths: glob patterns (repo-relative, leading `!` = exclude). When non-empty, a git push only
  // triggers a deploy if a changed file matches — so a monorepo doesn't rebuild every app on every push.
  // Empty = deploy on every push (the default / backward-compatible behaviour).
  watchPaths     String[] @default([])
  // Per-app push-to-deploy switch. True (default) = a matching git push auto-deploys; false = the push is
  // acknowledged but ignored (pause auto-deploy without deleting the webhook). Preview deploys are separate.
  autoDeploy     Boolean  @default(true)
  // Env var names dropped from a PR preview's copied env (so prod secrets never leak into an ephemeral
  // preview). Empty = the preview inherits the full parent env (unchanged default).
  previewExcludeKeys String[] @default([])
  // Max concurrent PR previews for this app; when a new PR would exceed it, the oldest preview is evicted.
  // Null = unlimited (the default).
  previewLimit   Int?
  buildCommand   String?
  outputDir      String?
  composeFile    String?
  // COMPOSE-from-git: when set (with source=COMPOSE + gitUrl), the compose file lives in the cloned repo at
  // this repo-relative path instead of being pasted/stored in composeFile. The two are mutually exclusive;
  // composePath != null is the discriminator for a git-sourced compose stack.
  composePath    String?
  healthCmd      String?
  healthCheckType String?                          // null = auto | "NONE" | "HTTP" | "CMD" — deploy-gate health policy
  healthCheckPath String?                          // HTTP check path (default "/")
  healthCheckPort Int?                             // HTTP check port (default container/host port)
  // Tunable health-check timings (seconds; null = built-in default). Drive both the deploy health-gate and
  // the container's docker --health-* flags; startPeriod/retries widen the window for a slow-booting app.
  healthInterval    Int?
  healthTimeout     Int?
  healthRetries     Int?
  healthStartPeriod Int?
  healthExpectedStatus Int?                        // HTTP check: require this exact status (else any code < 500)
  memoryMb       Int?
  cpus           Float?
  reserveMemoryMb Int?        // soft swarm scheduling hint (--reserve-memory); swarm-only, advisory
  reserveCpus    Float?       // soft swarm scheduling hint (--reserve-cpu); swarm-only, advisory
  gpus           String?      // docker --gpus value (e.g. "all", "1", "device=0,1"); null = no GPU
  deployTimeoutSec Int?
  preDeployCommand  String?    // shell command run (in a one-shot container of the new image) before the swap — e.g. DB migrations
  postDeployCommand String?    // shell command run (inside the live container) after the health gate passes
  volumes        Json?
  hostMounts     Json?        // [{hostPath, containerPath, readOnly}] — host directory bind-mounts (validated vs the sensitive-path denylist)
  portMappings   Json?        // [{serviceName, containerPort, hostPort, mode}] — install-time allocated host ports
  installConfig  Json?        // redacted user field selections captured at template install (never secret values)
  configMounts   Json?        // [{serviceName, target, content, mode}] — template config files materialized + bound at deploy (${KEY} placeholders, never resolved secrets)
  gitTokenEnc     String?
  // SSH deploy key for cloning a private repo over git@/ssh:// — a generated ed25519 keypair. gitSshKeyEnc
  // is the encrypted OpenSSH private key (never returned); gitSshPublicKey is the public line the operator
  // adds to the repo as a read-only deploy key.
  gitSshKeyEnc    String?
  gitSshPublicKey String?
  gitSource       GitSource?   @relation(fields: [gitSourceId], references: [id], onDelete: SetNull)
  gitSourceId     String?
  registryAuthEnc String?
  registry        Registry?    @relation(fields: [registryId], references: [id], onDelete: SetNull)
  registryId      String?      // team registry to push the built image to (when pushToRegistry)
  pushToRegistry  Boolean      @default(false)
  env            Json
  envEnc         String?
  buildArgsEnc   String?
  dockerOptions  String?
  // IMAGE/GIT classic (docker run) container command override, exec-form argv (string[]). Replaces the image
  // ENTRYPOINT / CMD. containerEntrypoint [] clears the image entrypoint; null on either = image default.
  containerEntrypoint Json?
  containerCommand    Json?
  dbNetwork      Boolean      @default(false) // opt-in: also attach this app to the node-local managed-DB network (tugra-net) so it resolves tugra_db_<id> by name
  hostPort       Int?
  containerPort  Int?         @default(80)
  // Extra published ports beyond the ingress one: [{hostPort, containerPort, protocol: "tcp"|"udp"}].
  // Emitted as additional docker -p flags (classic apps). Null/empty = just the single ingress port.
  extraPorts     Json?
  domain         String?
  extraDomains   String[]     @default([]) // additional hostnames (aliases) routed to the same container as `domain`
  domainRedirect  String?
  securityHeaders Boolean     @default(false)
  forwardAuth    String?
  // IP allowlist (CIDRs/addresses) → a Traefik ipallowlist middleware admitting only these source ranges.
  // Empty = open to all (the default). Applies on the next deploy.
  ipAllowlist    String[]    @default([])
  // HTTP Basic Auth users as [{user, hash}] — hash is a Traefik-compatible bcrypt htpasswd hash (the
  // plaintext password is never stored). Null/empty = no basic auth. Applies on the next deploy.
  basicAuthUsers Json?
  // Path-prefix routing: serve the app under <domain>/<pathPrefix> (Traefik PathPrefix). Null = host root.
  // stripPrefix (default true) removes the prefix before forwarding to the backend. Applies on next deploy.
  pathPrefix     String?
  stripPrefix    Boolean      @default(true)
  // Per-app rate limit {average, burst, period:'1s'|'1m'|'1h'} → a Traefik ratelimit middleware. Null = off.
  rateLimit      Json?
  // Custom redirect rules [{regex, replacement, permanent}] → one Traefik redirectregex middleware each,
  // applied to the router (after the www/root canonical redirect, before security headers). Null/empty = none.
  redirects      Json?
  https          Boolean      @default(true)
  domainKind     String       @default("none")  // "none" | "magic" | "custom" — is the domain user-set or generated
  exposeMode     String       @default("magic") // create preference: "magic" | "port" | "none" | "custom"
  tunnelExposed  Boolean      @default(false)   // per-app opt-in: route this app's hostname through the server's Cloudflare Tunnel
  certType       String       @default("http")  // "http" | "none" | "le-http" | "le-dns" | "custom"
  // Operator-uploaded custom TLS cert (certType "custom"): Traefik serves it statically by SNI (no ACME).
  // certPem is the public chain; certKeyEnc is the encrypted private key; certDomains/certNotAfter are
  // parsed at upload for display. All null unless a custom cert was uploaded.
  certPem        String?
  certKeyEnc     String?
  certDomains    String[]     @default([])
  certNotAfter   DateTime?
  deployStrategy String       @default("ROLLING") // "ROLLING" (zero-downtime) | "RECREATE"
  rollbackOnFailure Boolean   @default(true)      // auto-rollback to the previous version on a failed health gate
  status         AppStatus    @default(NEW)
  webhookToken   String?      @unique
  webhookSecret  String?
  // Preview deployments (B6): a preview is a throwaway clone of a parent app
  // created per pull-request; the parent opts in via previewEnabled.
  isPreview      Boolean      @default(false)
  previewEnabled Boolean      @default(false)
  prNumber       Int?
  parentAppId    String?
  tags           String[]     @default([])
  // Volume backups (Dokploy parity): back up the app's named volumes to a destination.
  volumeBackupEnabled       Boolean @default(false)
  volumeBackupIntervalHours Int?
  volumeBackupRetention     Int     @default(7)
  volumeBackupDestinationId String?
  volumeBackups  VolumeBackup[]
  parent         Application?  @relation("AppPreviews", fields: [parentAppId], references: [id], onDelete: Cascade)
  previews       Application[] @relation("AppPreviews")
  deployments   Deployment[]
  scheduledTasks ScheduledTask[]
  domains        Domain[]
  serviceDomains AppServiceDomain[]
  databaseLinks AppDatabaseLink[]
  secretRefs    SecretRef[]
  icon          AppIcon?
  createdAt     DateTime     @default(now())

  @@index([environmentId])
  @@index([parentAppId])
}

// A per-app custom icon (user-uploaded PNG), stored inline in Postgres so it rides the normal DB backups —
// no object store or host volume to manage. One row per app (appId is the PK, Cascade so it dies with the
// app). The bytes are small (a square PNG, validated by signature/IHDR/IEND + 32-512px, capped at 64KB) but are
// deliberately kept out of the hot Application row; Application.iconUpdatedAt is the list-view marker so the
// app list never has to read these bytes.
model AppIcon {
  app        Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId      String      @id
  mime       String      // always "image/png" (anything else is rejected at upload)
  data       Bytes
  sizeBytes  Int
  updatedAt  DateTime    @updatedAt
}

// Attach a managed Database to an Application so its connection URI is auto-injected into the app's
// runtime env at deploy time (recomputed fresh each deploy). v1 is node-local (tugra-net) internal
// linking only — see src/applications/db-link.ts for eligibility. The databaseId FK is NoAction (not
// Cascade): deleting a database that still has links is refused (409) rather than silently breaking the
// app; a whole-team delete still cascades because NoAction is checked at end-of-statement.
model AppDatabaseLink {
  id         String      @id @default(cuid())
  app        Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId      String
  database   Database    @relation(fields: [databaseId], references: [id], onDelete: NoAction)
  databaseId String
  envVar     String // env var name the connection URI is injected under (e.g. DATABASE_URL)
  createdBy  String? // user id who created the link (audit convenience)
  createdAt  DateTime    @default(now())

  @@unique([appId, databaseId])
  @@unique([appId, envVar])
  @@index([databaseId])
}

// A team-scoped external secret-store credential (HashiCorp Vault in v1; Infisical/AWS-SM are future kinds
// that slot in as new clients with no model change). Mirrors DnsCredential: the access token is verified
// against the store BEFORE it is encrypted+persisted, is NEVER returned by any view/log, and management is
// gated by the `integrations` team permission. The deploy env resolver fetches referenced secrets through
// this credential at deploy time; the fetched VALUES are injected transiently and never persisted.
model SecretProvider {
  id             String      @id @default(cuid())
  team           Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId         String
  name           String
  kind           String      // "vault" — only kind with a client in v1
  address        String      // the store's base URL (non-secret), e.g. https://vault.example.com
  tokenEnc       String      // CryptoService-encrypted access token — never returned/logged
  lastVerifiedAt DateTime?
  refs           SecretRef[]
  createdAt      DateTime    @default(now())

  @@index([teamId])
}

// A per-app binding: inject the value of an external secret (located by `remoteKey` in `provider`) into the
// app's runtime env under `envVar`, resolved FRESH at deploy time. Mirrors AppDatabaseLink. Only the LOCATOR
// is stored here, never the secret value. The providerId FK is NO ACTION (not Cascade): deleting a provider
// that still has refs is refused at the app layer (409) rather than silently breaking the app, while a
// whole-team delete still cascades (NO ACTION is checked at end-of-statement, after the app's refs die with
// the app). A ref whose value cannot be fetched FAILS the deploy loudly (never a silent empty value).
model SecretRef {
  id         String         @id @default(cuid())
  app        Application    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId      String
  provider   SecretProvider @relation(fields: [providerId], references: [id], onDelete: NoAction)
  providerId String
  envVar     String // env var name the fetched secret value is injected under
  remoteKey  String // provider-specific locator; Vault: "<mount>/<path>#<field>" e.g. "secret/myapp#DB_PASSWORD"
  createdBy  String? // user id who created the ref (audit convenience)
  createdAt  DateTime       @default(now())

  @@unique([appId, envVar])
  @@index([appId])
  @@index([providerId])
}

/**
 * A custom domain that Tugra set up DNS for on an app (one-click Cloudflare auto-setup). Tracks which provider
 * credential + zone were used and which records were written, so the UI can show status and a later change can
 * clean the records up when the domain changes or the app is deleted. `recordIds` is a JSON array of
 * { type, name, recordId }. `mode` is "auto" (Tugra created the records) or "manual" (operator copied them).
 */
// Per-service domain for a COMPOSE app: routes a named compose service (on a container port) to its own
// hostname via a dedicated Traefik router in the deploy override. Distinct from Domain (DNS automation).
model AppServiceDomain {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  service       String // the compose service name
  hostname      String      @unique // one app may claim a host; cross-app uniqueness enforced here
  port          Int // the service's container port to route to
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model Domain {
  id              String      @id @default(cuid())
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   String
  hostname        String      // the custom domain, e.g. "app.example.com"
  apex            Boolean     @default(false) // hostname is the zone root (so a www CNAME applies)
  provider        String      // "cloudflare"
  dnsCredential   DnsCredential? @relation(fields: [dnsCredentialId], references: [id], onDelete: SetNull)
  dnsCredentialId String?     // the DnsCredential used (SetNull: deleting the credential keeps the history)
  zoneId          String?     // provider zone the records live in
  recordIds       Json?       // [{ type, name, recordId }] — what was written, for cleanup
  mode            String      @default("auto") // "auto" | "manual"
  status          String      @default("pending") // "pending" | "active" | "error"
  lastError       String?
  lastCheckedAt   DateTime?
  createdAt       DateTime    @default(now())

  @@unique([applicationId, hostname])
  @@index([applicationId])
  @@index([dnsCredentialId])
}

model ScheduledTask {
  id          String      @id @default(cuid())
  application Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId       String
  name        String
  schedule    String
  command     String
  enabled     Boolean      @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime     @default(now())

  @@index([appId])
}

model Deployment {
  id          String           @id @default(cuid())
  application Application      @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId       String
  status      DeploymentStatus @default(RUNNING)
  kind        String           @default("DEPLOY") // "DEPLOY" | "ROLLBACK" | "AUTO_ROLLBACK"
  logs        String?
  exitCode    Int?
  imageTag    String?
  registryImage String?   // registry ref this deploy pushed to (for portable rollback pull)
  imageDigest String?     // resolved upstream digest of the pulled IMAGE (nginx@sha256:…) — provenance + byte-exact rollback
  // Redacted config snapshot this deploy ran with (secrets fingerprinted, not stored).
  configSnapshot Json?
  durationMs    Int?           // wall-clock ms from start (startedAt) to terminal status; null for legacy/queued/running rows
  trigger       String?        // what initiated this run: "manual" | "webhook" | "preview" | "rollback"; null for legacy rows
  noCache       Boolean  @default(false) // queued deploys carry their --no-cache choice until they start
  requestedBy   String?        // actor that enqueued this deploy (userId | "webhook" | "webhook:pr"); drives trigger + audit
  startedAt     DateTime?      // when the row moved QUEUED -> RUNNING; null while queued (durationMs measures from here)
  commitSha     String?        // deployed git commit (GIT source only); null otherwise
  commitMessage String?        // first line of the deployed commit's message (GIT source only), capped + sanitized
  createdAt   DateTime         @default(now())

  // NOTE: a partial unique index `deployment_one_running_per_app ON Deployment(appId) WHERE status='RUNNING'`
  // enforces one RUNNING deploy per app at the DB level (Prisma can't model partial indexes — see the
  // 20261030170000_deploy_queue migration). It is the backstop for the queue's SELECT ... FOR UPDATE claim.
  @@index([appId])
  @@index([appId, status])
}

model Database {
  id          String   @id @default(cuid())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: NoAction)
  environmentId String
  serverId    String
  name        String
  engine      DbEngine
  version     String
  image       String
  port        Int
  hostPort    Int?
  credentials String
  status      DbStatus @default(NEW)
  iconUpdatedAt DateTime?    // list-view marker so the database list never reads the icon bytes
  icon         DatabaseIcon?
  healthCmd      String?
  memoryMb       Int?
  cpus           Float?
  backupEnabled       Boolean  @default(false)
  backupIntervalHours Int?
  // Optional 5-field cron (e.g. "0 3 * * *" = 03:00 daily); when set it drives the schedule and overrides
  // backupIntervalHours — so "daily at 03:00" instead of "every 24h from whenever".
  backupCron          String?
  backupRetention     Int      @default(7)
  // Optional age-based retention: also delete SUCCESS backups older than N days (alongside the keep-N count).
  backupRetentionDays Int?
  backupDestinationId String?
  tags        String[] @default([])
  backups     Backup[]
  restores    Restore[]
  appLinks    AppDatabaseLink[]
  createdAt   DateTime @default(now())

  @@index([teamId])
  @@index([environmentId])
}

model BackupDestination {
  id                String   @id @default(cuid())
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String
  name              String
  type              DestType @default(S3)
  s3Bucket          String?
  s3Region          String?
  s3Endpoint        String?
  s3AccessKey       String?
  s3SecretKey       String?
  s3Prefix          String?
  encryptionEnabled Boolean  @default(false)
  encryptionKey     String?
  createdAt         DateTime @default(now())

  @@index([teamId])
}

enum RestoreKind {
  RESTORE
  RESTORE_TO
  IMPORT_URL
}

enum RestoreStatus {
  RUNNING
  SUCCESS
  FAILED
}

// A restore attempt + its outcome (so a failed restore is recorded, surfaced,
// and alerted on — not silently reported as success).
model Restore {
  id               String        @id @default(cuid())
  database         Database      @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  databaseId       String        // the database restored INTO
  backupId         String?       // source backup (may be deleted later → no FK)
  sourceDatabaseId String?       // source DB for a cross-resource restore-to
  kind             RestoreKind
  status           RestoreStatus @default(RUNNING)
  exitCode         Int?
  errorTail        String?       // last ~2KB of output; writer-only exposure
  createdBy        String
  createdAt        DateTime      @default(now())
  completedAt      DateTime?

  @@index([databaseId, createdAt])
}

model Backup {
  id          String       @id @default(cuid())
  database    Database     @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  databaseId  String
  status      BackupStatus @default(PENDING)
  filename    String
  path        String
  destinationId String?
  objectKey   String?
  sizeBytes   BigInt?
  createdBy   String
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([databaseId])
}

// Scheduled backup of the HUB's OWN Postgres (control-plane DB). Singleton (fixed PK), off by default.
// destinationId is a soft ref to BackupDestination (null => LOCAL /etc/tugra/backups/hub); no FK, like
// Database.backupDestinationId. Kept out of InstanceSettings (already a grab-bag) for an isolated migration.
model HubBackupConfig {
  id            String   @id @default("singleton")
  enabled       Boolean  @default(false)
  intervalHours Int      @default(24)
  retention     Int      @default(7)
  destinationId String?
  updatedAt     DateTime @updatedAt
}

// Hub-backup run history. Mirrors Backup minus the database FK; reuses BackupStatus. errorTail is
// scrubRestoreOutput()'d (never raw tenant data). Rows live inside the DB they describe — the runner's
// stale-RUNNING reaper fixes rows that a restore brings back mid-flight.
model HubBackup {
  id            String       @id @default(cuid())
  status        BackupStatus @default(PENDING)
  filename      String
  path          String
  destinationId String?
  objectKey     String?
  sizeBytes     BigInt?
  errorTail     String?
  createdBy     String
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([createdAt])
}

// The last-good SIGNED remote template catalog (single row, fixed PK). Persisted only AFTER the
// ed25519 signature + shape validation pass, so it is a durable trusted snapshot for boot/offline.
// The bundled catalog is always the base; this overlays it. See src/catalog/.
model CatalogSnapshot {
  id                  String   @id @default("singleton")
  version             String
  sourceUrl           String
  payload             Json // the verified { version, templates } blob
  templateCount       Int
  etag                String?
  signatureVerifiedAt DateTime
  fetchedAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Instance-level settings (single row, fixed PK) — the source of truth for onboarding state,
// registration gating, edition, self-update and API gating. Consumed by later features; created on
// first access via InstanceSettingsService (get-or-create).
model InstanceSettings {
  id                  String    @id @default("singleton")
  initializedAt       DateTime? // set when the first user registers (bootstrap complete)
  allowRegistration   Boolean   @default(false) // closed after the first user; owner re-opens or invites
  edition             String    @default("community") // community | pro | cloud
  publicUrl           String?
  acmeEmail           String?
  // Panel-TLS (DİLİM 1): the control panel's own HTTPS hostname (opt-in). When set (install.sh --auto-tls
  // or env PANEL_DOMAIN), the hub provisions a Traefik file-provider router for the panel. env PANEL_TLS=1 +
  // PANEL_DOMAIN win over this (synced to DB at bootstrap). Null = bring-your-own-proxy (unchanged).
  panelDomain         String?
  autoUpdate          Boolean   @default(false)
  updateChannel       String    @default("stable")
  cachedLatestVersion String?
  apiEnabled          Boolean   @default(true)
  apiAllowedIps       String[]  @default([])
  // OIDC single sign-on (Pro edition). Owner-configured IdP; the client secret is stored encrypted
  // (CryptoService) and never surfaced in any view. Empty allowedDomains = no JIT domain restriction.
  oidcEnabled         Boolean   @default(false)
  oidcIssuer          String?
  oidcClientId        String?
  oidcClientSecretEnc String? // libsodium-encrypted; decrypted only at token exchange
  oidcAllowedDomains  String[]  @default([]) // JIT provisioning is limited to these email domains when non-empty
  // A signed license (EdDSA JWT, issued by Tugra's proprietary billing service) that unlocks the Pro/Cloud
  // edition. Safe to store: it is signature-protected, so a DB write can't forge an entitlement — the hub
  // verifies it against TUGRA_LICENSE_PUBLISHER_KEY on every load. Null = no license (env/community edition).
  licenseToken        String?
  // Anonymous usage stats (ON by default, opt-out). `telemetryEnabled` is the owner-UI off-switch; the
  // env var TUGRA_TELEMETRY=0 is a deployment-level HARD off that overrides it (install --no-telemetry /
  // headless CI). `telemetryInstanceId` is a random, anonymous id minted once and kept stable across
  // restarts — the ONLY identifier ever sent; no IP, hostname, domain, email, app name or user data leaves
  // the box. `telemetryLastSentAt` is the last successful send (drives the UI + avoids double-sends).
  telemetryEnabled    Boolean   @default(true)
  telemetryInstanceId String?
  telemetryLastSentAt DateTime?
  // White-label (Pro edition). Owner-set branding that replaces the Tugra name/logo/favicon/accent and can
  // hide the "Powered by Tugra" footer. Read publicly (the login page themes before auth) BUT only applied
  // while the instance is Pro+ — a Community or lapsed-license instance always shows the Tugra defaults, so
  // these can't become a free rebrand. URLs are http(s), accent is a #rrggbb hex (validated in the DTO).
  brandName           String?
  brandLogoUrl        String?
  brandFaviconUrl     String?
  brandAccentColor    String?
  brandHidePoweredBy  Boolean   @default(false)
  updatedAt           DateTime  @updatedAt
}
