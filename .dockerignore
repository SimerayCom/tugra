# Keep build contexts small + avoid copying host (darwin/arm) artifacts into linux images.
**/node_modules
**/.next
**/dist
**/.turbo
.git
local
agent/tugra-agent
**/*.log
# Never bake secrets (JWT/signing/encryption keys, DB password) into image layers via COPY . .
# Only the repo-root files are excluded; the template stays available.
.env
.env.*
!.env.example
# Pre-update restore points (scripts/lib/snapshot.sh): DB dumps + .env copies. Never into a build context/image.
backups/
**/backups
**/pre-update-*.dump
**/pre-update-*.env
