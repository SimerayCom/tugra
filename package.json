{
  "name": "tugra",
  "version": "0.1.3",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tugra/hub-api exec prisma generate",
    "db:migrate": "pnpm --filter @tugra/hub-api exec prisma migrate dev"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "next": "^15.5.27",
      "proxy-addr": "^2.0.8",
      "multer": "^2.5.0",
      "ws": "^8.21.0",
      "qs": "^6.16.0",
      "body-parser": "^1.20.9",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.23",
      "sharp": "^0.35.5",
      "undici": "^7.29.1",
      "handlebars": "^4.7.10",
      "braces": "^3.0.3",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "glob": "^10.5.0",
      "tmp": "^0.2.6",
      "fast-uri": "^3.1.8",
      "picomatch": "^4.0.4",
      "source-map-js": "^1.2.2",
      "webpack": "^5.104.1",
      "vite": "^8.1.6",
      "file-type": "^21.3.2",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "ajv": "^8.18.0",
      "deepmerge-ts": "^8.0.0",
      "nodemailer": "^10.2.1",
      "lodash": "^4.17.23"
    }
  }
}
