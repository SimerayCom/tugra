{
  "name": "tugra",
  "version": "0.1.3",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tugra/hub-api exec prisma generate",
    "db:migrate": "pnpm --filter @tugra/hub-api exec prisma migrate dev"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.7.0"
  }
}
