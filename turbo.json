{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "@tugra/cli#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../apps/hub-api/openapi.json"]
    }
  }
}
