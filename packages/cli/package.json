{
  "name": "@tugra/cli",
  "version": "0.1.0",
  "description": "Command-line client for the Tugra self-hosted PaaS.",
  "license": "MIT",
  "bin": {
    "tugra": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "generate:api": "openapi-typescript ../../apps/hub-api/openapi.json -o src/generated/schema.ts"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  }
}
