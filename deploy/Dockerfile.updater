# Tugra self-update sidecar. Minimal image: the Docker CLI (+ compose plugin) to recreate the app
# containers, redis-cli to drain the job queue, bash to run scripts/update.sh (mounted from the repo), and
# curl + openssl so it can download a release's compose/installer scripts and verify their ed25519 signature
# itself (scripts/lib/hostfiles.sh) instead of trusting the hub or Redis for file content.
# It has docker.sock but a FIXED command set (pull + up -d --no-deps hub-api web) — no arbitrary exec.
FROM docker:27-cli

# OCI metadata so the GHCR package links to the repo (and shows its README + logo) with license/vendor.
LABEL org.opencontainers.image.source="https://github.com/SimerayCom/tugra" \
      org.opencontainers.image.url="https://github.com/SimerayCom/tugra" \
      org.opencontainers.image.title="Tugra Updater" \
      org.opencontainers.image.description="Tugra self-update sidecar." \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.vendor="Simeray Ltd"

RUN apk add --no-cache bash redis curl openssl

# A copy of the updater scripts of THIS release, baked in so the hub can bootstrap an install whose checkout
# predates in-app host-file updates: its old scripts/update.sh ignores a release's compose/script changes, so the
# one-shot `bash /opt/tugra/scripts/update.sh --apply-host-files <version> <digest>` (run by the hub, through the local
# agent, in this image with the checkout mounted) brings the checkout to the release with the same signature checks,
# backup and validation as an in-app update. Never used by the running sidecar, which executes the checkout's copy.
COPY scripts/update.sh /opt/tugra/scripts/update.sh
COPY scripts/lib/ /opt/tugra/scripts/lib/

WORKDIR /repo
# The script + compose file + .env are bind-mounted from the repo at runtime; the compose `command`
# invokes `scripts/update.sh --watch`. Clear the base image's docker entrypoint so command runs directly.
ENTRYPOINT []
