# Hub API (NestJS + Prisma). Build context = repo root (pnpm workspace).
# node:22 LTS (not slim) so native deps (argon2, libsodium) + prisma engines build cleanly.
# (Node 20 reached end-of-life; 22 is the active LTS that still gets security patches.)
FROM node:22

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app

# OCI metadata so the GHCR package links to the repo (and shows its README + logo) with license/vendor.
LABEL org.opencontainers.image.source="https://github.com/SimerayCom/tugra" \
      org.opencontainers.image.url="https://github.com/SimerayCom/tugra" \
      org.opencontainers.image.title="Tugra Hub API" \
      org.opencontainers.image.description="Tugra hub API — the control plane for the self-hostable container PaaS." \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.vendor="Simeray Ltd"

# Full monorepo (node_modules excluded via .dockerignore → fresh linux install).
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @tugra/shared build \
 && pnpm --filter @tugra/hub-api build

# Build metadata baked into the running process (GET /version + /health read these). Unset → the app
# falls back to "0.0.0-dev"/"dev"/"community"; the release pipeline passes real values as build args.
ARG TUGRA_VERSION
ARG TUGRA_CHANNEL
ARG GIT_SHA
ARG TUGRA_EDITION
ENV TUGRA_VERSION=$TUGRA_VERSION \
    TUGRA_CHANNEL=$TUGRA_CHANNEL \
    GIT_SHA=$GIT_SHA \
    TUGRA_EDITION=$TUGRA_EDITION
# No phone-home: the Prisma CLI (run at every boot for `migrate deploy`) pings checkpoint.prisma.io for a
# version check unless this is set. Disable it so the hub never pings a third-party version checker.
ENV CHECKPOINT_DISABLE=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=1

WORKDIR /app/apps/hub-api
EXPOSE 3000
# Apply migrations, then boot. DATABASE_URL/REDIS_URL come from compose env.
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && node dist/main.js"]
