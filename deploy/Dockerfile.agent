# Agent (Go). Dials OUT to the hub over WS, runs docker on the host via the
# mounted socket — so it needs the docker CLI + git (for GIT-source deploys).
#
# Cross-compiled so a single `docker buildx --platform linux/amd64,linux/arm64` build produces both
# arches (the agent runs on managed servers of any arch — Raspberry Pi to a cloud VM). BUILDPLATFORM
# keeps the Go toolchain native (no QEMU for the compile); only the final runtime stage is emulated.
FROM --platform=$BUILDPLATFORM golang:1.25 AS build
WORKDIR /src
COPY agent/ ./
ARG TARGETOS
ARG TARGETARCH
# main.Version defaults to "0.0.0-dev"; the release pipeline injects the real version here. Guard the
# default so an empty build arg doesn't blank the version (which would break the fleet's version display).
ARG TUGRA_VERSION
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -ldflags "-X main.Version=${TUGRA_VERSION:-0.0.0-dev}" -o /tugra-agent .

FROM docker:27-cli AS dockercli

FROM debian:bookworm-slim
# OCI metadata so the GHCR package links to the repo (and shows its README + logo) with license/vendor.
LABEL org.opencontainers.image.source="https://github.com/SimerayCom/tugra" \
      org.opencontainers.image.url="https://github.com/SimerayCom/tugra" \
      org.opencontainers.image.title="Tugra Agent" \
      org.opencontainers.image.description="Tugra agent — runs on managed servers and executes the hub's container operations." \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.vendor="Simeray Ltd"
# Debian's docker.io package ships no `docker compose` v2 plugin and no buildx, which breaks every
# COMPOSE-source app and template deploy. Take the (statically linked) CLI + plugins from the official
# docker CLI image instead; apt provides git + ca-certificates + curl + bash.
# bash is required: the hub's backup/restore scripts use `set -o pipefail`, which the
# base image's /bin/sh (dash < 0.5.13) rejects — the agent runs scripts via bash.
# gnupg (gpg) is required for encrypted backups: the backup/restore pipeline pipes the
# dump through `gpg --symmetric` (and `gpg -d` on restore); without it an encrypted
# destination's backup fails with "gpg: command not found".
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl bash gnupg \
 && rm -rf /var/lib/apt/lists/*
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --from=build /tugra-agent /usr/local/bin/tugra-agent
ENTRYPOINT ["tugra-agent"]
