# Agent (Go). Dials OUT to the hub over WS, runs docker on the host via the
# mounted socket — so it needs the docker CLI + git (for GIT-source deploys).
#
# Cross-compiled so a single `docker buildx --platform linux/amd64,linux/arm64` build produces both
# arches (the agent runs on managed servers of any arch — Raspberry Pi to a cloud VM). BUILDPLATFORM
# keeps the Go toolchain native (no QEMU for the compile); only the final runtime stage is emulated.
FROM --platform=$BUILDPLATFORM golang:1.24 AS build
WORKDIR /src
COPY agent/ ./
ARG TARGETOS
ARG TARGETARCH
# main.Version defaults to "0.0.0-dev"; the release pipeline injects the real version here. Guard the
# default so an empty build arg doesn't blank the version (which would break the fleet's version display).
ARG TUGRA_VERSION
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -ldflags "-X main.Version=${TUGRA_VERSION:-0.0.0-dev}" -o /tugra-agent .

FROM docker:27-cli AS dockercli

# GeoIP: bake the DB-IP Lite Country database (MaxMind mmdb format) into the image at BUILD time only, so
# Traffic Analytics country geo works out of the box. The agent reads it from local disk and never fetches
# anything at runtime (no phone-home). The data is architecture-independent, so this stage runs on the build
# platform once for every target arch. Pin DBIP_COUNTRY_URL to a monthly file for a reproducible build; bump
# it to refresh. Best-effort: if the download, gunzip or size sanity check fails the build still succeeds with a
# warning and an empty /out (the agent then simply reports no country). DB-IP Lite is CC-BY-4.0, see NOTICE.
FROM --platform=$BUILDPLATFORM alpine:3.20 AS geoip
ARG DBIP_COUNTRY_URL=https://download.db-ip.com/free/dbip-country-lite-2026-11.mmdb.gz
# GEOIP_REQUIRED=1 (set by the release pipeline) turns a failed bake into a hard build error, so a signed
# release image is never shipped silently without geo. Default 0 keeps local/dev builds best-effort.
ARG GEOIP_REQUIRED=0
# Bump GEOIP_CACHE_BUST (e.g. to the release version/month) to force a re-download when the URL is unchanged,
# so a layer cached from a failed or offline build is not silently reused.
ARG GEOIP_CACHE_BUST=0
RUN mkdir -p /out /tmp/geoip \
 && echo "geoip cache bust=${GEOIP_CACHE_BUST}" >/dev/null \
 && if wget -q -T 30 -O /tmp/geoip/country.mmdb.gz "${DBIP_COUNTRY_URL}" \
      && gunzip -c /tmp/geoip/country.mmdb.gz > /tmp/geoip/country.mmdb \
      && [ "$(wc -c < /tmp/geoip/country.mmdb)" -gt 1000000 ]; then \
      mv /tmp/geoip/country.mmdb /out/country.mmdb; \
    elif [ "${GEOIP_REQUIRED}" = "1" ]; then \
      echo "ERROR: GEOIP_REQUIRED=1 but could not fetch a valid DB-IP Lite Country database from ${DBIP_COUNTRY_URL}" >&2; \
      exit 1; \
    else \
      echo "WARNING: could not fetch a valid DB-IP Lite Country database from ${DBIP_COUNTRY_URL}; building without a baked GeoIP database" >&2; \
    fi

FROM debian:bookworm-slim
# OCI metadata so the GHCR package links to the repo (and shows its README + logo) with license/vendor.
LABEL org.opencontainers.image.source="https://github.com/SimerayCom/tugra" \
      org.opencontainers.image.url="https://github.com/SimerayCom/tugra" \
      org.opencontainers.image.title="Tugra Agent" \
      org.opencontainers.image.description="Tugra agent — runs on managed servers and executes the hub's container operations." \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.vendor="Simeray Ltd"
# Debian's docker.io package ships no `docker compose` v2 plugin and no buildx, which breaks every
# COMPOSE-source app and template deploy. Take the (statically linked) CLI + plugins from the official
# docker CLI image instead; apt provides git + ca-certificates + curl + bash.
# bash is required: the hub's backup/restore scripts use `set -o pipefail`, which the
# base image's /bin/sh (dash < 0.5.13) rejects — the agent runs scripts via bash.
# gnupg (gpg) is required for encrypted backups: the backup/restore pipeline pipes the
# dump through `gpg --symmetric` (and `gpg -d` on restore); without it an encrypted
# destination's backup fails with "gpg: command not found".
RUN apt-get update \
 && apt-get install -y --no-install-recommends git openssh-client ca-certificates curl bash gnupg \
 && rm -rf /var/lib/apt/lists/*
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --from=build /tugra-agent /usr/local/bin/tugra-agent
# Baked DB-IP Lite Country database (may be absent if the build-time download failed; copying the directory
# contents never fails on an empty source). Path must match traffic.BakedGeoIPPath.
COPY --from=geoip /out/ /usr/share/tugra/geoip/
ENTRYPOINT ["tugra-agent"]
