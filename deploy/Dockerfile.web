# Web (Next.js 15). Build context = repo root.
# NEXT_PUBLIC_API_URL is baked into the client bundle at build time. Left at its default for the
# published image: the SPA resolves the hub's public origin at RUNTIME (window.location.origin) when
# this is unset, so a single published image works for any single-origin (reverse-proxy) deployment.
# A split-port deployment that needs a fixed absolute hub URL should build from source with this set.
# node:22 LTS — Node 20 reached end-of-life; 22 is the active LTS that still gets security patches.
FROM node:22

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app

# OCI metadata so the GHCR package links to the repo (and shows its README + logo) with license/vendor.
LABEL org.opencontainers.image.source="https://github.com/SimerayCom/tugra" \
      org.opencontainers.image.url="https://github.com/SimerayCom/tugra" \
      org.opencontainers.image.title="Tugra Web" \
      org.opencontainers.image.description="Tugra web dashboard — the UI for the self-hostable container PaaS." \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.vendor="Simeray Ltd"

COPY . .
RUN pnpm install --frozen-lockfile

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# next.config evaluates rewrites() during `next build` (not at runtime), so the hub's in-cluster
# address for the same-origin /api/v1 proxy must be present NOW. In the compose stack the hub is
# reachable as hub-api:3000; default to it so the published image's API proxy works out of the box
# (incl. the no-reverse-proxy quick-start). Override at build for a differently-named hub service.
ARG HUB_INTERNAL_URL=http://hub-api:3000
ENV HUB_INTERNAL_URL=$HUB_INTERNAL_URL
# No phone-home: Next.js collects anonymous telemetry during `next build` unless this is set.
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @tugra/shared build \
 && pnpm --filter @tugra/web build

WORKDIR /app/apps/web
EXPOSE 3001
CMD ["pnpm", "start"]
