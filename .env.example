# Hub API
DATABASE_URL="postgresql://tugra:tugra@localhost:5433/tugra?schema=public"
REDIS_URL="redis://localhost:6379"
# Redis command timeout (ms). A command rejects instead of hanging when Redis is unreachable. Default 10000.
# REDIS_COMMAND_TIMEOUT_MS=10000
HUB_PORT=3000

# Global HTTP rate limit (per client IP). Defaults: 120 requests per 60000 ms. Raise for a busy dashboard or
# a no-domain install where all browser users share one proxy-IP bucket.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120

# Agent WebSocket gateway limits. Close a connection that hasn't authenticated within this many ms (default
# 10000), and cap a single inbound frame in bytes (default 67108864 = 64 MiB; the ws default is 100 MiB).
# AGENT_WS_AUTH_DEADLINE_MS=10000
# AGENT_WS_MAX_PAYLOAD_BYTES=67108864

# Auth (generate strong random values — see README)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
SECRETS_ENCRYPTION_KEY="change-me-32-bytes-base64"
# The hub's ed25519 command-signing seed (base64, 32 bytes). REQUIRED in production — the hub refuses to
# boot without it (fail-closed); an ephemeral key is used only in dev/test. install.sh generates it.
HUB_SIGNING_KEY=""

# Session cookies carry the Secure flag when true (defaults to on in production, off otherwise so
# localhost http works). Set explicitly if NODE_ENV doesn't reflect your TLS setup.
COOKIE_SECURE=""
# Set "true" ONLY behind a trusted reverse proxy — the hub then reads X-Forwarded-For for the observed
# source IP (used by the API IP allowlist). Off by default (uses the raw TCP peer, spoof-safe).
# install.sh sets this with --domain.
HUB_TRUSTED_PROXY=""

# First-run owner-claim code (8 hex chars). install.sh generates it and prints it once on a fresh install;
# it must be entered when creating the owner account. Recover with: grep SETUP_CODE .env
SETUP_CODE=""

# Single-box quick start: when set (>=32 chars; install.sh generates 48 hex chars), registering the owner
# auto-creates the "This machine" server, and the bundled local agent enrolls with this token.
LOCAL_AGENT_ENROLL_TOKEN=""
# The agent's own image ref (e.g. ghcr.io/simeraycom/tugra-agent:latest), used to re-invoke itself as the
# sandboxed file helper. Empty disables file operations.
TUGRA_AGENT_IMAGE=""

# Public base URL agents dial back to (builds the install command); falls back to request host.
HUB_PUBLIC_URL=""

# One-click importer data migrator (S3+). All optional — sensible defaults work out of the box.
# MIGRATION_STAGING_DIR: where the hub stages uploaded migration artifacts before restore (default: the OS
#   temp dir). Point it at a dedicated, roomy volume in production (artifacts are deleted after each restore).
# MIGRATION_MAX_ARTIFACT_BYTES: per-artifact upload cap in bytes (default 268435456 = 256 MiB; S6 scales this).
# MIGRATION_AGENT_HUB_URL: override the hub origin the TARGET agent fetches artifacts from, for when the agent
#   cannot reach HUB_PUBLIC_URL (e.g. the compose 'local' agent uses http://hub-api:3000). Must be http(s).
MIGRATION_STAGING_DIR=""
MIGRATION_MAX_ARTIFACT_BYTES=""
MIGRATION_AGENT_HUB_URL=""

# Let's Encrypt account email for automatic SSL (deploy/proxy). Optional but RECOMMENDED in production —
# it receives cert-expiry warnings and avoids the default placeholder. Leave blank to use the fallback.
ACME_EMAIL=""

# NOTE: the production stack (deploy/docker-compose.yml) forwards this whole .env into the hub container,
# so every OPTIONAL setting below (and MAIL_*, CATALOG_*, TUGRA_LICENSE, AGENT_IMAGE, ANTHROPIC_*) takes
# effect just by setting it here. Blank values are treated as unset — no need to delete unused keys.

# Transactional email — password reset, email verification, team invites (OUTBOUND only). Fail-soft: with
# MAIL_HOST unset, no mail is sent and those flows still succeed (they fall back to an audit log). Any SMTP
# provider works. Example for Resend (resend.com): verify your sending domain there first (add its DKIM +
# SPF DNS records), then MAIL_USER is literally "resend" and MAIL_PASS is your Resend API key (re_...).
#   MAIL_HOST="smtp.resend.com"   MAIL_PORT="465"   MAIL_SECURE="true"
#   MAIL_USER="resend"            MAIL_PASS="re_your_api_key"
#   MAIL_FROM="Tugra <no-reply@yourdomain.com>"   # the address' domain must be verified in Resend
MAIL_HOST=""
MAIL_PORT="587"
MAIL_SECURE="false"   # "true" for implicit TLS on port 465; "false" for STARTTLS on 587
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Tugra <no-reply@localhost>"

# "Sign in with GitHub" (optional). Register an OAuth app at github.com/settings/developers
# with callback URL: <HUB_PUBLIC_URL or http://localhost:3000>/auth/oauth/github/callback
# The callback sets the session in httpOnly cookies, so the hub and SPA must share a public origin
# for the SPA to see them — the same-origin reverse-proxy deployment (SPA + /api → hub) provides this.
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
# Web origin the OAuth callback redirects back to (the SPA). Also pinned as the allowed Origin for
# terminal WebSocket upgrades.
WEB_PUBLIC_URL="http://localhost:3001"

# Allow notification channels (webhook/Slack/Discord/ntfy/gotify/SMTP) to target private LAN addresses
# (RFC1918 / CGNAT / IPv6 ULA). Default false — cloud metadata (169.254.169.254), loopback and
# link-local stay blocked regardless (SSRF guard). Set "true" only for trusted internal endpoints.
NOTIFY_ALLOW_PRIVATE_TARGETS="false"

# Web
# The SPA calls the hub through a same-origin "/api" proxy (next.config rewrite), so the session
# cookie stays same-origin. HUB_INTERNAL_URL is where the Next server forwards "/api/*" (server-side).
HUB_INTERNAL_URL="http://localhost:3000"
# The hub's PUBLIC absolute URL — used for copy-paste external URLs (GitHub webhooks) and as the
# default terminal-WebSocket base (which connects straight to the hub; a WS can't traverse the proxy).
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Optional: override the terminal-WebSocket base (e.g. wss://your-host/api) when a reverse proxy
# forwards WS upgrades to the hub. Leave empty to connect directly to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL=""

# Self-update (OPT-IN — blank by default so a fresh install phones home to nothing). Point the hub at the
# signed release manifest to enable update checks + one-click in-app updates (install.sh --enable-update-checks
# sets these for you). Both must be set together (setting the URL without the key fails closed at boot). The
# .sig is fetched automatically as "<UPDATE_MANIFEST_URL>.sig". UPDATE_PUBLISHER_KEY is the publisher's
# ed25519 PUBLIC key (base64 SPKI DER, 44 bytes). For official builds use:
#   UPDATE_MANIFEST_URL="https://simeraycom.github.io/tugra/versions.json"
#   UPDATE_PUBLISHER_KEY="MCowBQYDK2VwAyEA4+vvlIQS9SWHEKc0Fo1UD2ZW+DSl0AJA9hOK5NeiXBE="
# A self-built release uses the key printed by scripts/sign-manifest.mjs instead. Leave both empty to disable.
UPDATE_MANIFEST_URL=""
UPDATE_PUBLISHER_KEY=""
# Minutes between background version checks (default 1440 = daily).
UPDATE_CHECK_INTERVAL_MIN="1440"
# Optional changelog URL surfaced next to an available update.
UPDATE_CHANGELOG_URL=""
# Seconds between background Docker Swarm health checks (fires swarm_degraded on ACTIVE→DEGRADED). Default 60.
SWARM_STATUS_INTERVAL_SEC="60"
