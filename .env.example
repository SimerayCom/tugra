# Hub API
DATABASE_URL="postgresql://tugra:tugra@localhost:5433/tugra?schema=public"
REDIS_URL="redis://localhost:6379"
# Redis command timeout (ms). A command rejects instead of hanging when Redis is unreachable. Default 10000.
# REDIS_COMMAND_TIMEOUT_MS=10000
HUB_PORT=3000

# Global HTTP rate limit (per client IP). Defaults: 120 requests per 60000 ms. Raise for a busy dashboard or
# a no-domain install where all browser users share one proxy-IP bucket.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120

# Agent WebSocket gateway limits. Close a connection that hasn't authenticated within this many ms (default
# 10000), and cap a single inbound frame in bytes (default 67108864 = 64 MiB; the ws default is 100 MiB).
# AGENT_WS_AUTH_DEADLINE_MS=10000
# AGENT_WS_MAX_PAYLOAD_BYTES=67108864

# Auth (generate strong random values — see README)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
SECRETS_ENCRYPTION_KEY="change-me-32-bytes-base64"
# Rotating the encryption key happens in the panel (Settings → Instance → "Secrets encryption key" → Rotate key): no
# restart and no edit here. This passphrase stays the root that wraps the stored data keys.
# Root-passphrase rotation: while re-encrypting stored secrets under a NEW SECRETS_ENCRYPTION_KEY, list the OLD passphrase(s)
# here (comma-separated) so existing ciphertexts stay readable. Then Settings → Instance → "Secrets encryption key"
# → Re-encrypt; remove this once the card says every secret is under the current key. See docs/security.md.
# SECRETS_ENCRYPTION_KEY_PREVIOUS=""
# The hub's ed25519 command-signing seed (base64, 32 bytes). REQUIRED in production — the hub refuses to
# boot without it (fail-closed); an ephemeral key is used only in dev/test. install.sh generates it.
HUB_SIGNING_KEY=""

# Session cookies carry the Secure flag when true (defaults to on in production, off otherwise so
# localhost http works). Set explicitly if NODE_ENV doesn't reflect your TLS setup.
COOKIE_SECURE=""
# Set "true" ONLY behind a trusted reverse proxy — the hub then reads X-Forwarded-For for the observed
# source IP (used by the API IP allowlist, throttling, agent IPs), and ONLY when the TCP peer is a loopback /
# private / docker address (or listed in HUB_TRUSTED_PROXY_CIDRS below). Off by default (raw TCP peer, spoof-safe).
# install.sh sets this with --domain and, with it, binds the raw ports to 127.0.0.1 (HUB_BIND / WEB_BIND:
# keep them off the public interface; for a proxy on another host use this box's private IP + a firewall).
HUB_TRUSTED_PROXY=""
# A reverse proxy with a PUBLIC egress IP (e.g. on another host) must be listed here, comma-separated IPs/CIDRs.
# "0.0.0.0/0,::/0" trusts any peer (only if the proxy alone can reach the hub port). Invalid entries fail boot.
HUB_TRUSTED_PROXY_CIDRS=""
# Optional strict mode: "true" trusts ONLY the HUB_TRUSTED_PROXY_CIDRS peers for X-Forwarded-For (by default any
# private/loopback/docker peer is trusted too, so another host on the same LAN could forge its source IP). Needs
# HUB_TRUSTED_PROXY=true and at least one valid CIDR (your proxy's subnet) or the hub refuses to boot.
# HUB_TRUSTED_PROXY_STRICT=""
# RAM profile (scripts/install.sh --profile=<tiny|small|standard|auto>): tiny < 1.5 GiB RAM, small < 3 GiB, standard >= 3 GiB.
# install.sh detects it on a first install, writes TUGRA_PROFILE plus the keys below, and keeps them on later runs (edit a key
# by hand and it stays; --profile=<name> rewrites them all). All of them are OPTIONAL: with none set the stack runs on the
# defaults shown here, which equal today's behaviour or better. What each profile sets and why: docs/install.md ("RAM profiles").
# TUGRA_PROFILE=""
# Hub V8 heap cap in MB (NODE_OPTIONS --max-old-space-size) and young generation in MB (--max-semi-space-size); default 768 / 16.
# Raise HUB_MAX_HEAP_MB (e.g. 1536) only for a very large fleet on a bigger host.
# HUB_MAX_HEAP_MB="768"
# HUB_SEMI_SPACE_MB="16"
# glibc malloc arenas of the hub and web processes (default 2; the glibc default of 8 x cores costs tens of MB of RSS).
# HUB_MALLOC_ARENA_MAX="2"
# Web (Next server) V8 heap cap in MB, default 512.
# WEB_MAX_HEAP_MB="512"
# Postgres settings (command-line, deploy/docker-compose.yml). Defaults: 128MB / 1GB / 4MB / 64MB / 100 / 1GB / 5min.
# TUGRA_PG_SHARED_BUFFERS="128MB"
# TUGRA_PG_EFFECTIVE_CACHE_SIZE="1GB"
# TUGRA_PG_WORK_MEM="4MB"
# TUGRA_PG_MAINTENANCE_WORK_MEM="64MB"
# TUGRA_PG_MAX_CONNECTIONS="100"
# TUGRA_PG_PARALLEL_WORKERS="2"
# TUGRA_PG_MAX_WAL_SIZE="1GB"
# TUGRA_PG_CHECKPOINT_TIMEOUT="5min"
# Redis maxmemory (policy is always noeviction: BullMQ and the refresh-token store need it), default 256mb.
# TUGRA_REDIS_MAXMEMORY="256mb"
# The hub's own Prisma pool (connection_limit / pool_timeout seconds), added to a copy of DATABASE_URL inside the process; an
# explicit connection_limit / pool_timeout already in DATABASE_URL wins. Defaults 16 / 20 (Prisma's own default is cpus x 2 + 1).
# HUB_DB_CONNECTION_LIMIT="16"
# HUB_DB_POOL_TIMEOUT="20"
# Container memory ceilings (docker mem_limit, e.g. 640m; 0 = none, the default). Set by the tiny/small profiles on the services
# that are heap-capped and restart cleanly; never on Postgres, the agent or the updater. Keep HUB_MEM_LIMIT >= HUB_MAX_HEAP_MB + ~400 MB
# (WEB: + ~160, REDIS: maxmemory + ~64): raise both together, the installer and --doctor warn when it no longer fits.
# HUB_MEM_LIMIT="0"
# WEB_MEM_LIMIT="0"
# REDIS_MEM_LIMIT="0"  # kept for the profile check only; Redis is bounded by TUGRA_REDIS_MAXMEMORY, set by the hub at boot
# The web container applies the same three settings to the browser IP it forwards to the hub (docker-compose passes
# them through), so set them once here. A client reaching the web port can never forge its IP past the hub.
# Cloudflare orange-cloud (the panel's DNS record is proxied): Traefik then only sees a Cloudflare edge address.
# "true" makes the hub use CF-Connecting-IP as the client IP, but ONLY when the hop Traefik observed is a published
# Cloudflare edge range (vendored in packages/shared/src/cloudflare-ips.ts; refresh: node scripts/refresh-cloudflare-ips.mjs).
# Any request that did not come through Cloudflare keeps its own address. Needs HUB_TRUSTED_PROXY=true or the hub
# refuses to boot. install.sh: --cloudflare-proxy. Leave unset when the panel is not behind Cloudflare.
# HUB_TRUSTED_PROXY_CLOUDFLARE=""
# Extra Cloudflare edge ranges (comma-separated IPs/CIDRs), ADDED to the vendored list, for a range Cloudflare
# published after this release. Invalid entries fail boot.
# HUB_TRUSTED_PROXY_CLOUDFLARE_EXTRA_CIDRS=""
# Guided migration: the address a source such as Coolify sees this hub connect from, shown in the import wizard so you
# can put it into the source's Settings > Advanced > Allowed IPs. Unset = this box's public address from its server record
# (or "unknown"; the hub never calls a public IP-echo service). Set it when the hub is behind NAT, uses another egress
# gateway, or the source is LAN-only (then the private address the source sees). A single IPv4 or IPv6 address.
# IMPORT_EGRESS_IP=""
# Pre-update restore point (pg_dump + .env copy into ./backups before every update). On by default; 0 disables
# it (unsafe). PRE_UPDATE_KEEP = how many sets to keep (default 5); TUGRA_BACKUP_DIR = alternative directory
# (absolute; for the in-app updater it MUST be inside the checkout — the only path its container mounts).
PRE_UPDATE_BACKUP=""
PRE_UPDATE_KEEP=""
TUGRA_BACKUP_DIR=""

# First-run owner-claim code (8 hex chars). install.sh generates it and prints it once on a fresh install;
# it must be entered when creating the owner account. Recover with: grep SETUP_CODE .env
SETUP_CODE=""

# Single-box quick start: when set (>=32 chars; install.sh generates 48 hex chars), registering the owner
# auto-creates the "This machine" server, and the bundled local agent enrolls with this token.
LOCAL_AGENT_ENROLL_TOKEN=""
# The agent's own image ref (e.g. ghcr.io/simeraycom/tugra-agent:latest), used to re-invoke itself as the
# sandboxed file helper. Empty disables file operations. (install.sh no longer writes this or AGENT_IMAGE: the
# bundled stack derives it from TUGRA_VERSION and the hub defaults AGENT_IMAGE to its own version + digest pin.)
TUGRA_AGENT_IMAGE=""

# Public base URL agents dial back to (builds the install command); falls back to request host.
HUB_PUBLIC_URL=""

# One-click importer data migrator (S3+). All optional — sensible defaults work out of the box.
# MIGRATION_STAGING_DIR: where the hub stages uploaded migration artifacts before restore (default: the OS
#   temp dir). Point it at a dedicated, roomy volume in production (artifacts are deleted after each restore).
# MIGRATION_MAX_ARTIFACT_BYTES: the size of a single-file dump artifact in bytes (default 268435456 = 256 MiB). It is a ROUTE
#   threshold, not a limit: a bigger database moves as a checked stream in a guided run, so leave it unset.
# MIGRATION_VX_MAX_DUMP_BYTES: OPTIONAL ceiling in bytes for one streamed database dump (at least 1 GiB). Unset = no size limit.
# MIGRATION_AGENT_HUB_URL: override the hub origin the TARGET agent fetches artifacts from, for when the agent
#   cannot reach HUB_PUBLIC_URL (e.g. the compose 'local' agent uses http://hub-api:3000). Must be http(s).
MIGRATION_STAGING_DIR=""
MIGRATION_MAX_ARTIFACT_BYTES=""
MIGRATION_VX_MAX_DUMP_BYTES=""
MIGRATION_AGENT_HUB_URL=""

# Let's Encrypt account email for automatic SSL (deploy/proxy). Optional but RECOMMENDED in production —
# it receives cert-expiry warnings and avoids the default placeholder. Leave blank to use the fallback.
ACME_EMAIL=""

# NOTE: the production stack (deploy/docker-compose.yml) forwards this whole .env into the hub container,
# so every OPTIONAL setting below (and MAIL_*, CATALOG_*, TUGRA_LICENSE, AGENT_IMAGE, ANTHROPIC_*) takes
# effect just by setting it here. Blank values are treated as unset — no need to delete unused keys.

# Transactional email — password reset, email verification, team invites (OUTBOUND only). Fail-soft: with
# MAIL_HOST unset, no mail is sent and those flows still succeed; the reset/verify link is written to the hub
# server console instead (`docker compose logs hub-api`). Any SMTP provider works. Example for Resend (resend.com): verify your sending domain there first (add its DKIM +
# SPF DNS records), then MAIL_USER is literally "resend" and MAIL_PASS is your Resend API key (re_...).
#   MAIL_HOST="smtp.resend.com"   MAIL_PORT="465"   MAIL_SECURE="true"
#   MAIL_USER="resend"            MAIL_PASS="re_your_api_key"
#   MAIL_FROM="Tugra <no-reply@yourdomain.com>"   # the address' domain must be verified in Resend
MAIL_HOST=""
MAIL_PORT="587"
MAIL_SECURE="false"   # "true" for implicit TLS on port 465; "false" for STARTTLS on 587
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Tugra <no-reply@localhost>"

# "Sign in with GitHub" (optional). Register an OAuth app at github.com/settings/developers
# with this callback URL (it depends on how you installed):
#   - raw two-port install (http://<host>:3001 + http://<host>:3000):  <WEB_PUBLIC_URL>/api/auth/oauth/github/callback
#     e.g. http://203.0.113.7:3001/api/auth/oauth/github/callback  (the web port proxies it to the hub)
# Open the panel at exactly WEB_PUBLIC_URL (same scheme, host and port) to use GitHub sign-in: the login cookie is set
# on the origin you start from and GitHub returns to WEB_PUBLIC_URL, so any other host/port fails with a clear message.
#   - single-origin proxy (--domain):  <HUB_PUBLIC_URL>/auth/oauth/github/callback  (your proxy routes /auth/oauth to the hub)
# The hub derives the right one from HUB_PUBLIC_URL/WEB_PUBLIC_URL (one shared origin = the second form, different
# ports/hosts = the first). Set GITHUB_OAUTH_CALLBACK_URL only to force a different registered URL.
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
GITHUB_OAUTH_CALLBACK_URL=""
# Web origin the OAuth callback redirects back to (the SPA). Also pinned as the allowed Origin for
# terminal WebSocket upgrades.
WEB_PUBLIC_URL="http://localhost:3001"

# Allow notification channels (webhook/Slack/Discord/ntfy/gotify/SMTP) to target private LAN addresses
# (RFC1918 / CGNAT / IPv6 ULA). Default false — cloud metadata (169.254.169.254), loopback and
# link-local stay blocked regardless (SSRF guard). Set "true" only for trusted internal endpoints.
NOTIFY_ALLOW_PRIVATE_TARGETS="false"

# Web
# The SPA calls the hub through a same-origin "/api" proxy (next.config rewrite), so the session
# cookie stays same-origin. HUB_INTERNAL_URL is where the Next server forwards "/api/*" (server-side).
HUB_INTERNAL_URL="http://localhost:3000"
# The hub's PUBLIC absolute URL — used for copy-paste external URLs (GitHub webhooks) and as the
# default terminal-WebSocket base (which connects straight to the hub; a WS can't traverse the proxy).
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Optional: override the terminal-WebSocket base (e.g. wss://your-host/api) when a reverse proxy
# forwards WS upgrades to the hub. Leave empty to connect directly to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL=""

# Self-update checks are ON by default: the official manifest URL + publisher key are built into the hub,
# so leave UPDATE_MANIFEST_URL and UPDATE_PUBLISHER_KEY blank for official builds. To use your own signed
# manifest set BOTH (setting only the URL fails closed at boot). The .sig is fetched automatically as
# "<UPDATE_MANIFEST_URL>.sig"; UPDATE_PUBLISHER_KEY is the publisher's ed25519 PUBLIC key (base64 SPKI DER,
# 44 bytes). A self-built release uses the key printed by scripts/sign-manifest.mjs.
# TUGRA_UPDATE_CHECKS=0 turns update checks off entirely (install.sh --no-update-checks writes it for you).
TUGRA_UPDATE_CHECKS=""
UPDATE_MANIFEST_URL=""
UPDATE_PUBLISHER_KEY=""
# Minutes between background version checks (default 60 = hourly).
UPDATE_CHECK_INTERVAL_MIN="60"
# Optional changelog URL surfaced next to an available update.
UPDATE_CHANGELOG_URL=""
# Minutes between per-app "image update available" probes of IMAGE apps (default 360 = 6h, 0 = off).
IMAGE_UPDATE_CHECK_INTERVAL_MIN="360"
# Seconds between background Docker Swarm health checks (fires swarm_degraded on ACTIVE→DEGRADED). Default 60.
SWARM_STATUS_INTERVAL_SEC="60"

# Anonymous usage stats. ON by default (opt-out): counts (servers, apps, databases, services, teams,
# users, deployments, clusters, monitors) plus version, release channel, edition, OS, CPU architecture and
# Node.js major version, signed with a key pair the hub generates — no names, IPs, domains or secrets, and
# the receiver does not store your IP. One send ~1 min after boot, then every TUGRA_STATS_INTERVAL_MIN. A
# failed send is skipped silently and never blocks anything. Settings → "Anonymous usage stats" shows the
# exact report and has an owner toggle that works without a restart. Details: docs/security.md.
# TUGRA_STATS: "0" is a deployment-level HARD off (overrides the Settings toggle; the sender never even
# starts, so the box makes zero stats calls). "1" or blank = on, with the Settings toggle governing at
# runtime. Any other value fails boot. install.sh writes it for you (--no-stats / --enable-stats, or the
# TUGRA_STATS=0|1 variable in the installer's shell; the installer also reads TUGRA_NO_STATS=1 /
# TUGRA_ENABLE_STATS=1 from its own environment — those are not hub settings).
TUGRA_STATS=""
# Where the stats are POSTed (default https://api.tugra.io/v1/hubs/report). Point it at your own receiver
# or a mirror; leave blank for the default.
TUGRA_STATS_URL=""
# Minutes between sends (positive integer, default 1440 = daily).
TUGRA_STATS_INTERVAL_MIN=""
